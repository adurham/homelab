# Managed by ansible — see roles/nut_ups.
# UPS definition file. Section name [{{ nut_ups_name }}] is also the
# systemd instance name used by `nut-driver@{{ nut_ups_name }}.service`
# (Debian's nut-driver@.service resolves its device via
# `nut-driver-enumerator.sh --get-device-for-service <instance>`).
#
# driver=usbhid-ups + vendorid is the documented generic path for this
# unit: it enumerates as 0764:0601 "CPS GX1500U", and NUT ships a
# matching udev rule (/usr/lib/udev/rules.d/62-nut-usbups.rules).
# pollinterval=2: the sag/transfer events this box exists to catch can
# be seconds long — poll the device fast (driver default is 2s; keep it
# explicit so it can't silently drift).
#
# NB (learned live 2026-10-01): `maxretry` is NOT a per-driver variable —
# usbhid-ups rejects it ("Fatal error: 'maxretry' is not a valid variable
# name for this driver") and the unit enters an auto-restart loop. It
# belongs in the [upsdrvctl] global section, which is where it now lives.
[{{ nut_ups_name }}]
    driver = usbhid-ups
    port = auto
    vendorid = {{ nut_ups_vendor_id }}
    desc = "CyberPower GX1500U (lab corner: pve01-03 + GS108 + basement pod + amd-workstation)"
    pollinterval = 2

# Global upsdrvctl settings (apply to the driver controller, not the
# driver itself): retry driver startup up to N times with 5s gaps —
# USB enumeration can lag on a cold boot.
[upsdrvctl]
    maxretry = 10
