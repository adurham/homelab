{
  "annotations": {"list": []},
  "description": "Internet speed (Cloudflare Speed Test via Home Assistant, hourly). Latency/jitter, download/upload by test size, and 90th-percentile summary.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "/up$/"},
            "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 5], "fill": "dash"}}]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.cloudflare_speed_test_90th_percentile_down\"}",
          "legendFormat": "90th percentile down",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.cloudflare_speed_test_90th_percentile_up\"}",
          "legendFormat": "90th percentile up",
          "refId": "B"
        }
      ],
      "title": "Speed (90th percentile) over time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 150}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 2,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_duration_ms{entity=\"sensor.cloudflare_speed_test_latency\"}",
          "legendFormat": "Latency",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_duration_ms{entity=\"sensor.cloudflare_speed_test_jitter\"}",
          "legendFormat": "Jitter",
          "refId": "B"
        }
      ],
      "title": "Latency & jitter",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "id": 3,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=~\"sensor.cloudflare_speed_test_(100kb|1mb|10mb|25mb)_down\"}",
          "legendFormat": "{{entity}}",
          "refId": "A"
        }
      ],
      "title": "Download by test size",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 25}, {"color": "green", "value": 50}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 17},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.cloudflare_speed_test_90th_percentile_down\"}",
          "refId": "A"
        }
      ],
      "title": "Current download",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 10}, {"color": "green", "value": 20}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 17},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.cloudflare_speed_test_90th_percentile_up\"}",
          "refId": "A"
        }
      ],
      "title": "Current upload",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 150}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 17},
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_duration_ms{entity=\"sensor.cloudflare_speed_test_latency\"}",
          "refId": "A"
        }
      ],
      "title": "Current latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5400}, {"color": "red", "value": 10800}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 17},
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "time() - homeassistant_last_updated_time_seconds{entity=\"sensor.cloudflare_speed_test_latency\"}",
          "refId": "A"
        }
      ],
      "title": "Time since last test",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "tags": ["network", "internet", "speedtest"],
  "templating": {"list": []},
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Internet Speed",
  "uid": "internet-speed",
  "version": 1,
  "weekStart": ""
}
