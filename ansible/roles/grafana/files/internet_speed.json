{
  "annotations": {"list": []},
  "description": "Internet speed (official Ookla Speedtest CLI via Home Assistant command_line integration, hourly). Real server auto-discovery and genuine multi-connection testing built into the Ookla client itself -- this replaced two earlier broken approaches: HA's built-in speedtestdotnet integration (legacy Python speedtest-cli library's server-discovery API returned only Canadian servers for this connection) and a custom Cloudflare-based integration (speed.cloudflare.com hard rate-limits, HTTP 429, under real concurrent load). Verified against the native macOS Speedtest app on the same network (883/866 Mbps) within normal run-to-run variance.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Upload"},
            "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 5], "fill": "dash"}}]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.ookla_speedtest\"}",
          "legendFormat": "Download",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.ookla_speedtest_upload\"}",
          "legendFormat": "Upload",
          "refId": "B"
        }
      ],
      "title": "Speed over time (Ookla, real multi-connection test)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 80}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 2,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_duration_ms{entity=\"sensor.ookla_speedtest_ping\"}",
          "legendFormat": "Ping",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "homeassistant_sensor_duration_ms{entity=\"sensor.ookla_speedtest_jitter\"}",
          "legendFormat": "Jitter",
          "refId": "B"
