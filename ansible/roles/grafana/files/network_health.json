{
  "uid": "network-health",
  "title": "Network & Wi-Fi Health",
  "tags": [
    "network",
    "wifi",
    "homelab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "description": "Hourly Wi-Fi/LAN health check from the basement workstation (hermes cron job net_health.py -> node_exporter textfile netheal.prom). Collector: ~/.hermes/scripts/net_health.py. Process notes: docs/ecobee-lan-scan.md.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Wi-Fi down (Mac)",
      "description": "iperf3 workstation -> MacBook over whatever Wi-Fi band the Mac is on, hourly.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "netheal_wifi_throughput_mbps{direction=\"down\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": null,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 200
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
