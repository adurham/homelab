  "panels": [
    {
      "id": 1,
      "title": "AC Suction Line Temp (coil freeze feedback)",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "tempF",
          "custom": {"lineWidth": 3, "fillOpacity": 15, "spanNulls": true, "showPoints": "never"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 38},
              {"color": "yellow", "value": 42},
              {"color": "green", "value": 45},
              {"color": "yellow", "value": 55}
            ]
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "EMERGENCY 38F (freeze imminent)"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]},
          {"matcher": {"id": "byName", "options": "Backoff 42F (40% max closed)"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]},
          {"matcher": {"id": "byName", "options": "Normal 45F (60% max closed)"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]},
          {"matcher": {"id": "byName", "options": "Healthy 50F (80% max closed)"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "expr": "(homeassistant_sensor_temperature_celsius{entity=\"sensor.ac_suction_line_temp\"} * 1.8) + 32",
          "interval": "",
          "legendFormat": "Suction line",
          "refId": "A"
        },
        {
          "datasource": "VictoriaMetrics",
          "expr": "38",
          "interval": "",
          "legendFormat": "EMERGENCY 38F (freeze imminent)",
          "refId": "B"
        },
        {
          "datasource": "VictoriaMetrics",
          "expr": "42",
          "interval": "",
          "legendFormat": "Backoff 42F (40% max closed)",
          "refId": "C"
        },
        {
          "datasource": "VictoriaMetrics",
          "expr": "45",
          "interval": "",
          "legendFormat": "Normal 45F (60% max closed)",
          "refId": "D"
        },
        {
          "datasource": "VictoriaMetrics",
          "expr": "50",
          "interval": "",
          "legendFormat": "Healthy 50F (80% max closed)",
          "refId": "E"
        }
      ]
    },
    {
      "id": 2,
      "title": "Compressor Stage + HVAC Action",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 9},
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 20, "spanNulls": true, "showPoints": "never", "drawStyle": "line", "stacking": {"mode": "normal", "group": "A"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Stage 2 cooling"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "Stage 1 cooling"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "Idle/fan/off"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "expr": "homeassistant_sensor_state{entity=\"sensor.ecobee_edgewater_road_compressor_cool_stage\"} == 2",
          "interval": "",
          "legendFormat": "Stage 2 cooling",
          "refId": "A"
        },
        {
          "datasource": "VictoriaMetrics",
          "expr": "(homeassistant_sensor_state{entity=\"sensor.ecobee_edgewater_road_compressor_cool_stage\"} == 1) * 1",
          "interval": "",
          "legendFormat": "Stage 1 cooling",
          "refId": "B"
        },
        {
          "datasource": "VictoriaMetrics",
          "expr": "homeassistant_climate_action{entity=\"climate.ecobee_thermostat\",action!=\"cooling\"}",
          "interval": "",
          "legendFormat": "Idle/fan/off",
          "refId": "C"
        }
      ]
    },
