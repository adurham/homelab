          summary: "node_exporter textfile collector failing on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "A node_exporter textfile scrape is erroring -- metrics fed by .prom files (e.g. the amd-workstation boot-oops/boot-time signals) are stale or missing. Fix: check the collector's directory + the writing oneshot on that host."
        labels:
          severity: warning
        isPaused: false

      - uid: https_endpoint_unreachable
