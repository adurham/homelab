              # Migrated from HA automation "Infrastructure: AdGuard Home
              # Watchdog" (automations/adguard_watchdog.yaml) -- that
              # automation's OWN trigger entity (binary_sensor.
              # adguard_home_running) doesn't exist on this HA instance,
              # so it has been silently dead code, never firing. Its
              # self-heal action (hassio.addon_restart) is left in place
              # unchanged in case the entity gets fixed later, but this
              # Grafana rule is the actual working liveness check --
              # switch.adguard_home_protection's availability is a real,
              # currently-populated signal (verified 2026-08-09;
              # sensor.adguard_raw_status by contrast reads permanently
              # "unavailable" and is NOT usable for this).
              editorMode: code
              expr: homeassistant_entity_available{entity="switch.adguard_home_protection"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
