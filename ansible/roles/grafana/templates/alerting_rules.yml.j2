apiVersion: 1
groups:
  - orgId: 1
    name: infrastructure
    folder: Infrastructure
    interval: 1m
    rules:
      # ── Alert-path heartbeat ─────────────────────────────────────────────
      # Lives only in the deployed instance (added on the box, never committed);
      # folded in so a playbook run stops deleting it. Fires permanently by
      # design: absence of the alert means the evaluation/notification path is
      # dead. severity=meta + label dms=true keep it out of the normal routes.
      - uid: dead_mans_switch
        title: Dead man's switch
        condition: C
        data:
        - refId: A
          relativeTimeRange:
            from: 60
            to: 0
          datasourceUid: __expr__
          model:
            datasource:
              name: Expression
              type: __expr__
              uid: __expr__
            expression: '1'
            intervalMs: 1000
            maxDataPoints: 43200
            refId: A
            type: math
        - refId: C
          datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
              operator:
                type: and
              query:
                params:
                - A
              reducer:
                type: last
                params: []
              type: query
            datasource:
              name: Expression
              type: __expr__
              uid: __expr__
            expression: A
            intervalMs: 1000
            maxDataPoints: 43200
            refId: C
            type: threshold
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          summary: Alert pipeline alive (dead man's switch)
          description: "If healthchecks.io stops receiving these pings, Grafana / rule-eval\
            \ / network is broken \u2014 page out-of-band."
        labels:
          severity: meta
          dms: 'true'
        isPaused: false

      - uid: host_down
        title: Host down
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # job!="exo" -- exo cluster nodes (the Mac Studios) don't run
              # node_exporter at all, they expose their own /metrics on
              # :52415 (see roles/victoriametrics job 'exo'). This rule's
              # annotations hardcode "node_exporter on X hasn't responded",
              # which was factually WRONG when it fired for job=exo -- the
              # actual Mac Studio hardware was up the whole time, only the
              # exo SERVER PROCESS was down (e.g. mid-restart, mid-mlx
              # rebuild). Those are different failure modes needing
              # different responses (restart the exo process vs. physically
              # check the machine), so exo gets its own rule below
              # (exo_server_down) with accurate wording instead of being
              # silently folded into the generic host-down check.
              #
              # instance!~"tc-.*" excludes the tanium_clients test fleet
              # (tc-ubuntu22/24, tc-rocky8/9, tc-debian11/12, tc-oracle8/9,
              # tc-alma8/9, tc-suse15, tc-rhel8/9) -- these are disposable
              # Tanium-client test boxes (rebuilt/rebooted/left off at will
              # for cross-distro client-install testing), not infrastructure.
              # Confirmed 2026-09-20: tc-rocky9 alone had generated 2 stale
              # "systemd unit failed" silences already sitting in
              # Alertmanager from routine test churn. Root-cause fix (not a
              # silence): stop these hosts from ever being alertable,
              # matching the existing tanium_cluster exclusion pattern
              # (deploy_logrotate.yml) for the TanOS appliances themselves.
              # instance!="amd-workstation" -- the dev box pages via its own
              # dedicated rule (amd_workstation_unreachable), written for its
              # specific failure mode (kernel-alive/userland-dead zombie).
              expr: up{job!="exo", instance!~"tc-.*", instance!="amd-workstation"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} is down"
          description: "node_exporter on {{ '{{' }} $labels.instance {{ '}}' }} hasn't responded for 5 minutes"
        labels:
          severity: critical
        isPaused: false

      - uid: exo_server_down
        title: exo server process down
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: up{job="exo"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Error
        for: 5m
        annotations:
          summary: "exo server down on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "The exo inference server process on {{ '{{' }} $labels.instance {{ '}}' }} hasn't responded on :52415/metrics for 5 minutes. This does NOT mean the Mac Studio itself is down -- it means the exo process specifically has stopped (crashed, restarting, mid mlx rebuild, cluster not started). Check with `ssh {{ '{{' }} $labels.instance {{ '}}' }} 'ps aux | grep exo'` and the cluster start/log workflow before assuming hardware failure."
        labels:
          severity: critical
        isPaused: false

      - uid: exo_runners_not_ready
        title: exo model runners not ready
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Both nodes report the cluster-wide runner count; max() keeps
              # the alert alive if one node's scrape is missing. Count ANY
              # live runner state, not just RunnerReady: the per-node status
              # series is REPLACED while a runner is busy (RunnerReady drops
              # to absent and RunnerRunning takes its place -- observed live
              # 2026-10-03, false-fired mid-generation while the cluster was
              # healthy and serving). A crashed runner is re-placed by exo
              # itself (~2 min reload), so this fires only when fewer than 2
              # runners are alive past that.
              expr: max(exo_runners{job="exo", status=~"RunnerReady|RunnerRunning|RunnerLoading|RunnerWarmingUp"}) or vector(0)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [2]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Error
        for: 4m
        annotations:
          summary: "exo: fewer than 2 model runners ready"
          description: "The exo cluster has had fewer than 2 runners in RunnerReady for 4 minutes, so the served model (DeepSeek-V4.1-Flash, TP=2) cannot answer requests. exo re-places a crashed runner on its own in ~2 minutes; this means it did not come back. Check `grep -E 'crashed with critical|Runner terminated' ~/exo.log` on macstudio-m4-1/2, then relaunch with ./start_cluster.sh (rollback: DSV4_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp ./start_cluster.sh)."
        labels:
          severity: critical
        isPaused: false

      - uid: exo_runner_stuck_loading
        title: exo runner stuck loading
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Companion to exo_runners_not_ready: that rule counts Loading as
              # "alive" (a reloading runner isn't down), which would mask a
              # runner WEDGED mid-load. A normal MLX load of the ~20G shard set
              # completes well inside 10m; still loading at 15m is stuck.
              expr: max(exo_runners{job="exo", status="RunnerLoading"}) or vector(0)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 15m
        annotations:
          summary: "exo: a runner has been stuck in RunnerLoading for 15+ minutes"
          description: "At least one runner has reported RunnerLoading continuously for 15 minutes. A normal MLX load of the served model's shards finishes well inside that window, so this means a wedged load (stuck download, OOM during load, RDMA/node_network stall). The cluster may still be serving on the other runner or not at all -- check ~/exo.log on both macstudios for the load's last progress line, then consider a clean relaunch with ./start_cluster.sh."
        labels:
          severity: warning
        isPaused: false

      - uid: tanium_appliance_unreachable
        title: Tanium appliance unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_tanium_reachable"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.tanium_role {{ '}}' }}) is unreachable"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} (SSH :22) has failed for 5 minutes -- appliance is down, network path broken, or SSH crashed. Agentless replacement for the old node_exporter-based host_down check, which never worked on these TanOS appliances (default-deny iptables never opened :9100)."
        labels:
          severity: critical
        isPaused: false

      - uid: tanium_console_unreachable
        title: Tanium console unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # ts-02 is the deliberate Tanium-server standby (docs/2026-09-10-fleet-sweep):
              # the appliance VM runs but its console service is off until it is
              # brought back for real. Probe kept for visibility; alert excluded.
              expr: probe_success{job="blackbox_tanium_console",instance!="ts-02"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.tanium_role {{ '}}' }}) console unreachable on {{ '{{' }} $labels.target {{ '}}' }}"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} (Tanium console :443) has failed for 5 minutes — httpd down, Tanium services crashed, or the appliance is fully down. If postgres is also unreachable for the same host, the appliance is down."
        labels:
          severity: critical
        isPaused: false

      - uid: tanium_postgres_unreachable
        title: Tanium postgres unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # tms-02 is the second deliberate standby (owner-confirmed
              # 2026-09-10: "known, intentional standby-incomplete state").
              # ts-01's postgres probe still guards the real path.
              expr: probe_success{job="blackbox_tanium_postgres",instance!="tms-02"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} postgres unreachable on {{ '{{' }} $labels.target {{ '}}' }}"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} has failed for 5 minutes — host down, postgres down, iptables, or tanium-postgres-lab-trust unit"
        labels:
          severity: critical
        isPaused: false

      # Added 2026-10-21 after the pve03 incident: a ZFS writeback deadlock left
      # 71 processes unkillable and the node's load at 80 for 22 hours without a
      # single alert (the only symptom was pve_exporter flapping, which the ack
      # bot deletes on resolve). Blocked-process count is the direct signal.
      - uid: node_procs_blocked_high
        title: Node has stuck (uninterruptible) processes
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: node_procs_blocked{job="node_exporter",instance=~"pve0[123]"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [20]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Alerting
        for: 10m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} has processes stuck in uninterruptible sleep"
          description: "Blocked processes with an idle disk is the signature of a wedged filesystem (ZFS writeback/page-lock deadlock, hung network mount). The 2026-10-21 pve03 incident sat at load 80 for 22 h this way and never alerted. Check on the node: ps -eo state,pid,comm | awk '$1==\"D\"', cat /proc/<pid>/stack, zpool status, and whether any lxc-start/qemu process is running for a guest that is not in `pct list` / `qm list`."
        labels:
          severity: warning
        isPaused: false

      - uid: amd_workstation_unreachable
        title: amd-workstation unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_amd_workstation"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "amd-workstation is unreachable on the tailnet"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} (SSH :22, tailnet) has failed for 5 minutes. Known failure mode: the box's kernel keeps answering locally while userland freezes (tailscaled/sshd dead, no IPv4) -- it requires a power-cycle (headless; hold power ~15 s, then press once), then pull `journalctl -b -1` on the box for kernel-oops signatures. See docs/ipam.md."
        labels:
          severity: warning
        isPaused: false

      - uid: amd_workstation_rebooted
        title: amd-workstation rebooted
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # `changes(...[30m])` FALSE-FIRED on scrape gaps: VictoriaMetrics
              # counts the sample on either side of a gap as a change, so every
              # ~10 min tailnet outage on the box produced a "rebooted" alert
              # even though boot_time never moved (confirmed 2026-10-25: two
              # alerts at 14:21Z and 15:33Z, value constant at 1792510115).
              # Compare against wall clock instead -- gap-immune, still fires
              # for exactly 15 min after any real boot.
              expr: (time() - amd_workstation_boot_time_seconds) < 900
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 2m
        annotations:
          summary: "amd-workstation rebooted"
          description: "The dev box's boot time changed -- fires for EVERY reboot, including automatic ones (watchdog/panic self-heals). If it follows a self-heal, check `journalctl -b -1 -k` on the box and /var/lib/systemd/pstore for the cause."
        labels:
          severity: warning
        isPaused: false

      - uid: amd_workstation_prev_boot_oops
        title: amd-workstation previous boot had kernel oopses
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Fires only within an hour of a boot that found previous-boot
              # oops lines -- stale values never re-fire, and it self-resolves.
              expr: (amd_workstation_prev_boot_oops > 0) and (time() - amd_workstation_boot_time_seconds < 3600)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "amd-workstation's previous boot logged kernel oops/segfault lines"
          description: "Counts 'BUG: unable to handle / Oops: / segfault at' lines in the PREVIOUS boot's kernel log (persists until the next reboot). Any value >0 is the Oct-2026 zombie-incident class -- pull `journalctl -b -1 -k` on the box, check /var/lib/systemd/pstore and /var/crash."
        labels:
          severity: warning
        isPaused: false

      - uid: textfile_scrape_error
