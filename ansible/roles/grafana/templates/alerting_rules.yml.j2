          description: "Kernel reported an I/O error, EXT4 filesystem error, buffer error, or block-layer failure on {{ '{{' }} $labels.host {{ '}}' }} — could be failing disk, ZFS scrub finding, or filesystem corruption"
        labels:
          severity: critical
        isPaused: false

      - uid: log_postfix_relay_failure
        title: Postfix relay failures on mail-01
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # Track postfix logging deferred or bounced messages on mail-01.
              # Catches "iCloud SMTP not authenticating", "queue piling up",
              # "rate limit hit" — anything that prevents alert email delivery.
              expr: 'sum (count_over_time({job="systemd-journal", host="mail-01"} |~ "postfix.*status=(deferred|bounced)" [10m]))'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [3]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Postfix relay failures on mail-01"
          description: "More than 3 postfix `status=deferred` / `status=bounced` events in the last 10 minutes. Likely auth failure to smtp.mail.me.com, network issue, or rate limit. Check `postqueue -p` and `journalctl -u postfix`."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Dead-man's-switch — always-firing meta alert. Routed exclusively to
      # the healthchecks.io webhook (see policies + contact_points). If
      # healthchecks stops getting pings, the alert pipeline is broken
      # (Grafana down, network out, or the rule eval engine itself wedged)
      # and healthchecks pages out-of-band. Gated on healthchecks_dms_ping_url
      # so the rule disappears entirely when the URL isn't configured —
      # avoids a non-routed alert spamming HA/email every 5m.
      # ---------------------------------------------------------------------
{% if healthchecks_dms_ping_url is defined and healthchecks_dms_ping_url %}
      - uid: dead_mans_switch
        title: Dead man's switch
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 60
              to: 0
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "1"
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
              type: math
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        # noDataState moot (constant expression never produces NoData).
        # execErrState=Error so an expression-engine failure stops pings —
        # that's the whole point of a DMS, never mask a real outage.
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          summary: "Alert pipeline alive (dead man's switch)"
          description: "If healthchecks.io stops receiving these pings, Grafana / rule-eval / network is broken — page out-of-band."
        labels:
          severity: meta
          dms: "true"
        isPaused: false

{% endif %}
      # ---------------------------------------------------------------------
      # SECOND dead-man's-switch layer, added 2026-09-10: the healthchecks.io
      # rule above (gated behind healthchecks_dms_ping_url) only proves
      # Grafana's own rule-evaluation engine + internet egress are alive --
      # its expression is a constant `1`, datasourceUid __expr__, never
      # touching VictoriaMetrics at all. It would keep happily pinging
      # healthchecks.io even if VM died outright and every OTHER alert rule
      # (21 of them depend on datasourceUid: victoriametrics) silently had
      # zero real data to evaluate against. Given vm-01 and graf-01 run on
      # SEPARATE hosts (vm-01/graf-01 both currently on pve03, but as
      # distinct CTs/services that can fail independently of each other),
      # this is a real, previously-uncovered gap, not a hypothetical one.
      # Unlike the rule above, THIS one doesn't depend on healthchecks_dms_
      # ping_url being configured -- it only needs the victoriametrics
      # datasource, so it deploys unconditionally and routes through the
      # normal Discord/email contact points like any other alert.
      #
      # This rule queries VM for a genuinely live, always-present metric
      # (node_exporter's node_uname_info, remote-written by Alloy from every
      # host in the fleet) and fires if VM has stopped actually ingesting
      # real scrape data -- i.e. it proves the WHOLE pipeline (Alloy -> VM
      # remote-write -> Grafana query) is alive, not just Grafana's alerting
      # engine in isolation.
      - uid: metrics_pipeline_dead
        title: Metrics pipeline dead (VictoriaMetrics ingest stalled)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: count(node_uname_info)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [5]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        # noDataState=Alerting (not OK): a query returning literally no
        # series at all is exactly the failure mode this rule exists to
        # catch (VM down / unreachable), so NoData must page, not go quiet.
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "VictoriaMetrics has stopped ingesting real scrape data"
          description: "Fewer than 5 hosts are reporting node_uname_info (out of ~31 normally) -- either VictoriaMetrics itself is down/unreachable, or Alloy's remote-write path is broken fleet-wide. This is the real data-path check; the plain 'Dead man's switch' rule above only proves Grafana's rule engine is alive, not that it has real data to evaluate. Check `systemctl status victoriametrics` on vm-01 first."
        labels:
          severity: critical
        isPaused: false

      - uid: systemd_unit_failed
        title: systemd unit failed
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # Requires roles/alloy's systemd collector (enable_collectors
              # = ["systemd"], unit_include = ".+\\.service") -- added
              # 2026-09-10 fleet audit, which found pve03's chrony and
              # private-monitoring-firewall units both silently `failed`
              # for 3+ days with NO alert coverage anywhere (this is the
              # rule that closes that gap). state="failed" is one of
              # node_exporter's systemd collector's possible values
              # (active/inactive/failed/activating/deactivating).
              #
              # name!~ exclusion: live-fired on first deploy against
              # ifupdown-wait-online/networking/nvmf-autoconnect/openipmi
              # on graf-01, vm-01, media-ingest-01 -- these are the SAME
              # cosmetic LXC-container boilerplate noise already confirmed
              # benign this session (identical failures across unrelated
              # containers, no functional impact -- see 2026-09-10
              # Grafana/vm-01 sweep). Excluded here instead of silently
              # tolerating alert fatigue; a real regression in one of
              # these would need its own named rule, not this generic one.
              #
              # apparmor.service added to the exclusion 2026-09-10: fails
              # structurally on tailscale-gw (the only privileged CT with
              # nesting=1 in this fleet -- confirmed via `pct config 101`
              # showing no `unprivileged` key, vs. authentik/dns-01 which
              # are unprivileged and load apparmor fine). Root error is
              # "Permission denied; attempted to load a profile while
              # confined?" -- apparmor_parser can't load nested profiles
              # inside a privileged LXC's own host-applied AppArmor
              # confinement. Can't be fixed without converting the CT to
              # unprivileged (backup/recreate/restore per
              # roles/tailscale_gw_host's own comment on this), so this
              # will fail on every boot forever -- exclude rather than
              # let it page every ~10min indefinitely.
              #
              # instance!~"tc-.*" added 2026-09-20: excludes the disposable
              # tanium_clients test fleet -- see the matching exclusion +
              # rationale on the host_down rule earlier in this file.
              # tc-rocky9 alone had 2 stale silences sitting in
              # Alertmanager from routine rebuild/reboot churn on these
              # test boxes before this exclusion existed.
              editorMode: code
              expr: node_systemd_unit_state{state="failed", name!~"ifupdown-wait-online.service|networking.service|nvmf-autoconnect.service|openipmi.service|apparmor.service", instance!~"tc-.*"} == 1
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "{{ '{{' }} $labels.name {{ '}}' }} failed on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "systemd unit {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has been in `failed` state for 10+ minutes. SSH in and check `systemctl status {{ '{{' }} $labels.name {{ '}}' }}` + `journalctl -u {{ '{{' }} $labels.name {{ '}}' }}`. 10m threshold (vs. the usual 5m) to ride out transient restart-loop blips without paging."
        labels:
          severity: warning
        isPaused: false

      - uid: log_pve_replication_failed
        title: pve replication failure
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 1800
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # pvescheduler / pvesr run replication; failures show up in
              # the systemd journal of the pve host that's sending. Match
              # the noisy-but-precise patterns that indicate a real fail
              # (not a transient retry).
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", host=~"pve0.+"} |~ "(?i)replication.*(failed|error)|send/receive failed|530 Permission denied|cannot send.*: Broken pipe" [15m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "pve replication failing on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "ZFS replication between pve nodes is the substrate for HA failover. If a job stays failed, an HA migration of the affected CT loses up to 15m of data. Run `pvesr status` on {{ '{{' }} $labels.host {{ '}}' }} and check `/var/log/pve/replicate/<jobid>` for the failing job."
        labels:
          severity: warning
        isPaused: false

      - uid: log_pve_quorum_lost
        title: pve cluster quorum lost
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # corosync logs membership / quorum changes via [QUORUM] and
              # [KNET]. The canonical actual-quorum-loss signals are
              # "non-primary component" (this node is no longer in the
              # majority partition) and "received write while not quorate".
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              #
              # REMOVED 2026-09-28: "no active links" -- that string is a
              # per-peer KNET link timeout, not a quorum signal. A single
              # peer's LAN ring flapping for ~2s (e.g. from the known
              # intermittent L2 duplicate-frame bursts on this segment)
              # emits "host: N has no active links" while all 3 nodes stay
              # quorate, so this rule false-fired 5x between 2026-09-25 and
              # 2026-09-27 ("pve cluster quorum lost" for events where
              # `pvecm status` stayed Quorate:Yes throughout). Quorum-lost
              # itself is emitted as "non-primary component ... will NOT
              # provide any services" / "received write while not quorate"
              # -- those remain matched here.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", host=~"pve0.+"} |~ "(?i)not quorate|non-primary component|quorum lost" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 1m
        annotations:
          summary: "pve cluster quorum/peer issue on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Corosync logged a quorum loss or peer-drop event on {{ '{{' }} $labels.host {{ '}}' }}. With <2/3 nodes active the cluster goes read-only and HA stops migrating. Check `pvecm status` and `journalctl -u corosync`."
        labels:
          severity: critical
        isPaused: false

      - uid: log_postgres_fatal
        title: Postgres FATAL/PANIC
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service"} |~ "FATAL:|PANIC:" |~ "postgres" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 2m
        annotations:
          summary: "Postgres FATAL/PANIC on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Postgres logged a FATAL or PANIC line on {{ '{{' }} $labels.host {{ '}}' }} — connection storm, OOM, replication slot issue, or genuine corruption"
        labels:
          severity: critical
        isPaused: false

      # Added 2026-09-16 with roles/smartctl_exporter -- pve02/pve03's
      # aging SATA boot HDDs have no spare to replace them with, so
      # this is the actual "keep them alive as long as possible" early
      # warning: catch a NEW pending sector before it corrupts
      # something (the 2026-09-10 pve03 EXT4/pve-cluster incident
      # happened without any prior Grafana visibility at all -- the
      # only record was smartd's local root mail, unread). Both rules
      # query smartctl_device_attribute, sourced from
      # /var/lib/node_exporter/textfile_collector/smartctl.prom
      # (smartctl-textfile.timer, every 5min) via Alloy's textfile
      # collector.
      - uid: sata_boot_disk_pending_sector_nonzero
        title: SATA boot disk has a pending sector
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: smartctl_device_attribute{attribute="current_pending_sector"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} disk {{ '{{' }} $labels.disk {{ '}}' }} has a pending sector"
          description: "Current_Pending_Sector on {{ '{{' }} $labels.instance {{ '}}' }}'s {{ '{{' }} $labels.disk {{ '}}' }} is nonzero -- the drive has found a sector it can't read and is waiting to reallocate it on next write. This is the specific condition the Level1Techs write-to-LBA fix (2026-09-16 investigation) targets, but do NOT run that raw write against a live mounted root disk -- drain the node's CTs and do it from an unmounted/rescue context. See smartctl-textfile role notes and homelab warm memory 2233 for the full writeup and what's already been tried."
        labels:
          severity: warning
        isPaused: false

