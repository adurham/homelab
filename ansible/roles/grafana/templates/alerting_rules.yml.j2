          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # above for why this can't be instant:true with multiple
              # simultaneous (host, unit) series.
              #
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file.
              expr: 'sum by (host, unit) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service", host!~"tc-.*"} |~ "Start request repeated too quickly|Failed to start" [10m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
