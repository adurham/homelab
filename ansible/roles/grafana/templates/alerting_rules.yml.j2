              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "HA guest {{ '{{' }} $labels.kind {{ '}}' }}:{{ '{{' }} $labels.vmid {{ '}}' }} has no replication job"
          description: "Every VM or CT with HA set must have a pvesr replication job: this cluster has no shared storage, so without one a fence or relocation starts the guest on a node that has no disk for it (ct:105 on 2026-10-30 sat stopped with 'dataset does not exist'). Add jobs to BOTH other nodes -- on the node that holds the disks: `pvesr create-local-job <vmid>-<n> <target> --schedule '*:N/20' --rate 15`, then `pvesr run --id <jobid>` for the first sync. ha-replication-check.timer re-checks every 5 minutes."
        labels:
