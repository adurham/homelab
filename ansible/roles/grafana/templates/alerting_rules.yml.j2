        refId: C
        type: threshold
    noDataState: OK
    execErrState: Error
    for: 2m
    annotations:
      summary: amd-workstation rebooted
      description: The dev box's boot time changed -- fires for EVERY reboot, including
        automatic ones (watchdog/panic self-heals). If it follows a self-heal, check
        `journalctl -b -1 -k` on the box and /var/lib/systemd/pstore for the cause.
    labels:
      severity: warning
    isPaused: false
  - uid: amd_workstation_prev_boot_oops
