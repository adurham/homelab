              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} postgres unreachable on {{ '{{' }} $labels.target {{ '}}' }}"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} has failed for 5 minutes — host down, postgres down, iptables, or tanium-postgres-lab-trust unit"
        labels:
          severity: critical
        isPaused: false

      - uid: https_endpoint_unreachable
        title: HTTPS endpoint unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_https_cert"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} unreachable"
          description: "blackbox HTTPS probe to {{ '{{' }} $labels.instance {{ '}}' }} has failed for 5 minutes — DNS, connection refused, TLS, or non-2xx response. Cert-expiry alerts depend on this probe succeeding, so this fires first if the endpoint is fully down."
        labels:
          severity: critical
        isPaused: false

      - uid: admin_ui_iframe_self_blocked
        title: Admin UI iframe-self blocked by security headers
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_iframe_self_ok"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} blocks same-origin iframe"
          description: "blackbox iframe-self probe to {{ '{{' }} $labels.instance {{ '}}' }} has failed for 5 minutes — the vhost is returning X-Frame-Options: DENY or CSP frame-ancestors 'none', which silently breaks admin UIs whose console pane is a same-origin iframe (Proxmox Console tab, Tanium server console). Loosen to SAMEORIGIN / 'self' for the affected vhost in roles/loadbalancer_service/templates/nginx.conf.j2."
        labels:
          severity: warning
        isPaused: false

      - uid: cert_renewer_wedged
        title: TLS certificate renewer likely wedged
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: (probe_ssl_earliest_cert_expiry{job="blackbox_https_cert"} - time()) / 86400
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [30]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1h
        annotations:
          summary: "Cert for {{ '{{' }} $labels.instance {{ '}}' }} <30 days remaining — acme.sh probably wedged"
          description: "TLS cert for {{ '{{' }} $labels.instance {{ '}}' }} has less than 30 days remaining. acme.sh's default renewal triggers ~30 days before expiry, so anything below that line means the renewer hasn't run successfully recently. Check `/root/.acme.sh/acme.sh.log` and the systemd timer / cron job. The `cert_expiring_soon` (14-day, critical) alert below will fire as a backup if this is ignored."
        labels:
          severity: warning
        isPaused: false

      - uid: cert_expiring_soon
        title: TLS certificate expiring soon
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: (probe_ssl_earliest_cert_expiry{job="blackbox_https_cert"} - time()) / 86400
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [14]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "Cert for {{ '{{' }} $labels.instance {{ '}}' }} expires in less than 14 days"
          description: "Less than 14 days until the TLS certificate served by {{ '{{' }} $labels.instance {{ '}}' }} expires; auto-renewal has failed and you're inside the danger window. The earlier `cert_renewer_wedged` warning should have fired at 30 days."
        labels:
          severity: critical
        isPaused: false

      - uid: smart_vent_controller_frozen
        title: Smart Vent Controller heartbeat stale
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # sensor.smart_vent_controller_heartbeat is stamped by the
              # AppDaemon app at the top of every 120s control_loop cycle.
              # Age of the metric = how long the loop has actually not run
              # (not just "the add-on container is alive" — Supervisor
              # reported the add-on healthy for the full ~4.5h freeze on
              # 2026-08-08, container-alive was not a real health signal).
              # Mirrors the existing Grafana dashboard panel expression
              # (smart_vent_controller.json) which was watch-only until now.
              expr: time() - homeassistant_sensor_timestamp_seconds{entity="sensor.smart_vent_controller_heartbeat"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [360]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        # noDataState=Alerting (not OK) is deliberate here, unlike most
        # rules in this file: if the metric itself stops being exported
        # (HA Prometheus exporter down, entity renamed/removed, HA core
        # down) that is ALSO a "we've lost visibility into vent control"
        # condition and must page, not go silent. The local HA watchdog
        # (automations/smart_vent_watchdog.yaml) self-heals via add-on
        # restart within minutes for the common case; this Grafana rule
        # is the independent, multi-channel-routed backstop (HA webhook
        # push + email fallback + covered by the dead-man's-switch) for
        # when the HA-local watchdog itself can't run or can't notify.
        noDataState: Alerting
        execErrState: Error
        for: 8m
        annotations:
          summary: "Smart Vent Controller control loop has not run in 6+ minutes"
          description: "sensor.smart_vent_controller_heartbeat age exceeds 360s — the AppDaemon smart_vent_controller app's pinned worker thread is likely frozen (a hung HA service call can block it indefinitely; see 2026-08-08 incident). Vents are stuck at their last commanded position, not responding to room temp or occupancy. The local HA watchdog should self-heal via `ha addons restart a0d7b954_appdaemon`; if this alert is still firing after ~10 min, the self-heal failed and needs manual restart."
        labels:
          severity: critical
        isPaused: false

      - uid: tati_phone_tracking_stale
        title: Tati phone WiFi presence tracking stale
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # input_boolean.tati_phone_tracking_stale is set by two HA
              # automations (tati_phone_tracking_mark_stale / _clear_stale)
              # that watch person.tati_sharp. The person entity has no
              # mobile_app/GPS tracker (she doesn't want to install
              # anything) -- presence is WiFi-only via nmap_tracker
              # matching her iPhone 16's MAC on the LAN. If iOS ever
              # rotates the private WiFi address for this network, the
              # tracker goes stale and person.tati_sharp reads "unknown"
              # for over an hour, which is what sets this boolean.
              editorMode: code
              expr: homeassistant_input_boolean_state{entity="input_boolean.tati_phone_tracking_stale"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        # noDataState=OK (not Alerting): if the HA Prometheus exporter or
        # the helper itself disappears, that's a separate outage that the
        # existing host_down / HA-availability rules already cover --
        # don't double-page for this specific low-priority helper.
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Tati's iPhone WiFi presence tracker has gone stale"
          description: "person.tati_sharp has read 'unknown' for over an hour and input_boolean.tati_phone_tracking_stale is set. Most likely cause: iOS rotated the private WiFi MAC address for the home network, so the nmap_tracker entity linked to her phone no longer matches. Fix: nmap-scan 192.168.86.0/24, find the new MAC for her iPhone (hostname often still resolves as iphone*.lan or similar), enable/rename that device_tracker entity in HA, then re-link it via person/update on person.tati_sharp. No action needed from her -- this is fully fixable HA-side."
        labels:
          severity: warning
        isPaused: false

      - uid: disk_full
        title: Disk usage high
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: 100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs"} * 100)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [90]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "Disk on {{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.mountpoint {{ '}}' }}) is over 90% full"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has been above 90% utilization for 10 minutes"
        labels:
          severity: warning
        isPaused: false

      - uid: loki_write_errors
        title: Loki rejecting writes
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # Rate of 5xx responses on Loki's push API. >0 means Promtail
              # somewhere is failing to ship logs, and we lose log_* alert
              # substrate. Different failure mode than disk pressure (which
              # would also surface here, but earlier than that fires).
              expr: sum(rate(loki_request_duration_seconds_count{job="loki",route="loki_api_v1_push",status_code=~"5.."}[5m]))
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Loki rejecting push requests on vm-01"
          description: "Loki's /loki/api/v1/push endpoint is returning 5xx responses for 5+ minutes — Promtails somewhere are failing to ship logs. Check `loki_panic_total`, `loki_distributor_ingester_append_failures_total`, and the loki.service journal."
        labels:
          severity: critical
        isPaused: false

      - uid: loki_disk_pressure
        title: Loki disk pressure on vm-01
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # vm-01 ships Loki chunks to /var/lib/loki on `/` (ZFS subvol).
              # If `/` fills, Loki stops accepting writes and the log_* alerts
              # below all silently lose their substrate. Fire earlier than
              # the generic `disk_full` (which triggers at 90% used) so we
              # have headroom to prune chunks or expand storage.
              expr: 100 - (node_filesystem_avail_bytes{instance="vm-01",mountpoint="/"} / node_filesystem_size_bytes{instance="vm-01",mountpoint="/"} * 100)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [70]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "vm-01 root filesystem >70% full — Loki at risk"
          description: "vm-01's root filesystem (where /var/lib/loki lives) has been over 70% full for 10 minutes. If it fills, Loki stops accepting writes and every log_* alert loses its substrate. Prune old chunks or grow the subvol."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Loki-backed log alerts. These query the systemd-journal stream that
      # Promtail ships from every host. Use noDataState=OK so a Promtail
      # outage doesn't fire the alert (host_down would catch the underlying
      # cause anyway). Use `for:` to dampen single-event noise.
      # ---------------------------------------------------------------------

      - uid: log_oom_kill
        title: OOM kill detected
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # Range query (NOT instant) is required here: with multiple
              # hosts matching simultaneously, an instant Loki query's
              # per-series host labels get lost in Grafana's frame
              # conversion, and the classic-condition/threshold node
              # downstream throws "frame cannot uniquely be identified by
              # its labels: has duplicate results with labels {}" — a
              # long-standing Grafana bug (see e.g. grafana/grafana#83448,
              # #104076) that silently replaces the real per-host alert
              # with a DatasourceError showing "[no value]" everywhere.
              # Range queries route through a different conversion path
              # that keeps labels intact (verified empirically against
              # this Loki 3.7.1 + Grafana 11.x pairing 2026-08-09).
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service"} |~ "Out of memory|invoked oom-killer" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              # Math (not classic-condition Threshold) so each host's
              # label set survives into the alert instance -- Threshold
              # on a multi-series input collapses everything into one
              # unlabeled instance, which is why the host label in the
              # annotations below used to render as "[no value]".
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 1m
        annotations:
          summary: "OOM killer ran on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Kernel OOM killer or systemd-oomd terminated a process on {{ '{{' }} $labels.host {{ '}}' }} in the last 5 minutes — host is under memory pressure"
        labels:
          severity: critical
        isPaused: false

      - uid: log_service_restart_loop
        title: Systemd service restart loop
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
