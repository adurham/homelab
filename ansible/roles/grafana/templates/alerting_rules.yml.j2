        isPaused: false

      # Added 2026-09-16: surfaces smartd's existing self-test schedule
      # (short daily 2am, long weekly Sat 3am -- see /etc/smartd.conf,
      # predates this exporter) in Grafana instead of leaving results
      # sitting unwatched in the self-test log. This is the actual
      # trigger condition for the Level1Techs write-to-LBA fix
      # (2026-09-16 investigation, see homelab warm memory 2233/2236):
      # neither drive currently has a pending sector or a failed
      # self-test, so there's nothing to act on today, but if a future
      # scheduled test DOES fail with a real LBA, this is what notices
      # it instead of someone needing to remember to check by hand.
      - uid: sata_boot_disk_selftest_failed
        title: SATA boot disk self-test failed or interrupted
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: smartctl_device_last_selftest_passed
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [1]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} disk {{ '{{' }} $labels.disk {{ '}}' }} most recent self-test did not pass cleanly"
          description: "smartctl_device_last_selftest_passed on {{ '{{' }} $labels.instance {{ '}}' }}'s {{ '{{' }} $labels.disk {{ '}}' }} is 0 (failed) or -1 (interrupted/unknown) -- smartd's scheduled short/long self-test did not complete cleanly. Check smartctl_device_last_selftest_lba_error: if 1, run `smartctl -a` to get the failing LBA, then follow the write-to-LBA procedure (drain the node, unmount/rescue context, never on the live mounted root fs -- see homelab warm memory 2233/2236 for the full writeup and exact commands from the Level1Techs forum post)."
        labels:
          severity: warning
        isPaused: false

      # Added 2026-10-01 after the recurring-unclean-reboot investigation
      # (docs/ipam.md, EVENT 2026-10-01): the cluster hard-resets every few
      # days -- 3 occurrences in 35h on Oct 1 -- and until now the ONLY way
      # anyone learned about one was a human noticing "the network is slow"
      # or logs being read after the fact. A node whose boot time jumped in
      # the last hour is exactly the signature; pve01-03 + the lab corner are
      # the known victims of the short deep power sag on their shared strip.
      # This turns the next occurrence into a push notification with the
      # timestamp, so the witness logs can be read while the evidence is
      # fresh. Excludes tc-* (disposable Tanium test fleet, rebuilt at will).
      - uid: pve_node_rebooted
        title: PVE node rebooted (unexpected/unclean)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: changes(node_boot_time_seconds{instance=~"pve0[123]"}[1h])
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} rebooted within the last hour"
          description: "node_boot_time_seconds changed on {{ '{{' }} $labels.instance {{ '}}' }} in the last hour -- the node restarted. If this was NOT a planned reboot, it is likely another occurrence of the lab-corner power-sag class (docs/ipam.md EVENT 2026-10-01): read /root/lab_witness.log on all three pve nodes for the drop ordering, then Loki for the final lines, then compute power-return from `Startup finished` + boot_time. Check `last -x | head` for whether wtmp recorded it as `crash` (unclean) or a clean shutdown, and check whether a surviving node's NIC carrier dropped (the sag signature). If the UPS went on battery at the same timestamp (ups_on_battery_transfer), the sag reached the mains feed and the UPS covered (or failed to cover) it -- both events together are the closing evidence."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Backup coverage + ZFS pool health (added 2026-10-03). Motivated by a
      # real find: Proxmox HA migrated dns-01/lb-01/mail-01/ntp-01 between
      # nodes while the per-node vzdump jobs (hardcoded vmid lists) stayed
      # put, so those guests silently stopped being backed up for weeks --
      # no error, no alert, the jobs reported OK nightly. The job lists are
      # now a single migration-proof union list (roles/proxmox_backup_jobs
      # + inventory/proxmox.yml); these rules are the two independent
      # safety nets: `guest_backup_missing` catches a guest dropping out
      # of *job coverage* (exactly-once membership across all three jobs),
      # and `guest_backup_stale` catches *execution* failures (job ran but
      # a guest's archive is old / the job errored) which coverage alone
      # cannot see.
      # ---------------------------------------------------------------------
      - uid: guest_backup_missing
        title: Production guest is not covered by any backup job
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # pve_not_backed_up_info is 1 for any guest the union of all
              # backup jobs fails to cover (sourced from PVE's own
              # /cluster/backup-info/not-backed-up API). Restricted to
              # production LXC guests: tc-* is the disposable Tanium test
              # fleet (rebuilt at will, deliberately unbacked -- see the
              # matching exclusion rationale on host_down), and vm-01
              # backs itself up to encrypted GDrive via vm_backup
              # (vm-backup-watchdog.timer watches it) rather than vzdump.
              # The anchored regex is deliberate: an unanchored `vm-01`
              # alternative would also exclude a future `vm-011`.
              expr: 'max by (id) (pve_not_backed_up_info{id=~"lxc/.+"} == 1) * on (id) group_left(name) max by (id, name) (pve_guest_info{id=~"lxc/.+", name!~"^(tc-.*|vm-01)$"})'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 6h
        annotations:
          summary: "{{ '{{' }} $labels.name {{ '}}' }} ({{ '{{' }} $labels.id {{ '}}' }}) is not covered by any backup job"
          description: "PVE reports no backup job covers {{ '{{' }} $labels.name {{ '}}' }}. This is the exact failure that left mail-01/lb-01/dns-01/ntp-01 unbacked for weeks after HA migrated them (2026-10-03) -- job coverage is checked against where guests ACTUALLY run, so a migration, a deleted vmid in the list, or a job lost in a pmxcfs hiccup all surface here. Fix: confirm the guest is in the union `pve_backup_vmids` list (inventory/proxmox.yml) and that all three nightly jobs carry it, then re-run `ansible-playbook ansible/deploy_pve_backup_jobs.yml`."
        labels:
          severity: warning
        isPaused: false

      - uid: guest_backup_stale
        title: Nightly PVE backup job errored or produced no archive
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # pvescheduler logs exactly one "Backup job finished" line per
              # nightly run per node: "...finished successfully" or
              # "...finished with errors". Scoped to unit="pvescheduler.service"
              # DELIBERATELY: the scheduled nightly job runs under that unit,
              # while manual/interactive vzdump invocations log under
              # session-*.scope -- verified live 2026-10-03 (a synthetic
              # `vzdump 99999` test produced an errors line under
              # session-6150.scope, which this rule must NOT treat as a
              # scheduled-job failure, and a real nightly run shows
              # unit=pvescheduler.service). This also means the rule fires
              # only for the actual nightly job, not for one-off manual runs.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", host=~"pve0.+", unit="pvescheduler.service"} |~ "Backup job finished with errors" [26h]))'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0m
        annotations:
          summary: "Nightly backup job on {{ '{{' }} $labels.host {{ '}}' }} finished WITH ERRORS in the last 26h"
          description: "At least one nightly vzdump run on {{ '{{' }} $labels.host {{ '}}' }} logged 'Backup job finished with errors' in the last 26 hours. One bad vmid in a job's list is enough to error the run while the rest still back up (verified 2026-10-03: a nonexistent vmid fails only its own entry -- the other guests in the same run complete normally). Check the newest task log: `pvesh get /nodes/{{ '{{' }} $labels.host {{ '}}' }}/tasks --typefilter vzdump` then read its log for the failing vmid and message (storage full, guest locked, vmid typo). Note: this covers EXECUTION failures; job-coverage drift is the separate guest_backup_missing rule."
        labels:
          severity: warning
        isPaused: false

      # 2026-10-21: two unmanaged duplicate guests ran on this cluster and
      # NOTHING alerted -- a container double-started on two nodes with the
      # same MACs and IPs for 22 hours (split brain), and VM ts-01 running on
      # pve01, which has no config for it, while the real ts-01 ran on pve02
      # for 8 days with its NIC counters at zero. Every other rule in this file
      # trusts Proxmox's own view of the world, and Proxmox did not know those
      # processes existed: `pct list` / `qm list` only list guests registered in
      # THAT node's config, so a leftover lxc-start / kvm from an interrupted
      # migration or a hand-started copy is invisible to it.
      #
      # roles/proxmox_common installs a 5-minute systemd timer on every PVE node
      # (orphan-guest-check.sh) that compares the managed VMID list against the
      # live guest-process table and writes this metric into the textfile
      # directory Alloy already scrapes there. A series only EXISTS while a
      # mismatch is present, so no data = healthy, any series = at least one
      # guest process is running for a vmid the node does not manage.
      # Off-site push liveness (added 2026-10-27 with the two push pipelines).
      # NOTE the max_over_time/absent_over_time form: these metrics are written
      # once per run (daily/weekly/monthly), so a plain `max()` stops existing a
      # few minutes after each push and `absent()` would then fire around the
      # clock. The lookback has to span more than one scheduled interval.
      # The push scripts write a success timestamp whenever a run completes, so
      # a dead timer, a revoked OAuth token, or a full/expired Drive remote
      # surfaces here instead of being discovered the next time a restore is
      # needed. `absent()` covers the case where the metric never arrives at
      # all (script never ran / was never deployed).
      - uid: offsite_backup_ha_stale
        title: Home Assistant off-site backup push has not succeeded
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Daily timer (06:15 America/Chicago) on hermes-gw-01. 2 days of
              # slack absorbs a missed run plus a long upload.
              expr: '(time() - max_over_time(ha_backup_push_last_success_timestamp_seconds[3d])) > bool 172800 or absent_over_time(ha_backup_push_last_success_timestamp_seconds[3d])'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
