      - uid: disk_full
        title: Disk usage high
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # Container rootfs datasets appear on the HOST's node_exporter
              # as /nvme-pool/subvol-<vmid>-disk-N mounts -- and a replicated
              # CT's dataset is mounted on ALL nodes, so one full container
              # paged once per node under the NODE's name (read as "pve01 out
              # of space"). Resolve subvol-<vmid> -> guest name via
              # pve_guest_info (id lxc/<vmid>) and report the GUEST; keep
              # only the node actually hosting the guest (replica copies
              # dropped -- also kills stale-replica-quota false positives);
              # prefer the in-guest node_exporter's own "/" when the guest
              # ships one (unless-suppression), else the host-side subvol
              # view. All row names land in $labels.display.
              # instance!~"tc-.*" excludes the disposable tanium_clients
              # test fleet -- see the matching exclusion + rationale on the
              # host_down rule above.
              # This branch (C) also carries the agentless QGA disk series
              # from roles/qga_disk_export (*.prom textfile on each pve
              # node), whose rows carry a `guest` label naming the TanOS
              # appliance VM (ts-01 etc.). The outer label_replace first
              # sets display=instance (pve0x) then OVERWRITES it with the
              # guest when that label is present, so an over-90% appliance
              # filesystem alerts under the guest name; series without a
              # guest label (every real node_exporter) are unchanged.
              editorMode: code
              expr: (label_replace((label_replace(100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} * 100), "id", "lxc/$1", "mountpoint", ".*subvol-([0-9]+)-disk-[0-9]+") * on (id, instance) group_left(name) max by (id, instance, name) (label_replace(pve_guest_info{name!~"tc-.*"}, "instance", "$1", "node", "(.+)"))) unless on (name) (label_replace(node_filesystem_size_bytes{job="node_exporter", mountpoint="/"}, "name", "$1", "instance", "(.+)")), "display", "$1", "name", "(.+)")) or (label_replace((label_replace(100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} * 100), "id", "lxc/$1", "mountpoint", ".*subvol-([0-9]+)-disk-[0-9]+")) unless on (id) max by (id) (pve_guest_info), "display", "$1", "instance", "(.+)")) or (label_replace(label_replace(100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", instance!~"tc-.*", mountpoint!~".*subvol-[0-9]+-disk-[0-9]+"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", instance!~"tc-.*", mountpoint!~".*subvol-[0-9]+-disk-[0-9]+"} * 100), "display", "$1", "instance", "(.+)"), "display", "$1", "guest", "(.+)"))
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [90]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "Disk on {{ '{{' }} $labels.display {{ '}}' }} ({{ '{{' }} $labels.mountpoint {{ '}}' }}) is over 90% full"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.display {{ '}}' }} has been above 90% utilization for 10 minutes"
        labels:
          severity: warning
        isPaused: false

      - uid: loki_write_errors
        title: Loki rejecting writes
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # Rate of 5xx responses on Loki's push API. >0 means Promtail
              # somewhere is failing to ship logs, and we lose log_* alert
              # substrate. Different failure mode than disk pressure (which
              # would also surface here, but earlier than that fires).
              expr: sum(rate(loki_request_duration_seconds_count{job="loki",route="loki_api_v1_push",status_code=~"5.."}[5m]))
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Loki rejecting push requests on vm-01"
          description: "Loki's /loki/api/v1/push endpoint is returning 5xx responses for 5+ minutes — Promtails somewhere are failing to ship logs. Check `loki_panic_total`, `loki_distributor_ingester_append_failures_total`, and the loki.service journal."
        labels:
          severity: critical
        isPaused: false

      - uid: loki_disk_pressure
        title: Loki disk pressure on vm-01
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # vm-01 ships Loki chunks to /var/lib/loki on `/` (ZFS subvol).
              # If `/` fills, Loki stops accepting writes and the log_* alerts
              # below all silently lose their substrate. Fire earlier than
              # the generic `disk_full` (which triggers at 90% used) so we
              # have headroom to prune chunks or expand storage.
              expr: 100 - (node_filesystem_avail_bytes{instance="vm-01",mountpoint="/"} / node_filesystem_size_bytes{instance="vm-01",mountpoint="/"} * 100)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [70]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "vm-01 root filesystem >70% full — Loki at risk"
          description: "vm-01's root filesystem (where /var/lib/loki lives) has been over 70% full for 10 minutes. If it fills, Loki stops accepting writes and every log_* alert loses its substrate. Prune old chunks or grow the subvol."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Loki-backed log alerts. These query the systemd-journal stream that
      # Promtail ships from every host. Use noDataState=OK so a Promtail
      # outage doesn't fire the alert (host_down would catch the underlying
      # cause anyway). Use `for:` to dampen single-event noise.
      #
      # SUDO AUDIT NOISE, structural fix (2026-10-21): a broad `|~` match over
      # the whole journal also matches the audit line sudo writes for every
      # command whose TEXT happens to contain the pattern -- a
      # `grep 'replication.*failed' /var/log/pve/replicate` run during an
      # investigation paged for a replication fault that did not exist. Those
      # audit lines are logged in unit=session-<id>.scope, so every broad rule
      # in this file now excludes that unit by LABEL MATCHER:
      #     unit!~"grafana-server.service|loki.service|alloy.service|session-.*\.scope"
      # That replaces the `!= "COMMAND="` line filter added under pressure
      # earlier today: the free-text filter only matched audit lines that still
      # carried the literal COMMAND= string (the journal truncates the message
      # on some paths) while being able to hide a genuine match that happened
      # to contain it. A unit label matcher can do neither.
      # ---------------------------------------------------------------------

      - uid: log_oom_kill
        title: OOM kill detected
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # Range query (NOT instant) is required here: with multiple
              # hosts matching simultaneously, an instant Loki query's
              # per-series host labels get lost in Grafana's frame
              # conversion, and the classic-condition/threshold node
              # downstream throws "frame cannot uniquely be identified by
              # its labels: has duplicate results with labels {}" — a
              # long-standing Grafana bug (see e.g. grafana/grafana#83448,
              # #104076) that silently replaces the real per-host alert
              # with a DatasourceError showing "[no value]" everywhere.
              # Range queries route through a different conversion path
              # that keeps labels intact (verified empirically against
              # this Loki 3.7.1 + Grafana 11.x pairing 2026-08-09).
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service|session-.*\\.scope", host!~"tc-.*"} |~ "Out of memory|invoked oom-killer" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              # Math (not classic-condition Threshold) so each host's
              # label set survives into the alert instance -- Threshold
              # on a multi-series input collapses everything into one
              # unlabeled instance, which is why the host label in the
              # annotations below used to render as "[no value]".
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 1m
        annotations:
          summary: "OOM killer ran on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Kernel OOM killer or systemd-oomd terminated a process on {{ '{{' }} $labels.host {{ '}}' }} in the last 5 minutes — host is under memory pressure"
        labels:
          severity: critical
        isPaused: false

      - uid: log_service_restart_loop
        title: Systemd service restart loop
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # above for why this can't be instant:true with multiple
              # simultaneous (host, unit) series.
              #
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file.
              expr: 'sum by (host, unit) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service|session-.*\\.scope", host!~"tc-.*"} |~ "Start request repeated too quickly|Failed to start" [10m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 5"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.unit {{ '}}' }} on {{ '{{' }} $labels.host {{ '}}' }} is restart-looping"
          description: "More than 5 systemd 'Failed to start' / 'Start request repeated too quickly' messages for {{ '{{' }} $labels.unit {{ '}}' }} on {{ '{{' }} $labels.host {{ '}}' }} in the last 10 minutes"
        labels:
          severity: warning
        isPaused: false

      - uid: log_ssh_brute_force
        title: SSH brute-force attempt
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              #
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file. SSH brute-force
              # detection is intentionally still active on these hosts'
              # actual reachability; this only stops the ALERT from paging,
              # same policy as every other tc-* exclusion here.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit="ssh.service", host!~"tc-.*"} |~ "Failed password|Invalid user" [10m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 10"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Possible SSH brute-force on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "More than 10 SSH 'Failed password' / 'Invalid user' events on {{ '{{' }} $labels.host {{ '}}' }} in the last 10 minutes — likely a brute-force attempt or scanner"
        labels:
          severity: warning
        isPaused: false

      - uid: log_kernel_io_error
        title: Kernel I/O error
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              #
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service|session-.*\\.scope", host!~"tc-.*"} |~ "I/O error|EXT4-fs error|Buffer I/O error|Medium error|blk_update_request" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 1m
        annotations:
          summary: "Kernel I/O error on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Kernel reported an I/O error, EXT4 filesystem error, buffer error, or block-layer failure on {{ '{{' }} $labels.host {{ '}}' }} — could be failing disk, ZFS scrub finding, or filesystem corruption"
        labels:
          severity: critical
        isPaused: false

      - uid: log_postfix_relay_failure
        title: Postfix relay failures on mail-01
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # Track postfix logging deferred or bounced messages on mail-01.
              # Catches "iCloud SMTP not authenticating", "queue piling up",
              # "rate limit hit" — anything that prevents alert email delivery.
              expr: 'sum (count_over_time({job="systemd-journal", host="mail-01", unit!~"session-.*\\.scope"} |~ "postfix.*status=(deferred|bounced)" [10m]))'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [3]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Postfix relay failures on mail-01"
          description: "More than 3 postfix `status=deferred` / `status=bounced` events in the last 10 minutes. Likely auth failure to smtp.mail.me.com, network issue, or rate limit. Check `postqueue -p` and `journalctl -u postfix`."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Dead-man's-switch — always-firing meta alert. Routed exclusively to
      # the healthchecks.io webhook (see policies + contact_points). If
      # healthchecks stops getting pings, the alert pipeline is broken
      # (Grafana down, network out, or the rule eval engine itself wedged)
      # and healthchecks pages out-of-band. Gated on healthchecks_dms_ping_url
      # so the rule disappears entirely when the URL isn't configured —
      # avoids a non-routed alert spamming HA/email every 5m.
      # ---------------------------------------------------------------------
{% if healthchecks_dms_ping_url is defined and healthchecks_dms_ping_url %}
      - uid: dead_mans_switch
        title: Dead man's switch
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 60
              to: 0
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "1"
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
              type: math
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        # noDataState moot (constant expression never produces NoData).
        # execErrState=Error so an expression-engine failure stops pings —
        # that's the whole point of a DMS, never mask a real outage.
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          summary: "Alert pipeline alive (dead man's switch)"
          description: "If healthchecks.io stops receiving these pings, Grafana / rule-eval / network is broken — page out-of-band."
        labels:
          severity: meta
          dms: "true"
        isPaused: false

{% endif %}
      # ---------------------------------------------------------------------
      # SECOND dead-man's-switch layer, added 2026-09-10: the healthchecks.io
      # rule above (gated behind healthchecks_dms_ping_url) only proves
      # Grafana's own rule-evaluation engine + internet egress are alive --
      # its expression is a constant `1`, datasourceUid __expr__, never
      # touching VictoriaMetrics at all. It would keep happily pinging
      # healthchecks.io even if VM died outright and every OTHER alert rule
      # (21 of them depend on datasourceUid: victoriametrics) silently had
      # zero real data to evaluate against. Given vm-01 and graf-01 run on
      # SEPARATE hosts (vm-01/graf-01 both currently on pve03, but as
      # distinct CTs/services that can fail independently of each other),
      # this is a real, previously-uncovered gap, not a hypothetical one.
      # Unlike the rule above, THIS one doesn't depend on healthchecks_dms_
      # ping_url being configured -- it only needs the victoriametrics
      # datasource, so it deploys unconditionally and routes through the
      # normal Discord/email contact points like any other alert.
      #
      # This rule queries VM for a genuinely live, always-present metric
      # (node_exporter's node_uname_info, remote-written by Alloy from every
      # host in the fleet) and fires if VM has stopped actually ingesting
      # real scrape data -- i.e. it proves the WHOLE pipeline (Alloy -> VM
      # remote-write -> Grafana query) is alive, not just Grafana's alerting
      # engine in isolation.
      - uid: metrics_pipeline_dead
        title: Metrics pipeline dead (VictoriaMetrics ingest stalled)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: count(node_uname_info)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [5]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        # noDataState=Alerting (not OK): a query returning literally no
        # series at all is exactly the failure mode this rule exists to
        # catch (VM down / unreachable), so NoData must page, not go quiet.
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "VictoriaMetrics has stopped ingesting real scrape data"
          description: "Fewer than 5 hosts are reporting node_uname_info (out of ~31 normally) -- either VictoriaMetrics itself is down/unreachable, or Alloy's remote-write path is broken fleet-wide. This is the real data-path check; the plain 'Dead man's switch' rule above only proves Grafana's rule engine is alive, not that it has real data to evaluate. Check `systemctl status victoriametrics` on vm-01 first."
        labels:
          severity: critical
        isPaused: false

      - uid: systemd_unit_failed
        title: systemd unit failed
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # Requires roles/alloy's systemd collector (enable_collectors
              # = ["systemd"], unit_include = ".+\\.service") -- added
              # 2026-09-10 fleet audit, which found pve03's chrony and
              # private-monitoring-firewall units both silently `failed`
              # for 3+ days with NO alert coverage anywhere (this is the
              # rule that closes that gap). state="failed" is one of
              # node_exporter's systemd collector's possible values
              # (active/inactive/failed/activating/deactivating).
              #
              # name!~ exclusion: live-fired on first deploy against
              # ifupdown-wait-online/networking/nvmf-autoconnect/openipmi
              # on graf-01, vm-01, media-ingest-01 -- these are the SAME
              # cosmetic LXC-container boilerplate noise already confirmed
              # benign this session (identical failures across unrelated
              # containers, no functional impact -- see 2026-09-10
              # Grafana/vm-01 sweep). Excluded here instead of silently
              # tolerating alert fatigue; a real regression in one of
              # these would need its own named rule, not this generic one.
              #
              # apparmor.service added to the exclusion 2026-09-10: fails
              # structurally on tailscale-gw (the only privileged CT with
              # nesting=1 in this fleet -- confirmed via `pct config 101`
              # showing no `unprivileged` key, vs. authentik/dns-01 which
              # are unprivileged and load apparmor fine). Root error is
              # "Permission denied; attempted to load a profile while
              # confined?" -- apparmor_parser can't load nested profiles
              # inside a privileged LXC's own host-applied AppArmor
              # confinement. Can't be fixed without converting the CT to
              # unprivileged (backup/recreate/restore per
              # roles/tailscale_gw_host's own comment on this), so this
              # will fail on every boot forever -- exclude rather than
              # let it page every ~10min indefinitely.
              #
              # instance!~"tc-.*" added 2026-09-20: excludes the disposable
              # tanium_clients test fleet -- see the matching exclusion +
              # rationale on the host_down rule earlier in this file.
              # tc-rocky9 alone had 2 stale silences sitting in
              # Alertmanager from routine rebuild/reboot churn on these
              # test boxes before this exclusion existed.
              editorMode: code
              expr: node_systemd_unit_state{state="failed", name!~"ifupdown-wait-online.service|networking.service|nvmf-autoconnect.service|openipmi.service|apparmor.service", instance!~"tc-.*"} == 1
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "{{ '{{' }} $labels.name {{ '}}' }} failed on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "systemd unit {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has been in `failed` state for 10+ minutes. SSH in and check `systemctl status {{ '{{' }} $labels.name {{ '}}' }}` + `journalctl -u {{ '{{' }} $labels.name {{ '}}' }}`. 10m threshold (vs. the usual 5m) to ride out transient restart-loop blips without paging."
        labels:
          severity: warning
        isPaused: false

      # Metric-based since 2026-10-21. The old Loki rule matched
      # "(?i)replication.*(failed|error)" over the systemd journal, so it fired
      # on the sudo audit line of ANY admin command that mentioned both words —
      # including a `grep -cE '... replication ... error' /var/log/pve/replicate`
      # run during an investigation. It was firing on its own noise, not on a
      # fault: all 20 jobs were OK with FailCount 0. pve_exporter already
      # exports the authoritative counter.
      - uid: log_pve_replication_failed
        title: pve replication failure
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: sum by (instance) (increase(pve_replication_failed_syncs[30m]))
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "pve replication failing on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "A sync failed on {{ '{{' }} $labels.instance {{ '}}' }}: `pvesr status` shows the job's FailCount and `/var/log/pve/replicate/<jobid>` the reason. Usual causes: root SSH between nodes (the sshd Match Address list must include 172.20.0.0/24 and 172.21.0.0/24 or every job dies with exit 255), a target node that is down, or a missing common base snapshot after a storage rename."
        labels:
          severity: warning
        isPaused: false

      # Silent counterpart: a job that stops running does not increment the
      # failure counter at all (e.g. pvescheduler disabled, job disabled, or a
      # target that stopped accepting). Jobs are staggered and run every 20m,
      # so an hour without a successful sync is already wrong.
      - uid: pve_replication_stalled
        title: pve replication stalled
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # max by (instance) was the bug in the original (2026-10-21)
              # version: it reports the NEWEST successful sync across ALL jobs
              # on the node, so one stalled job hides behind ~15 healthy ones
              # forever. Replication is per (instance, id) -- pve_exporter's
              # `id` label is the job id, e.g. 101-0 -- so age is computed per
              # job and a single stuck one now surfaces on its own.
              # Verified against the 2026-10-20/21 pve03 wedge window
              # (17:00Z-15:40Z): every job's age peaked at 1200s, i.e. exactly
              # its 20-minute schedule, and pve_replication_failed_syncs stayed
              # at 0 -- replication genuinely never stalled, so staying silent
              # was the CORRECT outcome for that incident. What that window did
              # expose is a different gap: pve_exporter could not scrape pve03
              # for ~46% of it (up{job="pve_exporter",instance="pve03"} == 0 in
              # 126 of 273 samples), and while the scrape is missing this rule
              # has no series to age at all (NoData -> OK). That is a scrape
              # config problem on vm-01, not something a threshold here can fix;
              # node_procs_blocked_high is the rule that DID see that wedge.
              expr: time() - max by (instance, id) (pve_replication_last_sync_timestamp_seconds)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [3600]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        annotations:
          summary: "pve replication job {{ '{{' }} $labels.id {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has not synced for over an hour"
          description: "Replication job {{ '{{' }} $labels.id {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has not had a successful sync for over an hour (value is the age in seconds; the schedule is 20 minutes, so this is 3+ missed cycles). Check `pvesr status` there and `systemctl status pvescheduler`; a job that silently stops is worse than one that fails, because nothing in the logs mentions it. Note this rule can only see a job while pve_exporter can still scrape the node -- if the node is unreachable the scrape has no data and neither does this rule (`up{job=\"pve_exporter\"}` covers that)."
        labels:
          severity: warning
        isPaused: false

      - uid: log_pve_quorum_lost
        title: pve cluster quorum lost
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # corosync logs membership / quorum changes via [QUORUM] and
              # [KNET]. The canonical actual-quorum-loss signals are
              # "non-primary component" (this node is no longer in the
              # majority partition) and "received write while not quorate".
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              #
              # REMOVED 2026-09-28: "no active links" -- that string is a
              # per-peer KNET link timeout, not a quorum signal. A single
              # peer's LAN ring flapping for ~2s (e.g. from the known
              # intermittent L2 duplicate-frame bursts on this segment)
              # emits "host: N has no active links" while all 3 nodes stay
              # quorate, so this rule false-fired 5x between 2026-09-25 and
              # 2026-09-27 ("pve cluster quorum lost" for events where
              # `pvecm status` stayed Quorate:Yes throughout). Quorum-lost
              # itself is emitted as "non-primary component ... will NOT
              # provide any services" / "received write while not quorate"
              # -- those remain matched here.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", host=~"pve0.+", unit!~"session-.*\\.scope"} |~ "(?i)not quorate|non-primary component|quorum lost" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 1m
        annotations:
          summary: "pve cluster quorum/peer issue on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Corosync logged a quorum loss or peer-drop event on {{ '{{' }} $labels.host {{ '}}' }}. With <2/3 nodes active the cluster goes read-only and HA stops migrating. Check `pvecm status` and `journalctl -u corosync`."
        labels:
          severity: critical
        isPaused: false

      - uid: log_postgres_fatal
        title: Postgres FATAL/PANIC
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service|session-.*\\.scope"} |~ "FATAL:|PANIC:" |~ "postgres" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 2m
        annotations:
          summary: "Postgres FATAL/PANIC on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Postgres logged a FATAL or PANIC line on {{ '{{' }} $labels.host {{ '}}' }} — connection storm, OOM, replication slot issue, or genuine corruption"
        labels:
          severity: critical
        isPaused: false

      # Added 2026-09-16 with roles/smartctl_exporter -- pve02/pve03's
      # aging SATA boot HDDs have no spare to replace them with, so
      # this is the actual "keep them alive as long as possible" early
      # warning: catch a NEW pending sector before it corrupts
      # something (the 2026-09-10 pve03 EXT4/pve-cluster incident
      # happened without any prior Grafana visibility at all -- the
      # only record was smartd's local root mail, unread). Both rules
      # query smartctl_device_attribute, sourced from
      # /var/lib/node_exporter/textfile_collector/smartctl.prom
      # (smartctl-textfile.timer, every 5min) via Alloy's textfile
      # collector.
      - uid: sata_boot_disk_pending_sector_nonzero
        title: SATA boot disk has a pending sector
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: smartctl_device_attribute{attribute="current_pending_sector"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} disk {{ '{{' }} $labels.disk {{ '}}' }} has a pending sector"
          description: "Current_Pending_Sector on {{ '{{' }} $labels.instance {{ '}}' }}'s {{ '{{' }} $labels.disk {{ '}}' }} is nonzero -- the drive has found a sector it can't read and is waiting to reallocate it on next write. This is the specific condition the Level1Techs write-to-LBA fix (2026-09-16 investigation) targets, but do NOT run that raw write against a live mounted root disk -- drain the node's CTs and do it from an unmounted/rescue context. See smartctl-textfile role notes and homelab warm memory 2233 for the full writeup and what's already been tried."
        labels:
          severity: warning
        isPaused: false

      - uid: sata_boot_disk_realloc_climbing
        title: SATA boot disk reallocated sector count increased
