      - uid: disk_full
        title: Disk usage high
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # Container rootfs datasets appear on the HOST's node_exporter
              # as /nvme-pool/subvol-<vmid>-disk-N mounts -- and a replicated
              # CT's dataset is mounted on ALL nodes, so one full container
              # paged once per node under the NODE's name (read as "pve01 out
              # of space"). Resolve subvol-<vmid> -> guest name via
              # pve_guest_info (id lxc/<vmid>) and report the GUEST; keep
              # only the node actually hosting the guest (replica copies
              # dropped -- also kills stale-replica-quota false positives);
              # prefer the in-guest node_exporter's own "/" when the guest
              # ships one (unless-suppression), else the host-side subvol
              # view. All row names land in $labels.display.
              # instance!~"tc-.*" excludes the disposable tanium_clients
              # test fleet -- see the matching exclusion + rationale on the
              # host_down rule above.
              editorMode: code
              expr: (label_replace((label_replace(100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} * 100), "id", "lxc/$1", "mountpoint", ".*subvol-([0-9]+)-disk-[0-9]+") * on (id, instance) group_left(name) max by (id, instance, name) (label_replace(pve_guest_info{name!~"tc-.*"}, "instance", "$1", "node", "(.+)"))) unless on (name) (label_replace(node_filesystem_size_bytes{job="node_exporter", mountpoint="/"}, "name", "$1", "instance", "(.+)")), "display", "$1", "name", "(.+)")) or (label_replace((label_replace(100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", mountpoint=~".*subvol-[0-9]+-disk-[0-9]+"} * 100), "id", "lxc/$1", "mountpoint", ".*subvol-([0-9]+)-disk-[0-9]+")) unless on (id) max by (id) (pve_guest_info), "display", "$1", "instance", "(.+)")) or (label_replace(100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", instance!~"tc-.*", mountpoint!~".*subvol-[0-9]+-disk-[0-9]+"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|devtmpfs", instance!~"tc-.*", mountpoint!~".*subvol-[0-9]+-disk-[0-9]+"} * 100), "display", "$1", "instance", "(.+)"))
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [90]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "Disk on {{ '{{' }} $labels.display {{ '}}' }} ({{ '{{' }} $labels.mountpoint {{ '}}' }}) is over 90% full"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.display {{ '}}' }} has been above 90% utilization for 10 minutes"
