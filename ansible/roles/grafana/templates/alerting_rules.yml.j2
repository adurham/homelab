          severity: critical
        isPaused: false

      - uid: zfs_pool_not_online
        title: ZFS pool not ONLINE on a Proxmox node
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 1200
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # node_zfs_zpool_state emits one series per (zpool, state)
              # pair with 1 only on the CURRENT state, from each pve node's
              # node_exporter (Alloy). nvme-pool on every node is a
              # SINGLE-DEVICE pool -- there is no redundancy, so any
              # non-online state (degraded/faulted/offline/suspended/
              # unavail) means that node's guest storage is at risk or
              # gone. This is the only pool-state alert that existed
              # nowhere before 2026-10-03. NOTE: a node that is fully DOWN
              # also stops emitting the metric -- that is host_down's job
              # (absent series can't fire this one).
              expr: 'max by (instance, zpool, state) (node_zfs_zpool_state{instance=~"pve0[123]", state!="online"} == 1)'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "ZFS pool {{ '{{' }} $labels.zpool {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} $labels.state {{ '}}' }}"
          description: "node_zfs_zpool_state reports {{ '{{' }} $labels.zpool {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} entered state '{{ '{{' }} $labels.state {{ '}}' }}'. Every pool here is a single NVMe device (no redundancy), so this is not a rebuild-someday warning -- if it is faulted/offline/suspended, that node's guests and local backup archives are at immediate risk. Check `zpool status -x` on the node and recent kernel logs for NVMe/controller errors (there is also a log_kernel_io_error rule)."
        labels:
          severity: critical
        isPaused: false

      - uid: nvme_data_drive_health
        title: NVMe data drive health signal (media errors / wear)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 90000
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Three independent NVMe health signals collapsed to a
              # single firing condition via weight-multiply (the value
              # itself encodes which check fired: 3=new media errors,
              # 2=spare low, 1=wear high). Metrics come from the
              # smartctl_exporter role's NVMe extension (added
              # 2026-10-03 with this rule): every pve node's data NVMe
              # is a SINGLE device holding all guest disks + the local
              # backup archives -- no redundancy. Consumer-SSD caveat:
              # a lone nonzero media_errors count can be benign, hence
              # the INCREASE over 24h rather than absolute > 0 (only
              # NEW errors page); available_spare below 20 and
              # percentage_used above 90 are the standard early-wear
              # lines (threshold ~10-20% spare remains until wear-out).
              expr: '((increase(smartctl_nvme_media_errors[24h]) > 0) * 3) or ((smartctl_nvme_available_spare < 20) * 2) or ((smartctl_nvme_percentage_used > 90) * 1)'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "NVMe data drive on {{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.disk {{ '}}' }}) reports a health signal"
          description: "Value 3 = new media errors in the last 24h (uncorrected data-integrity events on the device holding this node's guest disks AND its local backup archives — verify backups, watch for growth, consider `smartctl -a` and a `zpool scrub`); value 2 = available spare below 20% (wear-out approaching, plan replacement); value 1 = percentage_used above 90 (TBW near exhaustion). Single-digit transient media errors can be benign on consumer NVMe — this fires only on NEW errors within 24h. All pools are single-device: there is no ZFS redundancy to absorb a failure here."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Lab-corner UPS (roles/nut_ups on pve01). Added 2026-10-01 with the
      # CyberPower GX1500U install: the UPS both mitigates the recurring
      # deep-sag events AND is the measuring instrument for them -- upsmon
      # polls the device every 2s and logs every transfer to syslog, which
      # Alloy ships to Loki. This rule turns the next mains disturbance
      # into an immediately-stamped push instead of a post-mortem crash
      # reconstruction. See docs/ipam.md "INCIDENT CLASS B".
      # ---------------------------------------------------------------------

      - uid: ups_on_battery_transfer
        title: UPS on battery (lab corner) — mains transfer event
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # upsmon's stock ONBATT message is "UPS <name> on battery";
              # unit=nut-monitor.service is the upsmon systemd unit on the
              # owning node. Range query (not instant) for the same
              # label-preservation reason as the log_* rules above.
              #
              # The `|~` chain ALSO drops the two lines ups-selftest.sh emits
              # ("SELFTEST-MARKER starting..." and "self-test result: ..."):
              # a quick self-test transfers to battery for a few seconds and
              # would otherwise page as a fake mains event every month.
              # Filtering on the script's own markers is robust regardless of
              # how long the test transfer actually lasts.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit="nut-monitor.service", host="pve01"} |~ "(?i)on battery" != "SELFTEST-MARKER" != "self-test result" [10m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 0m
        annotations:
          summary: "Lab-corner UPS on pve01 transferred to BATTERY (mains disturbance at the lab corner)"
          description: "upsmon logged 'on battery' for the GX1500U -- the lab corner's mains feed dipped or dropped and the UPS took over. This is the timestamped transfer event the UPS was installed to capture (docs/ipam.md INCIDENT CLASS B). Next moves: note this timestamp; if pve_node_rebooted also fired around now, the sag was deeper than the UPS ride-through and nodes reset (read /root/lab_witness.log drop order); if nothing else fired, the UPS simply covered a sag -- compare against the Emporia whole-house CT at this minute (a 1-min average will miss a sub-second sag; absence of a house-wide dip + this event = lab-branch-local disturbance, now proven in real time). If the transfer is followed by no 'on line' recovery within minutes, the corner is RUNNING ON BATTERY: check runtime (nut_ups_battery_runtime) and decide about a graceful shutdown -- nothing auto-shuts-down by design (monitor-only)."
        labels:
          severity: warning
        isPaused: false

      - uid: ups_monitor_stale
        title: UPS telemetry stale (lab-corner GX1500U)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # The dump script always emits nut_ups_scrape_success (1 or 0);
              # 0 = upsc could not read the UPS (driver/upsd down or the USB
              # cable came out). The series going ABSENT entirely (host down)
              # is covered by host_down, hence noDataState: OK here.
              expr: nut_ups_scrape_success{instance="pve01"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [1]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 15m
        annotations:
          summary: "UPS metrics dump on pve01 has been failing (scrape_success=0) for 15m"
          description: "nut-ups-textfile.sh cannot read gx1500u via upsc -- the NUT driver or upsd is down, or the UPS USB cable is disconnected. Until this recovers the corner has NO event recording: transfers to battery will only surface via upsmon syslog (if upsmon is alive) or not at all. Check on pve01: `systemctl status nut-driver@gx1500u nut-server nut-monitor`, `upsc gx1500u`, `lsusb | grep 0764`. Re-run `ansible-playbook deploy_nut_ups.yml` if config drifted."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # UPS INPUT side. Added 2026-10-02 after a consult review pointed out a
      # real asymmetry: every other UPS rule watches the OUTPUT (did we go on
      # battery / did guests stop), but the original fault was diagnosed on
      # the INPUT (mains sag on the lab branch). Without this, the UPS can
      # silently absorb the very disturbance we're trying to characterise,
      # and a clean "no reboots" streak proves nothing.
      #
      # The value of this rule is NOT that it pages for a 2V wobble — it's
      # that any input-side event gives the next storm a timestamped cause
      # instead of another post-mortem. See docs/ipam.md INCIDENT CLASS B and
      # the "still unproven" caveat there.
      # ---------------------------------------------------------------------

      - uid: ups_input_sag_or_transfer
        title: UPS input disturbance (lab corner) — sag or AVR action
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Two independent signals of an input-side disturbance:
              #   * input.voltage below the observed steady band (121-123V)
              #   * the driver asserting BOOST/TRIM (AVR action) or OB (transfer)
              # Steady-state on this branch is 120-123V (196 samples over 18h,
              # all >=120V), so 115 is a deliberately conservative floor that a
              # real sag blows through but ordinary wobble does not.
              expr: 'min_over_time(nut_ups_input_voltage{instance="pve01"}[5m]) < 115 or max_over_time(nut_ups_status_bit{instance="pve01",status=~"BOOST|TRIM|OB"}[5m]) > 0'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0m
        annotations:
          summary: "Lab-corner UPS saw an INPUT-side disturbance (mains sag / AVR boost / transfer)"
          description: "This is the signal the whole UPS exercise is trying to capture: the lab corner's MAINS feed dipped, or the UPS's AVR had to boost/trim, or it transferred to battery. NOTE the 15s metric cadence means a sub-second sag can still be missed — a NEGATIVE here is weaker evidence than a positive. If this fires: (1) record the timestamp; (2) check whether ups_on_battery_transfer also fired (real transfer = the corner was actually on battery); (3) check whether pve_node_rebooted fired (the sag beat the UPS); (4) compare against the Emporia whole-house CT for that minute — a house-wide dip means upstream/grid, nothing house-side means the lab branch specifically. This turns the next event into a timestamped cause instead of a post-mortem."
        labels:
          severity: warning
        isPaused: false

      - uid: ups_selftest_failed
        title: UPS battery self-test failed or warned
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # ups-selftest.sh (monthly timer) writes one hot series per
              # outcome. Alert on any non-passed result: warning/error/
              # timeout/aborted all mean "the battery did not cleanly take
              # load this month", which is the leading indicator of a UPS that
              # has quietly become a power strip with a relay.
              expr: 'nut_ups_selftest_result{result!="passed",instance="pve01"} > 0'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0m
        annotations:
          summary: "Lab-corner UPS self-test did not pass ({{ '{{' }} $labels.result {{ '}}' }})"
          description: "The monthly quick battery self-test returned something other than 'passed'. The result label names the outcome: 'warning' = the UPS could not hold the load cleanly; 'error'/'aborted' = the test could not complete; 'timeout' = no final result inside the window. Any of these means the battery may no longer carry the corner, which matters because the guest autoshutdown's whole safety margin assumes it can. Act: `upsc gx1500u ups.test.result` for the raw string, then consider a human-supervised DEEP test and battery replacement (~3 year service life; check battery.mfr.date). Note a single 'warning' is not proof of failure — retest before ordering a battery. The self-test is suppressed around scheduled runs (see ups-selftest.sh) so this never reflects a test that did not run."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # UPS-driven guest autoshutdown (roles/ups_autoshutdown on pve01).
      # Added 2026-10-01: the daemon stops guests gracefully when the lab
      # corner is about to run out of battery, and restarts them when mains
      # is stable. These rules are how the operator learns it happened (or
      # WOULD have happened, while dry_run is on).
      # ---------------------------------------------------------------------

      - uid: ups_autoshutdown_dryrun_would_stop
        title: UPS autoshutdown WOULD stop the lab (dry run armed)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # 1 only while dry_run is on AND the trigger conditions are
              # currently met. This is the "flip dry_run off?" signal: it means
              # the real thing would have stopped the lab right now.
              expr: ups_autoshutdown_would_trigger{instance="pve01"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 2m
        annotations:
          summary: "DRY RUN: UPS autoshutdown would have stopped the lab just now"
          description: "The lab corner is on battery and below the stop thresholds (charge<=20% or runtime<=300s) and ups_autoshutdown is in dry_run mode, so it did NOT act. This is the moment to decide: check `ups-autoshutdown status` on pve01, confirm the guest list, and either flip dry_run off (roles/ups_autoshutdown/defaults/main.yml -> ansible-playbook deploy_ups_autoshutdown.yml -e ups_autoshutdown_dry_run=false) or leave it monitoring. If this fires repeatedly during real outages, the dry-run period is over."
        labels:
          severity: warning
        isPaused: false

      - uid: ups_autoshutdown_lab_stopped
        title: Lab auto-stopped — UPS battery exhausted
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # 1 from trigger through recovery complete (armed mode only).
              expr: ups_autoshutdown_lab_stopped{instance="pve01"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0m
        annotations:
          summary: "UPS autoshutdown stopped the lab (battery low on the lab corner)"
          description: "The lab corner ran out of battery and ups_autoshutdown stopped the guests gracefully. THIS MEANS THE MAINS IS OUT and the UPS is draining (or has already dropped the nodes, which would take this alert's own pipeline down too — if you're reading this after the fact, check /var/lib/ups-autoshutdown/state.json on pve01 for the timeline). Recovery is AUTOMATIC: once mains has been stable for 5 minutes (10 if a recovery happened in the last 30), the daemon restarts exactly the guests it stopped. To intervene manually: `ups-autoshutdown recover`, and `ups-autoshutdown disable` stops any further automation."
        labels:
          severity: critical
        isPaused: false

      # -----------------------------------------------------------------
      # SDN egress-path monitoring (added 2026-10-20). The outage these
      # close: an nftables package upgrade restarted nftables.service on
      # the containers, whose ExecStop is `nft flush ruleset`. It wiped
      # tailscale-gw's three nat POSTROUTING MASQUERADE rules, the whole
      # 172.16.0.0/24 SDN lost internet for ~an hour, dns-01's recursion
      # died, hermes-gw-01 + gallery-01 fell off the tailnet — and nothing
      # alerted. Probes live in roles/victoriametrics/templates/
      # prometheus.yml.j2; the rule inventory comes from roles/nat_metrics.
      # -----------------------------------------------------------------
      - uid: sdn_egress_down
        title: SDN internet egress down
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # max() over the two independent external targets: fires only
              # when BOTH fail, so a single provider hiccup or a blocked
              # endpoint never pages.
              expr: max(probe_success{job="blackbox_internet_egress"})
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "SDN (172.16.0.0/24) has lost internet egress"
          description: "HTTPS probes from vm-01 to both external endpoints have failed for 5 minutes. vm-01 leaves the SDN through tailscale-gw's MASQUERADE rules, so this is the end-to-end signal for an egress-path break. Check, in order: `systemctl is-active nftables` on the containers (must be inactive/masked — its ExecStop is `nft flush ruleset`), then `sudo iptables -t nat -S POSTROUTING | grep MASQUERADE` on tailscale-gw (expect 3 rules for 172.16.0.0/24), then `tailscale_gw_nat_masquerade_rules` on the dashboard for the same count. Re-add + persist with roles/harden_network_stack.yml. See docs/security-sweep-2026-10-19.md, 'Second sweep'."
        labels:
          severity: critical
        isPaused: false

      - uid: dns_recursion_down
        title: dns-01 recursive resolution down
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # The module asks dns-01 to RESOLVE an external name and
              # requires NOERROR. During the 2026-10-20 outage dns-01 kept
              # answering authoritative queries while every recursion
              # timed out, so a port-open check would have stayed green.
              expr: probe_success{job="blackbox_dns_recursion"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "dns-01 cannot resolve external names"
          description: "The recursive probe (www.google.com A via 172.16.0.10) has failed for 5 minutes. Authoritative answers can still be fine while recursion is broken — that was exactly the 2026-10-20 state, where dns-01 had no upstream because the SDN had lost egress. Check sdn_egress_down first, then `dig +short google.com @172.16.0.10` on any container. Also glance at probe_dns_answer_rrs for this job: NOERROR with 0 answers is the same fault wearing a different hat."
        labels:
          severity: critical
        isPaused: false

      - uid: tailnet_node_unreachable
        title: Tailnet-only container unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_tailnet_nodes"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} is unreachable on the tailnet"
          description: "SSH-banner probe to {{ '{{' }} $labels.target {{ '}}' }} has failed for 5 minutes. hermes-gw-01 and gallery-01 peer DIRECTLY on the tailnet and resolve via MagicDNS only, so they drop off the tailnet whenever their DNS path dies — during the 2026-10-20 SDN egress outage both vanished while still pingable on their LAN leg. Check the container's `tailscale status` from pve01 (`pct exec <vmid> -- tailscale status`) and `systemctl restart tailscaled` inside it after DNS is healthy again."
        labels:
          severity: warning
        isPaused: false

      - uid: nat_masquerade_rules_missing
        title: SDN gateway NAT rules missing
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              # Raw gauge + an `lt 3` threshold, deliberately NOT
              # `... < 3` as the expr: a healthy value of 3 makes `< 3`
              # return an empty vector, which noDataState would then have
              # to interpret. Same shape the other probe rules use.
              expr: tailscale_gw_nat_masquerade_rules
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [3]
                    type: lt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Alerting
        for: 2m
        annotations:
          summary: "tailscale-gw has fewer than 3 MASQUERADE rules"
          description: "The gateway's nat POSTROUTING chain is missing SDN egress rules (expected 3). Anything in 172.16.0.0/24 is about to lose — or already lost — internet. Most likely cause: nftables.service ran its ExecStop (`nft flush ruleset`), which is why it is masked on every container. Verify with `sudo iptables -t nat -S POSTROUTING | grep -c MASQUERADE` on tailscale-gw, re-apply + persist via `ansible-playbook harden_network_stack.yml`, and confirm nftables is still masked. noData here also fires: the nat_metrics timer (roles/nat_metrics) may have stopped."
        labels:
          severity: critical
        isPaused: false

