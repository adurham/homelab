                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 5"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.unit {{ '}}' }} on {{ '{{' }} $labels.host {{ '}}' }} is restart-looping"
          description: "More than 5 systemd 'Failed to start' / 'Start request repeated too quickly' messages for {{ '{{' }} $labels.unit {{ '}}' }} on {{ '{{' }} $labels.host {{ '}}' }} in the last 10 minutes"
        labels:
          severity: warning
        isPaused: false

      - uid: log_ssh_brute_force
        title: SSH brute-force attempt
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              #
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file. SSH brute-force
              # detection is intentionally still active on these hosts'
              # actual reachability; this only stops the ALERT from paging,
              # same policy as every other tc-* exclusion here.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit="ssh.service", host!~"tc-.*"} |~ "Failed password|Invalid user" [10m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: "$B > 10"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "Possible SSH brute-force on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "More than 10 SSH 'Failed password' / 'Invalid user' events on {{ '{{' }} $labels.host {{ '}}' }} in the last 10 minutes — likely a brute-force attempt or scanner"
        labels:
          severity: warning
        isPaused: false

      - uid: log_kernel_io_error
        title: Kernel I/O error
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # See the "Range query (NOT instant)" comment on log_oom_kill
              # for why this can't be instant:true with multiple
              # simultaneous host series.
              #
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service", host!~"tc-.*"} |~ "I/O error|EXT4-fs error|Buffer I/O error|Medium error|blk_update_request" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
