        isPaused: false

      - uid: orphan_guests
        title: Guest running outside Proxmox (orphan)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
