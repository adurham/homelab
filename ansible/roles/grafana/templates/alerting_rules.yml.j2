      - uid: loki_disk_pressure
        title: Loki disk pressure on vm-01
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              # vm-01 ships Loki chunks to /var/lib/loki on `/` (ZFS subvol).
              # If `/` fills, Loki stops accepting writes and the log_* alerts
              # below all silently lose their substrate. Fire earlier than
              # the generic `disk_full` (which triggers at 90% used) so we
              # have headroom to prune chunks or expand storage.
              expr: 100 - (node_filesystem_avail_bytes{instance="vm-01",mountpoint="/"} / node_filesystem_size_bytes{instance="vm-01",mountpoint="/"} * 100)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [70]
                    type: gt
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: "vm-01 root filesystem >70% full — Loki at risk"
          description: "vm-01's root filesystem (where /var/lib/loki lives) has been over 70% full for 10 minutes. If it fills, Loki stops accepting writes and every log_* alert loses its substrate. Prune old chunks or grow the subvol."
        labels:
          severity: warning
        isPaused: false

      # ---------------------------------------------------------------------
      # Loki-backed log alerts. These query the systemd-journal stream that
      # Promtail ships from every host. Use noDataState=OK so a Promtail
      # outage doesn't fire the alert (host_down would catch the underlying
      # cause anyway). Use `for:` to dampen single-event noise.
      # ---------------------------------------------------------------------

      - uid: log_oom_kill
        title: OOM kill detected
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: loki
            model:
              datasource:
                type: loki
                uid: loki
              # Range query (NOT instant) is required here: with multiple
              # hosts matching simultaneously, an instant Loki query's
              # per-series host labels get lost in Grafana's frame
              # conversion, and the classic-condition/threshold node
              # downstream throws "frame cannot uniquely be identified by
              # its labels: has duplicate results with labels {}" — a
              # long-standing Grafana bug (see e.g. grafana/grafana#83448,
              # #104076) that silently replaces the real per-host alert
              # with a DatasourceError showing "[no value]" everywhere.
              # Range queries route through a different conversion path
              # that keeps labels intact (verified empirically against
              # this Loki 3.7.1 + Grafana 11.x pairing 2026-08-09).
              # host!~"tc-.*" excludes the disposable tanium_clients test
              # fleet -- see the matching exclusion + rationale on the
              # host_down rule earlier in this file.
              expr: 'sum by (host) (count_over_time({job="systemd-journal", unit!~"grafana-server.service|loki.service|alloy.service", host!~"tc-.*"} |~ "Out of memory|invoked oom-killer" [5m]))'
              instant: false
              range: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              type: reduce
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
          - refId: C
            datasourceUid: __expr__
            model:
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              # Math (not classic-condition Threshold) so each host's
              # label set survives into the alert instance -- Threshold
              # on a multi-series input collapses everything into one
              # unlabeled instance, which is why the host label in the
              # annotations below used to render as "[no value]".
              expression: "$B > 0"
              type: math
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
        noDataState: OK
        execErrState: Error
        for: 1m
        annotations:
          summary: "OOM killer ran on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Kernel OOM killer or systemd-oomd terminated a process on {{ '{{' }} $labels.host {{ '}}' }} in the last 5 minutes — host is under memory pressure"
        labels:
          severity: critical
        isPaused: false

      - uid: log_service_restart_loop
        title: Systemd service restart loop
        condition: C
