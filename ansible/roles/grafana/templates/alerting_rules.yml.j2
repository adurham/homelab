    annotations:
      summary: '{{ '{{' }} $labels.instance }} ({{ '{{' }} $labels.tanium_role }}) is unreachable'
      description: blackbox TCP probe to {{ '{{' }} $labels.target }} (SSH :22) has failed
        for 5 minutes -- appliance is down, network path broken, or SSH crashed. Agentless
        replacement for the old node_exporter-based host_down check, which never worked
        on these TanOS appliances (default-deny iptables never opened :9100).
    labels:
      severity: critical
    isPaused: false
