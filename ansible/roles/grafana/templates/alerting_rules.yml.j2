apiVersion: 1
groups:
  - orgId: 1
    name: infrastructure
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: host_down
        title: Host down
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: up
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: Alerting
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} is down"
          description: "node_exporter on {{ '{{' }} $labels.instance {{ '}}' }} hasn't responded for 5 minutes"
        labels:
          severity: critical
        isPaused: false

      - uid: tanium_appliance_unreachable
        title: Tanium appliance unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_tanium_reachable"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.tanium_role {{ '}}' }}) is unreachable"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} (SSH :22) has failed for 5 minutes -- appliance is down, network path broken, or SSH crashed. Agentless replacement for the old node_exporter-based host_down check, which never worked on these TanOS appliances (default-deny iptables never opened :9100)."
        labels:
          severity: critical
        isPaused: false

      - uid: tanium_console_unreachable
        title: Tanium console unreachable
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: victoriametrics
            model:
              datasource:
                type: prometheus
                uid: victoriametrics
              editorMode: code
              expr: probe_success{job="blackbox_tanium_console"}
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: [0]
                    type: eq
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.tanium_role {{ '}}' }}) console unreachable on {{ '{{' }} $labels.target {{ '}}' }}"
          description: "blackbox TCP probe to {{ '{{' }} $labels.target {{ '}}' }} (Tanium console :443) has failed for 5 minutes — httpd down, Tanium services crashed, or the appliance is fully down. If postgres is also unreachable for the same host, the appliance is down."
        labels:
          severity: critical
        isPaused: false

      - uid: tanium_postgres_unreachable
        title: Tanium postgres unreachable
        condition: C
