# Grafana unified-alerting rules for graf-01.
# Source of truth: this template. Reconciled from the live file; edit HERE and deploy.
# Grafana label templating is escaped so Jinja leaves it alone.
apiVersion: 1
groups:
- orgId: 1
  name: infrastructure
  folder: Infrastructure
  interval: 1m
  rules:
  - uid: dead_mans_switch
    title: Dead man's switch
    condition: C
    data:
    - refId: A
      relativeTimeRange:
        from: 60
        to: 0
      datasourceUid: __expr__
      model:
        datasource:
          name: Expression
          type: __expr__
          uid: __expr__
        expression: '1'
        intervalMs: 1000
        maxDataPoints: 43200
        refId: A
        type: math
    - refId: C
      datasourceUid: __expr__
      model:
        conditions:
        - evaluator:
            params:
            - 0
            type: gt
          operator:
            type: and
          query:
            params:
            - A
          reducer:
            type: last
            params: []
          type: query
        datasource:
          name: Expression
          type: __expr__
          uid: __expr__
        expression: A
        intervalMs: 1000
        maxDataPoints: 43200
        refId: C
        type: threshold
    noDataState: OK
    execErrState: Error
    for: 0s
    annotations:
      summary: Alert pipeline alive (dead man's switch)
      description: "If healthchecks.io stops receiving these pings, Grafana / rule-eval\
        \ / network is broken \u2014 page out-of-band."
    labels:
      severity: meta
      dms: 'true'
    isPaused: false
  - uid: host_down
    title: Host down
    condition: C
    data:
    - refId: A
      relativeTimeRange:
        from: 600
        to: 0
      datasourceUid: victoriametrics
      model:
        datasource:
          type: prometheus
          uid: victoriametrics
        editorMode: code
        expr: up{job!="exo", instance!~"tc-.*", instance!="amd-workstation"}
        instant: true
        intervalMs: 1000
        maxDataPoints: 43200
        range: false
        refId: A
    - refId: C
      datasourceUid: __expr__
      model:
        conditions:
        - evaluator:
            params:
            - 0
            type: eq
          operator:
            type: and
          query:
            params:
            - A
          reducer:
            type: last
            params: []
          type: query
        datasource:
          name: Expression
          type: __expr__
          uid: __expr__
        expression: A
        intervalMs: 1000
        maxDataPoints: 43200
        refId: C
        type: threshold
    noDataState: Alerting
    execErrState: Error
    for: 5m
    annotations:
      summary: '{{ '{{' }} $labels.instance }} is down'
      description: node_exporter on {{ '{{' }} $labels.instance }} hasn't responded for 5
        minutes
    labels:
      severity: critical
    isPaused: false
  - uid: exo_server_down
    title: exo server process down
    condition: C
    data:
    - refId: A
      relativeTimeRange:
        from: 600
        to: 0
      datasourceUid: victoriametrics
      model:
        datasource:
          type: prometheus
          uid: victoriametrics
        editorMode: code
        expr: up{job="exo"}
        instant: true
        intervalMs: 1000
        maxDataPoints: 43200
        range: false
        refId: A
    - refId: C
      datasourceUid: __expr__
      model:
        conditions:
        - evaluator:
            params:
            - 0
            type: eq
          operator:
            type: and
          query:
            params:
            - A
          reducer:
            type: last
            params: []
          type: query
        datasource:
          name: Expression
          type: __expr__
          uid: __expr__
        expression: A
        intervalMs: 1000
        maxDataPoints: 43200
        refId: C
        type: threshold
    noDataState: Alerting
    execErrState: Error
    for: 5m
    annotations:
      summary: exo server down on {{ '{{' }} $labels.instance }}
      description: The exo inference server process on {{ '{{' }} $labels.instance }} hasn't
        responded on :52415/metrics for 5 minutes. This does NOT mean the Mac Studio
        itself is down -- it means the exo process specifically has stopped (crashed,
        restarting, mid mlx rebuild, cluster not started). Check with `ssh {{ '{{' }} $labels.instance
        }} 'ps aux | grep exo'` and the cluster start/log workflow before assuming
        hardware failure.
    labels:
      severity: critical
    isPaused: false
  - uid: exo_runners_not_ready
    title: exo model runners not ready
    condition: C
    data:
    - refId: A
      relativeTimeRange:
        from: 600
        to: 0
      datasourceUid: victoriametrics
      model:
        datasource:
          type: prometheus
          uid: victoriametrics
        editorMode: code
        expr: max(exo_runners{job="exo", status=~"RunnerReady|RunnerRunning|RunnerLoading|RunnerWarmingUp"})
          or vector(0)
        instant: true
        intervalMs: 1000
        maxDataPoints: 43200
        range: false
        refId: A
    - refId: C
      datasourceUid: __expr__
      model:
        conditions:
        - evaluator:
            params:
            - 2
            type: lt
          operator:
            type: and
          query:
            params:
            - A
          reducer:
            type: last
            params: []
          type: query
        datasource:
          name: Expression
          type: __expr__
          uid: __expr__
        expression: A
        intervalMs: 1000
        maxDataPoints: 43200
        refId: C
        type: threshold
    noDataState: Alerting
    execErrState: Error
    for: 4m
    annotations:
      summary: 'exo: fewer than 2 model runners ready'
      description: 'The exo cluster has had fewer than 2 runners in RunnerReady for
        4 minutes, so the served model (DeepSeek-V4.1-Flash, TP=2) cannot answer requests.
        exo re-places a crashed runner on its own in ~2 minutes; this means it did
        not come back. Check `grep -E ''crashed with critical|Runner terminated''
        ~/exo.log` on macstudio-m4-1/2, then relaunch with ./start_cluster.sh (rollback:
        DSV4_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp ./start_cluster.sh).'
    labels:
      severity: critical
    isPaused: false
  - uid: exo_runner_stuck_loading
    title: exo runner stuck loading
    condition: C
    data:
    - refId: A
      relativeTimeRange:
        from: 600
        to: 0
      datasourceUid: victoriametrics
      model:
        datasource:
          type: prometheus
          uid: victoriametrics
        editorMode: code
        expr: max(exo_runners{job="exo", status="RunnerLoading"}) or vector(0)
        instant: true
        intervalMs: 1000
        maxDataPoints: 43200
        range: false
        refId: A
    - refId: C
      datasourceUid: __expr__
      model:
        conditions:
        - evaluator:
            params:
            - 0
            type: gt
          operator:
            type: and
          query:
            params:
            - A
          reducer:
            type: last
            params: []
          type: query
        datasource:
          name: Expression
          type: __expr__
          uid: __expr__
        expression: A
        intervalMs: 1000
        maxDataPoints: 43200
        refId: C
        type: threshold
    noDataState: OK
    execErrState: Error
    for: 15m
    annotations:
      summary: 'exo: a runner has been stuck in RunnerLoading for 15+ minutes'
      description: At least one runner has reported RunnerLoading continuously for
        15 minutes. A normal MLX load of the served model's shards finishes well inside
        that window, so this means a wedged load (stuck download, OOM during load,
        RDMA/node_network stall). The cluster may still be serving on the other runner
        or not at all -- check ~/exo.log on both macstudios for the load's last progress
        line, then consider a clean relaunch with ./start_cluster.sh.
    labels:
      severity: warning
    isPaused: false
  - uid: tanium_appliance_unreachable
