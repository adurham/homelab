apiVersion: 1
policies:
  - orgId: 1
    receiver: homeassistant
    group_by:
      - alertname
      - instance
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
    routes:
{% if healthchecks_dms_ping_url is defined and healthchecks_dms_ping_url %}
      # Dead-man's-switch route. The `dms = "true"` matcher catches only
      # the always-firing `dead_mans_switch` rule and routes ONLY to
      # healthchecks.io — `continue: false` prevents fanout to HA/email,
      # which would mean a notification every 5m on those channels.
      # repeat_interval = 5m gives healthchecks (period=5m) a fresh ping
      # before the grace window expires.
      - receiver: healthchecks_dms
        matchers:
          - dms = "true"
        group_wait: 0s
        group_interval: 5m
        repeat_interval: 5m
        continue: false
{% endif %}
      # Mirror every alert to Discord (#infra-alerts). Dual-fanout
      # (continue: true) alongside HA + email — gives a clickthrough link
      # back to the firing alert/panel and a real scrollable history,
      # neither of which the HA mobile push or email provide.
      - receiver: discord_infra_alerts
        continue: true
        group_wait: 30s
        group_interval: 5m
        repeat_interval: 4h

      # Email fallback: CRITICAL ONLY. The personal mailbox is a paging
      # channel of last resort, not a second copy of every warning. With
      # the route unfiltered, the lab's warning-level alert storm delivered
      # ~90 alerts/day to that inbox (measured Sep-Oct 2026). Warnings still
      # reach HA mobile push and Discord; only severity=critical also emails.
      - receiver: email
        matchers:
          - severity = "critical"
        continue: true
        group_wait: 30s
        group_interval: 5m
        repeat_interval: 12h
