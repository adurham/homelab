apiVersion: 1
contactPoints:
  - orgId: 1
    name: homeassistant
    receivers:
      - uid: ha_webhook
        type: webhook
        disableResolveMessage: false
        settings:
          url: "{{ homeassistant_url }}/api/webhook/{{ grafana_alert_webhook_id }}"
          httpMethod: POST

  # #infra-alerts channel on "Nativedude's server" via Grafana's native
  # Discord webhook integration. Created 2026-08-08 specifically to fix
  # two gaps in the HA-push + email path: the HA mobile push has no
  # deep link back to the firing alert/panel, and neither push nor email
  # gives a real scrollable history — Discord gives both for free (the
  # channel IS the history, {{ '{{' }} .ExternalURL {{ '}}' }} gives the clickthrough).
  # use_discord_username=true so messages show as "Grafana Alerts" (the
  # webhook's configured name) rather than generic "Grafana".
  - orgId: 1
    name: discord_infra_alerts
    receivers:
      - uid: discord_infra_alerts
        type: discord
        disableResolveMessage: false
        settings:
          url: "{{ discord_infra_alerts_webhook_url }}"
          use_discord_username: true
          title: "{{ '{{' }} .CommonLabels.alertname {{ '}}' }}"
          message: >-
            {{ '{{' }} range .Alerts {{ '}}' }}**{{ '{{' }} .Labels.severity | default "unknown" {{ '}}' }}** — {{ '{{' }} .Annotations.summary {{ '}}' }}
            {{ '{{' }} if .Annotations.description {{ '}}' }}{{ '{{' }} .Annotations.description {{ '}}' }}
            {{ '{{' }} end {{ '}}' }}{{ '{{' }} end {{ '}}' }}
            [View in Grafana]({{ '{{' }} .ExternalURL {{ '}}' }})

  # Fallback path: emails the operator via mail-01 -> iCloud SMTP relay.
  # If HA is down, the webhook above fails and notifications drop. Email
  # via mail-01 doesn't depend on HA. Doesn't help if mail-01 is also
  # down -- for that, the dead-man's-switch below covers external paging.
  - orgId: 1
    name: email
    receivers:
      - uid: email_fallback
        type: email
        disableResolveMessage: false
        settings:
          addresses: "{{ alert_email_to }}"
          singleEmail: false
{% if healthchecks_dms_ping_url is defined and healthchecks_dms_ping_url %}

  # Dead-man's-switch: receives pings from the always-firing
  # `dead_mans_switch` rule. healthchecks.io expects a hit every N min;
  # if pings stop, healthchecks pages out-of-band — catches the failure
  # mode where Grafana / network / mail-01 are all down at once and the
  # other two contact points can't deliver.
  - orgId: 1
    name: healthchecks_dms
    receivers:
      - uid: healthchecks_dms
        type: webhook
        disableResolveMessage: true
        settings:
          url: "{{ healthchecks_dms_ping_url }}"
          httpMethod: POST
{% endif %}
