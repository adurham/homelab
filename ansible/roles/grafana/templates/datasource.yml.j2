apiVersion: 1

datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://172.16.0.30:8481/select/0/prometheus
    isDefault: true
    version: 2
    editable: true
    jsonData:
      httpMethod: POST

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://{{ hostvars['vm-01']['ansible_host'] }}:3100
    version: 2
    editable: true
