// Managed by Ansible — roles/pve_unattended_upgrades.
// Applies Debian security updates automatically; deliberately EXCLUDES
// Proxmox's own kernel/package stack, which needs planned, staggered
// reboots verified against cluster quorum -- never auto-updated blind.
// #clear first: apt.conf.d scopes MERGE across files (lists can only be
// cleared, never overridden -- apt.conf(5)). Debian's stock
// /etc/apt/apt.conf.d/50unattended-upgrades (read BEFORE this file)
// contributes "label=Debian" (the whole stable main archive) and
// "label=Debian-Security" origins, which silently widened this role's
// intended security-only policy to stable+security (observed live
// 2026-10-03: the effective policy wanted ~70 packages, not the 17
// security ones). This #clear erases everything accumulated so far and
// the block below re-asserts EXACTLY the security-only pattern.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};

// Never touch Proxmox kernel or core PVE packages automatically.
Unattended-Upgrade::Package-Blacklist {
{% for pkg in pve_unattended_upgrades_blacklist %}
        "{{ pkg }}";
{% endfor %}
};

// Never reboot automatically -- this is a live cluster.
Unattended-Upgrade::Automatic-Reboot "false";

// Remove unused dependencies after upgrades, standard hygiene.
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Log to syslog for visibility (Grafana/VictoriaMetrics already scrape
// journald -- makes upgrade activity queryable there too).
Unattended-Upgrade::SyslogEnable "true";
