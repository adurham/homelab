# Env file for the Grafana Discord Ack Bot (roles/grafana_ack_bot).
# Reuses the existing Hermes Discord bot token (vault_hermes_gw_discord_bot_token)
# and its incoming webhook on #infra-alerts (discord_infra_alerts_webhook_url) —
# no new bot/app needed. Reactions are plain Gateway events, not routed through
# Discord's global per-app Interactions Endpoint URL, so a second process on the
# same bot token cannot conflict with hermes-agent's own button/slash-command
# interaction handling.
DISCORD_BOT_TOKEN={{ vault_hermes_gw_discord_bot_token }}
DISCORD_WEBHOOK_URL={{ discord_infra_alerts_webhook_url }}
DISCORD_CHANNEL_ID={{ discord_infra_alerts_channel_id }}
GRAFANA_URL=http://172.16.0.41:3000
GRAFANA_SA_TOKEN={{ grafana_ack_bot_sa_token }}
ALLOWED_USER_IDS={{ discord_owner_user_id }}
HTTP_LISTEN_PORT=8990
