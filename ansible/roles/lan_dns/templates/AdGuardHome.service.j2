[Unit]
Description=AdGuard Home: Network-level blocker
ConditionFileIsExecutable={{ adguard_home_dir }}/AdGuardHome
After=syslog.target network-online.target

[Service]
StartLimitInterval=5
StartLimitBurst=10
ExecStart={{ adguard_home_dir }}/AdGuardHome "-s" "run"
WorkingDirectory={{ adguard_home_dir }}
Restart=always
RestartSec=4

[Install]
WantedBy=multi-user.target
