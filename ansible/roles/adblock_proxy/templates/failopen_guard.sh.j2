#!/bin/bash
# Fail-open guard for the transparent interceptor (installed by
# roles/adblock_proxy, run every 20s by adblock-failopen.timer).
#
# WHY: devices using this host as a Tailscale exit node send ALL of their
# traffic here. While the listener is healthy that is exactly the point, but if
# mitmdump is down (crash loop, slow/failed boot, OOM) the PREROUTING REDIRECT
# rules point 443/80 at a port with nothing on it, so those devices don't just
# lose ad filtering — they lose the internet entirely. Unfiltered internet
# beats no internet, so: pull the REDIRECT rules while unhealthy, put them back
# once the listener is up again. The window is at most one timer interval.
#
# "Unhealthy" includes a process that is UP but cannot accept connections. On
# 2026-11-05 the proxy saturated a 1024-fd soft limit: the unit stayed active,
# the port stayed LISTEN, and every accept failed with EMFILE — so the port
# check above called it healthy while exit-node clients had no DNS and no app
# connectivity. Accept errors are therefore their own unhealthy signal, and the
# remedy there is a restart (which clears the descriptors), not just fail-open.
#
# Exit status is always 0: the timer runs this as a oneshot unit, and a
# deliberate fail-open is not a unit failure (a real failure would be the guard
# itself not running).
set -uo pipefail

PORT=8443
IFACES="tailscale0 eth1"
PORTS="443 80"
UNIT=adblock-proxy-transparent
STAMP=/var/lib/adblock-proxy/last_guard_restart
RESTART_QUIET_SECONDS=120   # never restart more often than this (loop guard)
# QUIC/HTTP3 is UDP 443: mitmproxy handles TCP only, so a client that switches
# to QUIC skips the interceptor entirely (measured 2026-11-05: the MacBook was
# actively sending QUIC to Google IPs). Rejecting UDP 443 on the exit-node path
# makes apps fall back to TCP/443, which IS redirected. Kept here rather than
# only in /etc/iptables/rules.v4 because that file is written from a template
# that intentionally does not manage the FORWARD chain (Tailscale owns
# ts-forward there), so a playbook run can drop anything we add to it.
QUIC_REJECT_IFACE=tailscale0
ACCEPT_ERROR_LIMIT=20       # errors inside the lookback window that mean EMFILE

healthy=0
systemctl is-active --quiet "$UNIT" || healthy=-1
if [ "$healthy" = 0 ] && ss -ltn "sport = :${PORT}" 2>/dev/null | grep -q LISTEN; then
    healthy=1
fi

# An up-but-EMFILE process: count accept errors only since the unit last
# started, so a fresh restart is not immediately re-flagged by its own history.
if [ "$healthy" = 1 ]; then
    started=$(systemctl show -p ActiveEnterTimestamp --value "$UNIT")
    now=$(date +%s)
    started_epoch=$(date -d "$started" +%s 2>/dev/null || echo 0)
    if [ $((now - started_epoch)) -lt 180 ]; then since="$started"; else since="-3 min"; fi
    errors=$(journalctl -u "$UNIT" --since "$since" --no-pager 2>/dev/null \
             | grep -cE "Too many open files|EMFILE")
    if [ "${errors:-0}" -gt "$ACCEPT_ERROR_LIMIT" ]; then
        last=0
        [ -f "$STAMP" ] && last=$(cat "$STAMP" 2>/dev/null || echo 0)
        if [ $((now - last)) -gt "$RESTART_QUIET_SECONDS" ]; then
            echo "$now" > "$STAMP" 2>/dev/null || true
            logger -t adblock-guard "interceptor logged ${errors} accept errors (fd exhaustion) — restarting it"
            systemctl restart "$UNIT"
            healthy=-1   # fail open until it is serving again
        else
            logger -t adblock-guard "interceptor still logging accept errors, restart suppressed (last <${RESTART_QUIET_SECONDS}s ago)"
            healthy=-1
        fi
    fi
fi

# The QUIC reject only works ABOVE Tailscale's `-j ts-forward` jump: ts-forward
# marks and ACCEPTs every packet arriving on tailscale0, so a copy sitting below
# it never matches a single packet (measured 2026-11-05: rule present, 0 packets,
# QUIC flowing freely — the old existence check was satisfied by an ineffective
# copy).
#
# Phones are exempt: iOS apps (Instagram especially) reach for HTTP/3 first, and
# forcing them onto TCP behind an exit node made the app crawl — "loading very
# slowly or not at all" with dozens of retries against i-fallback.instagram.com
# while nothing was even being intercepted. Only the clients we actually rewrite
# (the Mac) need HTTP/3 pushed back to TCP.
QUIC_EXEMPT_SOURCES="{{ quic_exempt_sources | default('100.101.211.44 100.112.36.2') }}"

quic_expected_prefix() {
    printf -- '-P FORWARD ACCEPT\n'
    for src in $QUIC_EXEMPT_SOURCES; do
        printf -- '-A FORWARD -s %s/32 -p udp -m udp --dport 443 -j ACCEPT\n' "$src"
    done
    printf -- '-A FORWARD -i %s -p udp -m udp --dport 443 -j REJECT --reject-with icmp-port-unreachable\n' "$QUIC_REJECT_IFACE"
    printf -- '-A FORWARD -j ts-forward\n'
}

quic_layout_ok() {
    [ "$(iptables -S FORWARD 2>/dev/null | head -n 5)" = "$(quic_expected_prefix)" ]
}

quic_place() {
    # strip every copy (order included), then rebuild the canonical prefix
    while iptables -C FORWARD -i "$QUIC_REJECT_IFACE" -p udp --dport 443 \
            -j REJECT --reject-with icmp-port-unreachable 2>/dev/null; do
        iptables -D FORWARD -i "$QUIC_REJECT_IFACE" -p udp --dport 443 \
            -j REJECT --reject-with icmp-port-unreachable 2>/dev/null || break
    done
    for src in $QUIC_EXEMPT_SOURCES; do
        while iptables -C FORWARD -s "$src" -p udp --dport 443 -j ACCEPT 2>/dev/null; do
            iptables -D FORWARD -s "$src" -p udp --dport 443 -j ACCEPT 2>/dev/null || break
        done
    done
    # insert REJECT first, then each exemption lands above it
    iptables -I FORWARD 1 -i "$QUIC_REJECT_IFACE" -p udp --dport 443 \
        -j REJECT --reject-with icmp-port-unreachable 2>/dev/null
    # reverse order, so the first listed source ends up first in the chain
    for src in $(echo "$QUIC_EXEMPT_SOURCES" | awk '{for (i = NF; i > 0; i--) print $i}'); do
        iptables -I FORWARD 1 -s "$src" -p udp --dport 443 -j ACCEPT 2>/dev/null
    done
    logger -t adblock-guard "QUIC policy rebuilt: reject on $QUIC_REJECT_IFACE above ts-forward, exempt: $QUIC_EXEMPT_SOURCES"
}

nat_rule() { iptables -t nat -C PREROUTING -i "$1" -p tcp --dport "$2" -j REDIRECT --to-ports "$PORT" 2>/dev/null; }
add_rule() { iptables -t nat -A PREROUTING -i "$1" -p tcp --dport "$2" -j REDIRECT --to-ports "$PORT" 2>/dev/null; }
del_rule() { iptables -t nat -D PREROUTING -i "$1" -p tcp --dport "$2" -j REDIRECT --to-ports "$PORT" 2>/dev/null; }

if [ "$healthy" = 1 ]; then
    for i in $IFACES; do for p in $PORTS; do
        nat_rule "$i" "$p" || add_rule "$i" "$p"
    done; done
    quic_layout_ok || quic_place
    exit 0
fi

removed=0
for i in $IFACES; do for p in $PORTS; do
    if nat_rule "$i" "$p"; then del_rule "$i" "$p"; removed=$((removed+1)); fi
done; done
[ "$removed" -gt 0 ] && logger -t adblock-guard "interceptor unhealthy — removed ${removed} REDIRECT rule(s), failing open"
exit 0
