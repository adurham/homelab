#!/opt/adblock-proxy/venv/bin/python3
"""Minimal static file server for proxy.pac, bound to tailscale0 only.

WHY NOT `python3 -m http.server`: its default MIME-type guesser doesn't
know the .pac extension and serves it as application/octet-stream (or
text/plain depending on Python version), which some OS/browser PAC
parsers reject outright -- the correct MIME type per RFC-adjacent
convention (there's no formal RFC, but this is what every major browser
and OS expects) is application/x-ns-proxy-autoconfig. This script is a
~20-line stdlib-only HTTP server that serves exactly one file with the
correct header, nothing else -- no directory listing, no other paths.
"""
import http.server
import socketserver

LISTEN_HOST = "{{ adblock_proxy_listen_host }}"
LISTEN_PORT = {{ adblock_proxy_pac_port }}
PAC_PATH = "/proxy.pac"
PAC_FILE = "/opt/adblock-proxy/proxy.pac"


class PacHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != PAC_PATH:
            self.send_response(404)
            self.end_headers()
            return
        try:
            with open(PAC_FILE, "rb") as f:
                body = f.read()
        except OSError:
            self.send_response(500)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/x-ns-proxy-autoconfig")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):  # noqa: A002 - stdlib signature
        # Keep the journal readable -- this endpoint gets hit on every
        # network change / PAC re-evaluation by every configured device,
        # which is noisy and not worth the default access-log format.
        pass


class ReusableTCPServer(socketserver.TCPServer):
    allow_reuse_address = True


if __name__ == "__main__":
    with ReusableTCPServer((LISTEN_HOST, LISTEN_PORT), PacHandler) as httpd:
        httpd.serve_forever()
