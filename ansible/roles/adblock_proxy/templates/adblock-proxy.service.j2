[Unit]
Description=Adblock Proxy (mitmproxy, explicit HTTPS proxy for personal devices)
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=mitmproxy
Group=mitmproxy
WorkingDirectory=/opt/adblock-proxy
Environment=HOME=/home/mitmproxy
# Binds ONLY to the tailscale0 interface IP — unreachable from eth0/private
# SDN or any LAN. This is the opt-in boundary: a device must be on the
# tailnet to even establish a TCP connection to the proxy.
ExecStart=/opt/adblock-proxy/venv/bin/mitmdump \
  --listen-host {{ adblock_proxy_listen_host }} \
  --listen-port 8080 \
  --set confdir=/home/mitmproxy/.mitmproxy \
  -s /opt/adblock-proxy/ad_block.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/mitmproxy /opt/adblock-proxy
# LogsDirectory (not ReadWritePaths) is systemd's native way to create
# and grant /var/log/mitmproxy — see the transparent unit's comment for
# the full ReadWritePaths-vs-LogsDirectory rationale. Needed here too:
# ad_block.py's response() hook (Reddit inline-ad capture, added
# 2026-08-21) runs on BOTH proxies since they share the same addon, and
# without this the explicit proxy hits "Read-only file system" trying
# to write capture files (confirmed live 2026-08-21 immediately after
# first deploy — capture silently failed via the addon's own try/except
# but the failure showed up in the journal).
LogsDirectory=mitmproxy

[Install]
WantedBy=multi-user.target
