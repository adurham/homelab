"""
Midea cloud token/key (K1) capture addon for mitmproxy.

ONE-TIME USE TOOL. Purpose: the midea-beautiful-air library (used by the
HA custom component midea_dehumidifier_lan) needs a Midea cloud login to
mint a token/key pair per appliance ONCE. After that pair is obtained,
all further communication with the dehumidifiers is 100% local (LAN UDP
discovery + TCP port 6444) — the cloud is never touched again.

As of 2026-08-07 the library's OWN cloud login call is broken upstream
(Midea returned error 40502/40404 "invalid business interface" / "access
address does not exist" against two different library versions, 0.10.5
and 0.10.7 — a genuine server-side API change, not a session-limit
retry-able issue like the older 65027 error). The official MSmartHome
phone app still works fine (different client entirely), so it already
has valid tokens for both dehumidifiers. This addon intercepts THAT
app's traffic (via the existing Tailscale-exit-node transparent proxy)
to recover the token/key pair straight from a real, working login.

Runs alongside discord_adblock.py as a second -s script on the SAME
mitmdump transparent-mode instance (port 8443) — no new proxy, no new
port, reuses the existing adblock-proxy-01 infrastructure entirely.

SNI-scoped exactly like the Discord addon: only mp-prod.appsmb.com (the
real Midea cloud API host, confirmed live via `--log DEBUG` against the
midea-beautiful-air CLI 2026-08-07 — POST /mas/v5/app/proxy?alias=...)
gets TLS-terminated. Everything else passes through as opaque encrypted
TCP, so this doesn't touch any other app's traffic on the phone,
including Discord (that addon's own tls_clienthello hook independently
decides what IT intercepts).

Multiple tls_clienthello hooks across loaded addons are evaluated in
order; if discord_adblock.py's hook already set ignore_connection=True
for a non-Discord SNI, this hook still runs and can override it back to
interception scope for Midea's host specifically — mitmproxy applies the
LAST hook's decision, so load order matters (see the transparent.service
template: this addon is loaded SECOND, after discord_adblock.py).

Captured data is logged to /var/log/mitmproxy/midea_capture.log (plain
text, readable, greppable) — NOT to mitmproxy's own flow storage, so it
survives independent of mitmweb/mitmproxy CA trust flows and is easy to
pull with `journalctl` or a simple `cat`.

Usage: with this addon loaded, open the MSmartHome app on a phone
routed through adblock-proxy-01 as a Tailscale exit node (Settings >
General > VPN & Device Management > adblock-proxy-01 > toggle on) and
either open/refresh the dehumidifier device list, or just launch the
app if it auto-refreshes on foreground. Any successful login/appliance
list call gets logged here. Token/key values appear in the JSON body of
the appliance-list response and the token-exchange response.

Remove this addon (drop the -s flag in the transparent.service unit)
once the token/key are captured — no reason to keep intercepting Midea
traffic indefinitely.
"""
import json
import re
from datetime import datetime, timezone

from mitmproxy import ctx, http, tls

MIDEA_HOSTS = {"mp-prod.appsmb.com"}

LOG_PATH = "/var/log/mitmproxy/midea_capture.log"
LOG_TAG = "MIDEA_CAPTURE"

# Response bodies that plausibly carry a token/key (K1) pair or an
# appliance list (which embeds per-device tokens). Matched loosely on
# key names actually used by midea-beautiful-air's cloud.py (token, key,
# udpId, applianceCode) rather than trying to guess exact endpoint paths
# — Midea's own app may call different routes than the Python library.
INTERESTING_KEY_PATTERNS = re.compile(r'"(token|key|udpId|applianceCode|sn|id)"\s*:', re.IGNORECASE)


def _is_midea_host(host: str) -> bool:
    return bool(host) and host in MIDEA_HOSTS


def _log(line: str) -> None:
    ts = datetime.now(timezone.utc).isoformat()
    try:
        with open(LOG_PATH, "a") as f:
            f.write(f"[{ts}] {line}\n")
    except OSError as e:
        ctx.log.warn(f"[{LOG_TAG}] could not write {LOG_PATH}: {e}")


def tls_clienthello(data: tls.ClientHelloData) -> None:
    """Only intercept Midea's cloud API host. Every other SNI (including
    ones discord_adblock.py already decided to ignore) is left alone —
    this hook only takes an ACTIVE stance (ignore_connection = False is
    the default; we never need to set it) for the one host we care
    about, and does nothing for everything else so discord_adblock.py's
    decision for non-Midea hosts stands."""
    sni = data.client_hello.sni
    if sni and _is_midea_host(sni):
        # Explicitly false (not just "don't set it") in case a
        # differently-ordered hook already flagged this connection for
        # passthrough — Midea's host is never in that set today, but
        # this makes the precedence unambiguous regardless of load order.
        data.ignore_connection = False


def request(flow: http.HTTPFlow) -> None:
    host = flow.request.pretty_host
    if not _is_midea_host(host):
        return
    ctx.log.info(f"[{LOG_TAG}] request {host}{flow.request.path}")


def response(flow: http.HTTPFlow) -> None:
    host = flow.request.pretty_host
    if not _is_midea_host(host):
        return

    path = flow.request.path.split("?", 1)[0]
    status = flow.response.status_code if flow.response else None

    try:
        body_text = flow.response.get_text() if flow.response else ""
    except ValueError:
        body_text = ""

    has_interesting_keys = bool(body_text) and bool(INTERESTING_KEY_PATTERNS.search(body_text))

    summary = f"{host}{path} -> {status} ({'CAPTURE' if has_interesting_keys else 'pass'})"
    ctx.log.info(f"[{LOG_TAG}] {summary}")

    if has_interesting_keys:
        try:
            parsed = json.loads(body_text)
            pretty = json.dumps(parsed, indent=2)
        except (json.JSONDecodeError, ValueError):
            pretty = body_text
        _log(f"{summary}\n{pretty}\n{'-' * 60}")
