auto lo
iface lo inet loopback

auto {{ physical_interface }}
iface {{ physical_interface }} inet manual

auto vmbr0
iface vmbr0 inet static
	address {{ hostvars[inventory_hostname].ansible_host }}/24
	gateway {{ net_lan_gateway }}
	bridge-ports {{ physical_interface }}
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids {{ net_pve_sync_vlan_id }} {{ net_pve_migrate_vlan_id }}

source /etc/network/interfaces.d/*

{% if hostvars[inventory_hostname].pve_sync_vlan_ip is defined %}
# Isolated PVE Sync VLAN ({{ net_pve_sync_vlan_id }}) for corosync (link1,
# preferred over the LAN link0) + ZFS replication. No gateway -- not
# routed, invisible to the rest of the LAN by design. Physically confined
# to switch ports 3/4/5 (see docs/ipam.md "PVE Sync network"). The
# bridge-vids line above on vmbr0 is REQUIRED for this to actually work
# -- without it the VLAN exists on the bridge but never egresses the
# physical port, and traffic silently times out.
auto vmbr0.{{ net_pve_sync_vlan_id }}
iface vmbr0.{{ net_pve_sync_vlan_id }} inet static
	address {{ hostvars[inventory_hostname].pve_sync_vlan_ip }}/24
{% endif %}
{% if hostvars[inventory_hostname].pve_migrate_vlan_ip is defined %}
# Isolated PVE Migrate VLAN ({{ net_pve_migrate_vlan_id }}) for live-migration
# traffic (datacenter.cfg `migration: secure,network=`) + the node-to-node SSH
# tunnel that transports it. Same topology as the sync VLAN above: no gateway,
# firewall-allowed peer-to-peer only. Codified here AFTER a silent deletion:
# this was hand-configured on the nodes but absent from this template, so the
# 2026-09-11 deploy_proxmox.yml run re-rendered the file without it and broke
# every HA live migration until 2026-09-28 (HA falls back to a failed migrate,
# then stop+start -- restarting the guest). Do NOT drop this block; the
# bridge-vids line above must keep listing {{ net_pve_migrate_vlan_id }} or
# tagged frames never egress {{ physical_interface }}.
auto vmbr0.{{ net_pve_migrate_vlan_id }}
iface vmbr0.{{ net_pve_migrate_vlan_id }} inet static
	address {{ hostvars[inventory_hostname].pve_migrate_vlan_ip }}/24
{% endif %}
