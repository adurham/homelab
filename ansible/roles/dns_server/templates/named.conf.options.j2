acl "trusted" {
        127.0.0.0/8;
        ::1;              # IPv6 loopback — needed for `dig @localhost` from dns-01 itself
        {{ net_lan_range }};  # LAN
        {{ net_private_range }};    # Private SDN
        100.64.0.0/10;    # Tailscale (just in case)
};

tls local-tls {
    key-file "/etc/bind/ssl/key.pem";
    cert-file "/etc/bind/ssl/fullchain.pem";
};

options {
        directory "/var/cache/bind";

        recursion yes;
        allow-query { trusted; };

        # Upstream resolution via the LAN resolvers (AdGuard Home pair on
        # pve01/pve02 at 192.168.86.4 and .5). AdGuard does DoT upstream to
        # Cloudflare/Quad9 and applies the ad-block lists, so forwarding to it
        # gives encrypted egress + filtering and avoids running a duplicate
        # DoT proxy (stubby) here.
        # bind <-> AdGuard is plaintext-on-LAN -- accepted, since the
        # encrypted boundary is at the WAN egress.
        # forward-only fails closed if both are down: lab DNS breaks but no
        # plaintext fallback to public root resolvers.
        #
        # 2026-11-10: this used to name {{ ip_homeassistant }} (the HA Green's
        # AdGuard). That add-on was removed when DNS/DHCP moved to the two
        # containers, which left dns-01 SERVFAILing every external name -- and
        # that silently broke anything on this subnet that resolves by name,
        # including the Grafana ack bot's connection to discord.com. Keep the
        # upstreams EXTERNAL: forwarding to the LAN pair made alerting depend
        # on the resolvers it monitors (circular), 2026-11-10.
        forwarders {
{% for resolver in dns_server_forwarders %}
                {{ resolver }};
{% endfor %}
        };
        forward only;

        # Don't fingerprint bind by version string. Default behavior is to
        # respond with the full build string for `version.bind` / `hostname.bind`
        # CHAOS-class TXT queries; this makes bind respond with "none" instead.
        version "none";
        hostname "none";

        # DNSSEC validation is enforced by the UPSTREAM (AdGuard Home;
        # dnssec_enabled=true, verified live -- it SERVFAILs
        # dnssec-failed.org), NOT at this layer. Keep it OFF here: AdGuard
        # deliberately SYNTHESIZES unsigned responses in two routine
        # cases, and a validating resolver rejects both with SERVFAIL:
        #   1. disable_ipv6=true (AdGuard setting) -- every AAAA query for
        #      a signed zone gets a synthetic NODATA carrying AdGuard's
        #      unsigned fake-for-negative-caching.adguard.com SOA, which
        #      cannot prove NODATA for a signed zone.
        #   2. Ad/tracker-blocked domains -- synthesized NXDOMAIN/0.0.0.0.
        # Measured 2026-10-03 before this change: 9 of 30 popular domains
        # SERVFAILed on AAAA via this resolver (cloudflare.com,
        # discord.com, healthchecks.io, ollama.com, ...) while the same
        # query via AdGuard directly was NOERROR; `dig +cd` against THIS
        # resolver also returned NOERROR, proving the validator was the
        # rejecting layer. The resulting SERVFAIL churn took the
        # healthchecks.io dead-man's-switch pings down ~15 min (the
        # 2026-10-03 DNS incident). Do NOT re-enable without first making
        # AdGuard's synthesized answers validatable (it can't) or removing
        # disable_ipv6 + filtering (it won't).
        dnssec-validation no;
        listen-on { any; };
        listen-on-v6 { any; };

        # DoT Listener (server-side — accepts encrypted queries from clients)
        listen-on port 853 tls local-tls { any; };
        listen-on-v6 port 853 tls local-tls { any; };
};
