$TTL    604800
@       IN      SOA     dns.chi.lab.amd-e.com. admin.chi.lab.amd-e.com. (
                              3         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns.lab.amd-e.com.
@       IN      MX      10 mail.chi.lab.amd-e.com.

; Name Server
ns      IN      A       {{ ip_dns_primary }}

; Mail Server -- see db.chi.lab-amd-e.com.j2: mail.chi.lab-amd-e.com is
; served from the chi child zone (this zone's copy would be occluded by the
; zone cut and never answers). Removed 2026-10-03 after it caused NXDOMAIN
; on the MX target (pve root-mail bounces). The MX below stays as-is.
; mail.chi IN    A       {{ ip_mail_server }}
