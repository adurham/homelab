# Managed by Ansible — roles/media_ingest_02. Do not edit by hand.
[Unit]
Description=Run media-ingest-02 disk housekeeping periodically

[Timer]
# Not the scrape cadence: housekeeping is cheap metadata work, and its age
# gate (see housekeeping.sh) makes it safe at any time relative to a running
# sweep. Every 6h keeps the backup rings bounded.
OnBootSec=15min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
