---
# Managed by Ansible (roles/authentik_service). Identical on every authentik node.
# No local postgres, no redis, no proxy outpost: the database is the Patroni pair behind this
# node's haproxy, and forward-auth is served by the embedded outpost on the server container
# (:9000) that the load balancers' `outpost_backend` points at.
services:
  server:
    image: {{ authentik_image }}:{{ authentik_tag }}
    restart: unless-stopped
    command: server
    extra_hosts:
      - "mail.chi.lab.amd-e.com:{{ authentik_mail_host }}"
    environment:
      PGCLIENTENCODING: "UTF8"
      AUTHENTIK_POSTGRESQL__HOST: "{{ authentik_pg_host }}"
      AUTHENTIK_POSTGRESQL__PORT: "{{ authentik_pg_port }}"
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_pg_db }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ authentik_pg_user }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ authentik_pg_password }}"
      # More gunicorn workers/threads so concurrent auth_request validations (the gallery fires
      # many) do not serialize behind a single worker and time out.
      AUTHENTIK_WEB__WORKERS: "{{ authentik_web_workers }}"
      AUTHENTIK_WEB__THREADS: "{{ authentik_web_threads }}"
    env_file:
      - .env
    volumes:
      - ./media:/media
      - ./custom-templates:/templates
    ports:
      - "9000:9000"
      - "9443:9443"

  worker:
    image: {{ authentik_image }}:{{ authentik_tag }}
    restart: unless-stopped
    command: worker
    extra_hosts:
      - "mail.chi.lab.amd-e.com:{{ authentik_mail_host }}"
    environment:
      PGCLIENTENCODING: "UTF8"
      AUTHENTIK_POSTGRESQL__HOST: "{{ authentik_pg_host }}"
      AUTHENTIK_POSTGRESQL__PORT: "{{ authentik_pg_port }}"
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_pg_db }}"
      AUTHENTIK_POSTGRESQL__USER: "{{ authentik_pg_user }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ authentik_pg_password }}"
    env_file:
      - .env
    volumes:
      - ./media:/media
      - ./custom-templates:/templates
