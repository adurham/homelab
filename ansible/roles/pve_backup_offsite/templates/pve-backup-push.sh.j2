#!/bin/bash
# Managed by Ansible — roles/pve_backup_offsite.
# Stages the newest vzdump archive of every guest from all nodes, then pushes
# them, encrypted, to Google Drive (vmbackup_crypt:{{ pve_backup_offsite_gdrive_subdir }}/).
set -euo pipefail
STAGE="{{ pve_backup_offsite_stage_dir }}"
DUMP="{{ pve_backup_offsite_dump_dir }}"
KEEP_DAYS={{ pve_backup_offsite_keep_days }}
NODES="{% for n in pve_backup_offsite_nodes %}{{ n }} {% endfor %}"
mkdir -p "$STAGE"

list_newest() {
  node="$1"
  ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 root@"$node" \
    "ls -1 $DUMP/*.tar.zst $DUMP/*.vma.zst 2>/dev/null" | while read -r f; do
      b=$(basename "$f")
      key=$(printf '%s' "$b" | sed -E 's/-[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{2}_[0-9]{2}_[0-9]{2}\.(tar|vma)\.zst$//')
      printf '%s|%s|%s\n' "$node" "$key" "$f"
    done
}

picks=$(for n in $NODES; do list_newest "$n"; done |
        sort -t'|' -k2,2 -k3,3 | awk -F'|' '{last[$2]=$0} END{for (k in last) print last[k]}')

fetched=0; have=0
while IFS='|' read -r node _key path; do
  [ -z "${path:-}" ] && continue
  base=$(basename "$path")
  if [ -s "$STAGE/$base" ]; then have=$((have+1)); continue; fi
  rm -f "$STAGE/$base"
  if [ "$node" = "{{ pve_backup_offsite_nodes[0] }}" ]; then
    cp -f "$path" "$STAGE/$base.tmp" && mv -f "$STAGE/$base.tmp" "$STAGE/$base"
  else
    scp -q -o BatchMode=yes -o StrictHostKeyChecking=no "root@$node:$path" "$STAGE/$base.tmp" &&
      mv -f "$STAGE/$base.tmp" "$STAGE/$base"
  fi
  fetched=$((fetched+1))
done <<< "$picks"
echo "pve-backup-push: staged $fetched new, $have already present"

if rclone copy "$STAGE" "vmbackup_crypt:{{ pve_backup_offsite_gdrive_subdir }}/" --transfers 2 --checkers 4 --stats-one-line 2>&1 | tail -2; then
  push_ok=1
else
  push_ok=0
  echo "pve-backup-push: rclone copy failed — skipping prune so old copies survive" >&2
fi
# Staging is only needed while uploading; the on-site dump is the source of
# truth. Keeping old copies here would cost a whole generation per week on the
# same pool the guests live on.
find "$STAGE" -maxdepth 1 \( -name '*.tar.zst' -o -name '*.vma.zst' \) -type f -mtime +1 -delete
# Count-based retention, gated on a successful push. Age-based pruning used to
# run regardless: after four failed weeks it deleted the last copy before a new
# one landed, and a single bad week could take the only off-site archive with
# it. Keeping the newest N per guest is stable under any number of missed runs.
if [ "${push_ok:-0}" = 1 ]; then
  rclone lsf "vmbackup_crypt:{{ pve_backup_offsite_gdrive_subdir }}/" --files-only 2>/dev/null \
    | sed -E 's/^(.*)-[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{2}_[0-9]{2}_[0-9]{2}\.(tar|vma)\.zst$/\1\t&/' \
    | sort -t'	' -k1,1 -k2,2 \
    | awk -F'	' -v keep={{ pve_backup_offsite_keep_copies }} '{k=$1; n[k]++; v[k,n[k]]=$2} END{for (k in n) for (i=1; i<=n[k]-keep; i++) print v[k,i]}' \
    | while read -r old; do
        [ -n "$old" ] || continue
        rclone deletefile "vmbackup_crypt:{{ pve_backup_offsite_gdrive_subdir }}/$old" >/dev/null 2>&1 \
          && echo "pve-backup-push: pruned $old"
      done
fi
echo "pve-backup-push: done $(date -Is) staged=$(find "$STAGE" -maxdepth 1 \( -name '*.tar.zst' -o -name '*.vma.zst' \) | wc -l) files"

# Liveness for alerting: record that this run finished, so a dead timer or a
# silent failure is visible instead of assumed. (Grafana: see "backup push" rules.)
curl -fsS -m 10 -X POST "http://172.16.0.42:8428/api/v1/import/prometheus" \
  --data-binary "pve_backup_push_last_success_timestamp_seconds $(date +%s)"$'\n' >/dev/null 2>&1 || echo "warn: metric push failed" >&2
