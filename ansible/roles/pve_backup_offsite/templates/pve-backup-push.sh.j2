#!/bin/bash
# Managed by Ansible — roles/pve_backup_offsite.
# Pushes the newest vzdump archive of every guest, encrypted, to Google Drive
# (vmbackup_crypt:{{ pve_backup_offsite_gdrive_subdir }}/).
#
# One archive at a time: fetch -> upload -> delete from staging. The old flow
# staged the whole generation first and pruned it a week later, so ~400 GiB (the
# TanOS appliances alone are 280 GiB) sat on pve01's guest pool all week and a run
# needed that much free space at once. Now the staging dir never holds more than
# the largest single archive (~130 GiB), and is empty between runs.
#
# Already-uploaded archives are skipped by NAME + SIZE: the name carries the dump
# timestamp, so an identical name and size is the same archive. (rclone's default
# modtime comparison would re-upload an unchanged 111 GiB archive every week,
# because each staged copy gets a fresh mtime.)
#
# DRY_RUN=1 prints what would be uploaded and skipped and moves nothing.
set -euo pipefail
STAGE="{{ pve_backup_offsite_stage_dir }}"
DUMP="{{ pve_backup_offsite_dump_dir }}"
REMOTE="vmbackup_crypt:{{ pve_backup_offsite_gdrive_subdir }}"
NODES="{% for n in pve_backup_offsite_nodes %}{{ n }} {% endfor %}"
LOCAL_NODE="{{ pve_backup_offsite_nodes[0] }}"
DRY="${DRY_RUN:-0}"
# MAX_MIB=N: test mode, only archives up to N MiB are considered (the rest are left alone and their
# guests are not pruned), so the real fetch -> upload -> delete -> skip -> prune path can be
# exercised on a few tiny guests without a 300 GiB upload.
MAX_MIB="${MAX_MIB:-0}"
# IdentityAgent=none: a forwarded agent with many keys makes sshd hang up ("Too many authentication
# failures") before the node's own key is tried; these jobs only ever use the host key.
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o IdentityAgent=none"
mkdir -p "$STAGE"

# One run at a time. A 40-hour upload can overlap the next timer tick, and two runs would
# fight over the same staging files. With the lock held nothing else touches the staging
# dir, so anything in it now is debris from a run that died without cleaning up (a watchdog
# reset runs no trap, and a half-fetched archive can be 100+ GiB of the guest pool).
exec 9>/run/pve-backup-push.lock
if ! flock -n 9; then
  echo "pve-backup-push: another run is still in progress, exiting"
  exit 0
fi
if [ "$DRY" != 1 ]; then
  find "$STAGE" -maxdepth 1 -type f \( -name '*.tmp' -o -name '*.tar.zst' -o -name '*.vma.zst' \) -delete
fi

# "size|path" per archive on a node (local for the first node, ssh for the rest)
list_node() {
  node="$1"
  if [ "$node" = "$LOCAL_NODE" ]; then
    stat -c '%s|%n' "$DUMP"/*.tar.zst "$DUMP"/*.vma.zst 2>/dev/null || true
  else
    ssh $SSH_OPTS root@"$node" "stat -c '%s|%n' $DUMP/*.tar.zst $DUMP/*.vma.zst 2>/dev/null" || true
  fi
}

list_newest() {
  node="$1"
  list_node "$node" | while IFS='|' read -r size f; do
      [ -n "${f:-}" ] || continue
      b=$(basename "$f")
      key=$(printf '%s' "$b" | sed -E 's/-[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{2}_[0-9]{2}_[0-9]{2}\.(tar|vma)\.zst$//')
      printf '%s|%s|%s|%s\n' "$node" "$key" "$f" "$size"
    done
}

# Newest archive per guest across all nodes (the timestamp in the name sorts it).
picks=$(for n in $NODES; do list_newest "$n"; done |
        sort -t'|' -k2,2 -k3,3 | awk -F'|' '{last[$2]=$0} END{for (k in last) print last[k]}')
{% if pve_backup_offsite_exclude_vmids | length > 0 %}
# Guests that are deliberately not sent off-site (see pve_backup_offsite_exclude_vmids).
picks=$(printf '%s\n' "$picks" | grep -vE '\|vzdump-(qemu|lxc)-({{ pve_backup_offsite_exclude_vmids | join("|") }})\|' || true)
{% endif %}

# What Drive already holds, as "size name". If the listing fails, stop: guessing an
# empty Drive would re-upload everything.
if ! drive=$(rclone lsf --format sp --separator ' ' --files-only "$REMOTE/" 2>/dev/null); then
  echo "pve-backup-push: cannot list $REMOTE — aborting before any upload" >&2
  exit 1
fi

pushed=0; skipped=0; failed=0; bytes=0
declare -A KEY_OK   # guest key -> 1 once its newest archive is on Drive (uploaded now or already there)
while IFS='|' read -r node key path size; do
  [ -z "${path:-}" ] && continue
  base=$(basename "$path")
  if grep -qxF "$size $base" <<<"$drive"; then skipped=$((skipped+1)); KEY_OK[$key]=1; continue; fi
  if [ "$MAX_MIB" -gt 0 ] && [ $((size/1048576)) -gt "$MAX_MIB" ]; then continue; fi
  if [ "$DRY" = 1 ]; then
    echo "pve-backup-push: WOULD upload $base ($((size/1048576)) MiB from $node)"
    pushed=$((pushed+1)); bytes=$((bytes+size)); KEY_OK[$key]=1; continue
  fi
  rm -f "$STAGE/$base" "$STAGE/$base.tmp"
  if [ "$node" = "$LOCAL_NODE" ]; then
    cp -f "$path" "$STAGE/$base.tmp"
  else
    scp -q $SSH_OPTS "root@$node:$path" "$STAGE/$base.tmp"
  fi && mv -f "$STAGE/$base.tmp" "$STAGE/$base" || { echo "pve-backup-push: fetch failed: $base" >&2; rm -f "$STAGE/$base.tmp"; failed=$((failed+1)); continue; }
  if rclone copyto "$STAGE/$base" "$REMOTE/$base" --size-only --transfers 1 2>&1 | tail -2; then
    pushed=$((pushed+1)); bytes=$((bytes+size)); KEY_OK[$key]=1
  else
    echo "pve-backup-push: upload failed: $base" >&2; failed=$((failed+1))
  fi
  # staged either way: the node's own dump is the source of truth, a retry re-fetches
  rm -f "$STAGE/$base" "$STAGE/$base.tmp"
done <<< "$picks"
echo "pve-backup-push: uploaded $pushed ($((bytes/1073741824)) GiB), skipped $skipped already on Drive, failed $failed"

if [ "$failed" -eq 0 ]; then push_ok=1; else push_ok=0; echo "pve-backup-push: $failed failure(s); the run will exit non-zero" >&2; fi
# Count-based retention, per guest. A guest's old Drive copies are pruned only once ITS newest
# archive is confirmed on Drive, so one failing guest cannot freeze pruning for all of them
# (an all-or-nothing gate would let Drive grow ~300 GiB a week until it filled), and a missed
# week can still never prune the last surviving copy: the newest N per guest are always kept.
rclone lsf "$REMOTE/" --files-only 2>/dev/null \
  | sed -E 's/^(.*)-[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{2}_[0-9]{2}_[0-9]{2}\.(tar|vma)\.zst$/\1\t&/' \
  | sort -t "$(printf '\t')" -k1,1 -k2,2 \
  | awk -F'\t' -v keep={{ pve_backup_offsite_keep_copies }} '{k=$1; n[k]++; v[k,n[k]]=$2; key[k,n[k]]=k} END{for (k in n) for (i=1; i<=n[k]-keep; i++) print k "\t" v[k,i]}' \
  | while IFS=$'\t' read -r k old; do
      [ -n "$old" ] || continue
      [ "${KEY_OK[$k]:-0}" = 1 ] || continue
      if [ "$DRY" = 1 ]; then echo "pve-backup-push: WOULD prune $old"; continue; fi
      rclone deletefile "$REMOTE/$old" >/dev/null 2>&1 \
        && echo "pve-backup-push: pruned $old"
    done
echo "pve-backup-push: done $(date -Is) staged_now=$(find "$STAGE" -maxdepth 1 -type f | wc -l)"
[ "$DRY" = 1 ] && exit 0
[ "$push_ok" = 1 ] || exit 1

# Liveness for alerting. A node_exporter textfile, not a push to the VM import API: the textfile
# path is the one already proven here (pve_vzdump.prom), and the import call had no receiver rule.
TF=/var/lib/node_exporter/textfile_collector
if [ -d "$TF" ]; then
  printf '# TYPE pve_backup_push_last_success_timestamp_seconds gauge\npve_backup_push_last_success_timestamp_seconds %s\n# TYPE pve_backup_push_last_bytes gauge\npve_backup_push_last_bytes %s\n' "$(date +%s)" "$bytes" > "$TF/.pve_backup_push.tmp" \
    && mv -f "$TF/.pve_backup_push.tmp" "$TF/pve_backup_push.prom"
fi
