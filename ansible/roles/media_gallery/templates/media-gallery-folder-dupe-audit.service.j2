# Managed by Ansible — roles/media_gallery. Do not edit by hand.
[Unit]
Description=media-gallery folder duplicate audit (manual-trigger, read-only report)
# Avoid competing with the refresh/backfill cycles for Drive API quota,
# same reasoning as thumb-backfill.service.j2.
After=media-gallery-refresh.service

[Service]
Type=oneshot
User={{ media_gallery_user }}
Group={{ media_gallery_user }}
WorkingDirectory={{ media_gallery_dir }}
Environment=RCLONE_CONFIG=/home/{{ media_gallery_user }}/.config/rclone/rclone.conf
Environment=TG_RCLONE_REMOTE=gcrypt:
ExecStart={{ media_gallery_dir }}/venv/bin/python {{ media_gallery_dir }}/folder_dupe_audit.py
StandardOutput=append:/var/log/media-gallery/folder_dupe_audit.log
StandardError=append:/var/log/media-gallery/folder_dupe_audit.log
