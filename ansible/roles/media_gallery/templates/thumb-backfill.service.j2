# Managed by Ansible — roles/media_gallery. Do not edit by hand.
[Unit]
Description=media-gallery thumbnail backfill (background auto-cron)
# NO After=media-gallery-refresh.service (removed 2026-11-05). It looked
# harmless, but a refresh that ran long (dedup hashing tens of thousands of
# new thumbnails from Drive) left this unit in the "waiting" state for hours,
# so nothing generated thumbnails at all — and the dedup scan was itself
# waiting on thumbnails only this unit could produce. Thumbnails are the
# user-visible path, so the backfill must never be ordered behind a refresh.
# Contention is handled at the shared resource instead: thumb_service.py has
# bounded pools (and single-flight), and Drive's rate limit is what really
# bounds both.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ media_gallery_user }}
Group={{ media_gallery_user }}
WorkingDirectory={{ media_gallery_dir }}
Environment=RCLONE_CONFIG=/home/{{ media_gallery_user }}/.config/rclone/rclone.conf
Environment=TG_RCLONE_REMOTE=gcrypt:
ExecStart={{ media_gallery_dir }}/venv/bin/python {{ media_gallery_dir }}/thumb_backfill.py --budget {{ media_gallery_thumb_backfill_budget }} --delay {{ media_gallery_thumb_backfill_delay }} --workers {{ media_gallery_thumb_backfill_workers | default(4) }}{{ ' --include-video' if media_gallery_thumb_backfill_include_video | default(true) | bool else '' }}
StandardOutput=append:/var/log/media-gallery/thumb_backfill.log
StandardError=append:/var/log/media-gallery/thumb_backfill.log
