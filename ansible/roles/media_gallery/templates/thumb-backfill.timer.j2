# Managed by Ansible — roles/media_gallery. Do not edit by hand.
#
# Background auto-cron for the one-time thumbnail backfill (2026-09-12).
# Originally this tool was manual-run-only (see thumb_backfill.py's own
# docstring for the full "why not just force-generate everything at once"
# reasoning: real bandwidth + Drive API cost). User explicitly asked for
# this to run as a background cron instead of requiring manual invocation.
#
# Self-limiting by design so this is genuinely safe to leave running
# unattended indefinitely, unlike naively cron-ing the tool with no budget:
#   - Each run processes only media_gallery_thumb_backfill_budget items
#     (small, default 200) then exits cleanly -- never a multi-hour
#     foreground process that could get stuck or pile up.
#   - --delay throttles each individual request within a run, so even a
#     single run can't hammer the Drive API or local generation pipeline.
#   - thumb_backfill.py recomputes the missing-list fresh every run (not a
#     stored offset), so it's naturally idempotent/self-correcting and
#     automatically stops doing real work (near-instant runs) once nothing
#     is left to backfill -- no separate "done" state to track or forget
#     to disable.
#
# OnUnitInactiveSec (not OnUnitActiveSec) is deliberate: OnUnitActiveSec
# counts from the service's last START, not its completion. Real runs take
# ~70-80 minutes (200 items x a real ~20-25s download+resize+reupload round
# trip each, observed live 2026-09-12 -- much slower than first assumed),
# so an OnUnitActiveSec interval shorter than the actual runtime doesn't
# double-invoke (Type=oneshot + the timer going dormant while the unit is
# "activating" prevents that), but it DOES mean the very next trigger lands
# within about a second of the previous run finishing -- i.e. continuous
# back-to-back runs with zero rest, the opposite of "throttled background
# job". OnUnitInactiveSec counts from DEACTIVATION instead, giving a real
# idle gap between runs regardless of how long any individual run takes.
[Unit]
Description=media-gallery thumbnail backfill schedule (background auto-cron)

[Timer]
OnBootSec=15min
OnUnitInactiveSec={{ media_gallery_thumb_backfill_interval }}
Persistent=true

[Install]
WantedBy=timers.target
