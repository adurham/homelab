# Managed by Ansible — roles/media_gallery. Do not edit by hand.
[Unit]
Description=media-gallery gallery refresh (rebuild manifest + warm thumbnails)
After=network-online.target media-gallery-thumb.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ media_gallery_user }}
Group={{ media_gallery_user }}
ExecStart={{ media_gallery_dir }}/refresh_gallery.sh
# NO TimeoutStartSec: refresh itself (manifest rebuild + incremental dedup
# scan) is minutes at most, and both steps are idempotent/resumable, so a
# mid-way kill just re-does less work next time — never restarts from zero.
# (The multi-hour thumbnail prewarm was split OUT of this chain on
# 2026-09-30 into media-gallery-prewarm.service/.timer, so it can no longer
# hold this unit's flock and starve the hourly refresh after a reboot.)
