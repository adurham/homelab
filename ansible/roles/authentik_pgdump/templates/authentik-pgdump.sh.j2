#!/bin/bash
# Managed by Ansible — roles/authentik_pgdump.
# authentik's database is the Patroni cluster behind the local haproxy ({{ authentik_pgdump_host }}:{{ authentik_pgdump_port }});
# there is no postgres container on this CT any more, so pg_dump runs from a throwaway
# client container on the host network. The password lives in a root-only env file.
set -uo pipefail
DEST="{{ authentik_pgdump_dir }}"
KEEP={{ authentik_pgdump_keep }}
out="$DEST/authentik-$(date +%Y%m%d-%H%M).sql.gz"

mkdir -p "$DEST"
if ! docker run --rm --network host --env-file /etc/authentik-pgdump.env "{{ authentik_pgdump_image }}" \
     pg_dump -h {{ authentik_pgdump_host }} -p {{ authentik_pgdump_port }} -U {{ authentik_pgdump_user }} -d {{ authentik_pgdump_db }} --no-owner \
     | gzip -9 > "$out.tmp"; then
  rm -f "$out.tmp"; echo "authentik-pgdump: pg_dump failed" >&2; exit 1
fi
# pipefail covers pg_dump; also refuse a truncated/empty archive.
if ! gzip -t "$out.tmp" || [ "$(stat -c %s "$out.tmp")" -lt 1048576 ]; then
  rm -f "$out.tmp"; echo "authentik-pgdump: dump failed integrity/size check" >&2; exit 1
fi
mv "$out.tmp" "$out"
ls -1t "$DEST"/authentik-*.sql.gz | tail -n +$((KEEP + 1)) | xargs -r rm -f
echo "authentik-pgdump: wrote $out ($(stat -c %s "$out") bytes)"
