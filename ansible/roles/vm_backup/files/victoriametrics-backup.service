[Unit]
Description=VictoriaMetrics daily encrypted GDrive backup
After=victoriametrics.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vm-backup-daily.sh
User=root
# The job stages three vmstorage snapshots over rsync and then uploads ~2-3x
# the old single-node dataset to GDrive; at home upload speeds that no longer
# fits in an hour, and a timeout kill looks exactly like a failed backup.
TimeoutStartSec=21600
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target