/* AMD-Enterprises accent color override + library page background.
 *
 * GOTCHA #1 (found live 2026-08-04): Authentik ships its own base
 * stylesheet (/static/dist/authentik.css) which ALSO declares
 * --ak-accent (and friends) at :root with the stock orange (#fd4b2d).
 * Depending on load order / cascade, that base declaration can win
 * over a brand's custom CSS even though both target :root. The fix
 * per Authentik's own custom-CSS docs/community examples is to mark
 * every override !important — a plain (non-!important) declaration is
 * not reliably enough to beat the base theme's :root rule.
 *
 * Even with !important, some deeply nested Shadow DOM components
 * (Lit web components with hardcoded var(--ak-accent) references baked
 * into their own component styles) may still not update instantly —
 * Authentik's docs acknowledge custom CSS can't always reach every
 * Shadow DOM leaf. If a specific chrome element still shows orange
 * after this applies, it needs a targeted selector added below, not
 * more :root overrides.
 *
 * GOTCHA #2 (found live 2026-08-04): branding_default_flow_background
 * ONLY affects the flow executor (login/auth screens) — it does
 * NOTHING for the "My applications" library page (/if/user/,
 * UserInterface component). That page's own background comes from a
 * Shadow DOM element (.background-wrapper: fixed, z-index:-1, full
 * viewport) which only reads --pf-c-page--BackgroundColor, a flat
 * COLOR with no image slot. To get an actual background image on the
 * library page too, --pf-c-page--BackgroundColor must be forced
 * transparent (else it opaquely paints over everything behind it,
 * including html/body's own background), and the image goes on
 * html/body directly, which sits behind .background-wrapper in paint
 * order and IS reachable by custom CSS.
 *
 * The background-image url() below is filled in by ansible
 * (tasks/branding.yml) with the base64 data URI of
 * amd_enterprises_flow_bg.svg — the same asset used for the login
 * flow background, so both surfaces share one visual. The
 * {{ AMD_ENTERPRISES_FLOW_BG_DATA_URI }} placeholder is NOT valid CSS
 * on its own; do not apply this file directly via the Authentik UI
 * without running it through the ansible template step.
 */

:root {
  --ak-accent: #3b82f6 !important;
  --pf-global--primary-color--100: #3b82f6 !important;
  --pf-global--primary-color--200: #1e3a8a !important;
  --pf-global--primary-color--300: #2563eb !important;
  --pf-global--primary-color--400: #1e3a8a !important;
  --pf-global--active-color--100: #3b82f6 !important;
  --pf-global--active-color--200: #1e3a8a !important;
  --pf-global--link--Color: #60a5fa !important;
  --pf-global--link--Color--hover: #93c5fd !important;
  --pf-global--BorderColor--dark-100: #3b82f6 !important;

  /* MUST be transparent — see GOTCHA #2 above. */
  --pf-c-page--BackgroundColor: transparent !important;
}

input:focus,
.pf-c-form-control:focus {
  border-bottom-color: #3b82f6 !important;
  --pf-c-form-control--after--BorderBottomColor: #3b82f6 !important;
}

::-webkit-scrollbar-thumb {
  background-color: #3b82f6 !important;
}

html,
body {
  background-image: url("{{ AMD_ENTERPRISES_FLOW_BG_DATA_URI }}") !important;
  background-size: cover !important;
  background-position: center !important;
  background-attachment: fixed !important;
  background-repeat: no-repeat !important;
  background-color: #0b1220 !important;
}
