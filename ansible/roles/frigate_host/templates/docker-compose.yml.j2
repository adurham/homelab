# {{ ansible_managed }}
# Frigate NVR — single container with a custom go2rtc binary, host networking.
#
# Host networking is REQUIRED for Nest WebRTC: go2rtc's WebRTC UDP listener
# must bind to the LXC's LAN IP (192.168.86.85) so Google's SDM API can send
# UDP packets back. Docker bridge networking binds to 172.18.0.x which is
# unreachable from the internet — the WebRTC handshake completes but no video
# data flows ("non-existing PPS" / "decode_slice_header error").
#
# The custom go2rtc binary (patched to fix the Nest stream-extend timer loop)
# is mounted at /config/go2rtc inside the Frigate container. Frigate detects
# it and uses it instead of the bundled version.
#
# PATCHED BINARY: the stock go2rtc 1.9.10 (Frigate's bundled version) has a bug
# in the Nest stream-extend timer (pkg/nest/api.go StartExtendStreamTimer) — it
# fires ONCE and never re-arms, so each Nest WebRTC session dies ~5 min in,
# causing periodic freezes / "400 Bad Request" regeneration. The patched binary
# re-arms the timer in a loop (kept alive indefinitely). Binary lives at
# {{ frigate_base_dir }}/go2rtc/go2rtc_patched.
#
# Ports are accessed directly on the LXC host IP (192.168.86.85):
#   - 5000: Frigate unauthenticated UI/API
#   - 8971: Frigate authenticated UI
#   - 1984: go2rtc API (frame.jpeg for pet-accident detector)
#   - 8554: go2rtc RTSP
#   - 8555: go2rtc WebRTC (UDP)

services:
  frigate:
    container_name: frigate
    image: {{ frigate_image }}
    restart: unless-stopped
    network_mode: host
    shm_size: "{{ frigate_shm_size }}"
    volumes:
      - {{ frigate_base_dir }}/config:/config
      - {{ frigate_base_dir }}/media:/media/frigate
      - {{ frigate_base_dir }}/go2rtc/go2rtc_patched:/config/go2rtc:ro
      - {{ frigate_base_dir }}/go2rtc/keepalive.sh:/opt/frigate/go2rtc/keepalive.sh:ro
      - type: tmpfs
        target: /tmp/cache
        tmpfs:
          size: 1000000000
