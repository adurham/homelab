# {{ ansible_managed }}
# Frigate config — all Nest cameras, CPU detection.
#
# Stream path per camera: Frigate's bundled go2rtc opens a Nest WebRTC session
# directly (nest: source), and the detect role consumes the MP4-over-HTTP
# output from Frigate's own go2rtc on localhost.
#
# WHY MP4-over-HTTP (not RTSP): the go2rtc RTSP output for a Nest WebRTC source
# drops the H264 SPS/PPS parameter sets, so ffmpeg can't decode it ("non-existing
# PPS" / "decode_slice_header error" / "unspecified size"). go2rtc's MP4 muxer
# (avc1) inserts the parameter sets inband, so ffmpeg decodes cleanly at native
# 1080p. Verified 2026-05-31.
#
# WHY a custom go2rtc binary: stock go2rtc 1.9.10 (Frigate's bundled version) has
# a bug in the Nest stream-extend timer (pkg/nest/api.go StartExtendStreamTimer)
# — it fires ONCE and never re-arms, so each Nest WebRTC session dies ~5 min in.
# The patched binary re-arms the timer in a loop, keeping the stream alive
# indefinitely. Mounted at /config/go2rtc inside the Frigate container.

mqtt:
{% if frigate_mqtt_enabled %}
  enabled: true
  host: {{ frigate_mqtt_host }}
  port: {{ frigate_mqtt_port }}
{% if frigate_mqtt_user %}
  user: {{ frigate_mqtt_user }}
  password: {{ frigate_mqtt_password }}
{% endif %}
{% else %}
  enabled: false
{% endif %}

detectors:
  cpu1:
    type: cpu

# Nest WebRTC sources defined directly in Frigate's bundled go2rtc.
# Detection consumes MP4-over-HTTP from localhost (carries inband SPS/PPS).
# WebRTC candidates must advertise the host LAN IP so Google's SDM API can
# send UDP packets back (Docker bridge IP is unreachable from the internet).
# Preload ensures nest sources start connecting at startup (serialized by
# dialMu in client.go, so 6 cameras connect one at a time without 429s).
go2rtc:
  streams:
{% for name, label in frigate_cameras.items() %}
    {{ name }}:
      - "nest:?client_id={{ nest_client_id }}&client_secret={{ nest_client_secret }}&refresh_token={{ nest_refresh_token }}&project_id={{ nest_project_id }}&device_id={{ nest_camera_ids[name] }}"
{% endfor %}
  preload:
{% for name, label in frigate_cameras.items() %}
    {{ name }}: ""
{% endfor %}
  webrtc:
    candidates:
      - {{ frigate_lan_ip }}:8555

cameras:
{% for name, label in frigate_cameras.items() %}
  {{ name }}:
    friendly_name: "{{ label }}"
    ffmpeg:
      inputs:
        # Read from Frigate's OWN bundled go2rtc (127.0.0.1), which opens the
        # Nest WebRTC session directly. Detection consumes this 24/7, keeping
        # the single upstream pull warm on its own (no separate keepalive
        # needed). MP4-over-HTTP carries inband SPS/PPS that RTSP output drops.
        - path: "http://127.0.0.1:1984/api/stream.mp4?src={{ name }}"
          input_args:
            - -f
            - mp4
            - -reconnect
            - "1"
            - -reconnect_at_eof
            - "1"
            - -reconnect_streamed
            - "1"
            - -reconnect_delay_max
            - "30"
          roles:
            # detect only — NO record role. Video footage lives in Nest/Google
            # Home (family already uses it); Frigate recording was a redundant
            # 50G disk + CPU hog. We keep detection + event snapshots only.
            - detect
    detect:
      enabled: true
      width: {{ frigate_detect_width }}
      height: {{ frigate_detect_height }}
      fps: {{ frigate_camera_fps[name] | default(frigate_detect_fps) }}
    objects:
      track:
{% for obj in frigate_track_objects %}
        - {{ obj }}
{% endfor %}
    record:
      enabled: false
    snapshots:
      # Keep a still image per detected person/cat event (tiny) so you can see
      # what triggered an alert. No video recording.
      enabled: true
      retain:
        default: {{ frigate_record_retain_days }}
{% endfor %}

version: 0.17-0
