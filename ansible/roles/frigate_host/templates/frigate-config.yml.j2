# {{ ansible_managed }}
# Frigate config — all Nest cameras, CPU detection.
#
# Stream path per camera:
#   nest: source (WebRTC) → ffmpeg remux (#video=copy, drops corrupt NALs)
#   → detect consumes RTSP from the remuxed stream
#
# WHY a remux step: Nest WebRTC over UDP suffers packet loss, producing
# corrupted H264 frames ("decode_slice_header error", "reference picture
# missing"). The intermediate ffmpeg copy re-parses the Annex-B stream and
# drops malformed NALs before the detect process sees them. Without this,
# the detect ffmpeg restarts ~170 times/hour.
#
# WHY RTSP (not MP4-over-HTTP) for detect: go2rtc resolves ffmpeg:{stream_name}
# internally via RTSP, which negotiates against the producer rather than
# immediately parsing an MP4 init segment. This avoids the race where the
# nest source hasn't connected yet when the remux tries to open it. RTSP also
# handles reconnection more robustly than HTTP reconnect flags.
#
# WHY a custom go2rtc binary: stock go2rtc 1.9.10 (Frigate's bundled version)
# has a bug in the Nest stream-extend timer — it fires ONCE and never re-arms,
# so each Nest WebRTC session dies ~5 min in. The patched binary re-arms the
# timer in a loop, keeping the stream alive indefinitely. Mounted at
# /config/go2rtc inside the Frigate container.

mqtt:
{% if frigate_mqtt_enabled %}
  enabled: true
  host: {{ frigate_mqtt_host }}
  port: {{ frigate_mqtt_port }}
{% if frigate_mqtt_user %}
  user: {{ frigate_mqtt_user }}
  password: {{ frigate_mqtt_password }}
{% endif %}
{% else %}
  enabled: false
{% endif %}

detectors:
  cpu1:
    type: cpu

# Nest WebRTC sources with ffmpeg remux to clean up corrupted frames.
# Each camera has TWO streams:
#   <name>_raw: the raw Nest WebRTC source (preloaded at startup)
#   <name>: ffmpeg remux via internal stream name (#video=copy, drops corrupt NALs)
# Detect consumes RTSP from the remuxed stream.
# WebRTC candidates must advertise the host LAN IP so Google's SDM API can
# send UDP packets back (Docker bridge IP is unreachable from the internet).
go2rtc:
  streams:
{% for name, label in frigate_cameras.items() %}
    {{ name }}_raw:
      - "nest:?client_id={{ nest_client_id }}&client_secret={{ nest_client_secret }}&refresh_token={{ nest_refresh_token }}&project_id={{ nest_project_id }}&device_id={{ nest_camera_ids[name] }}"
    {{ name }}:
      # +discardcorrupt+genpts: drop malformed NALs from WebRTC packet loss
      # instead of failing the remux outright; regenerate PTS so downstream
      # RTSP/detect doesn't choke on timestamp gaps left by the drops.
      # -analyzeduration/-probesize 10M: go2rtc's ffmpeg default analyzeduration
      # is 0, which surfaces as "Could not find codec parameters for stream 0
      # (Video: h264, none): unspecified size" -> detect ffmpeg dies outright
      # instead of just restarting cleanly. Give it enough of the stream to
      # find real SPS/PPS before giving up.
      - "ffmpeg:-fflags +discardcorrupt+genpts -analyzeduration 10M -probesize 10M {{ name }}_raw#video=copy"
{% endfor %}
  preload:
{% for name, label in frigate_cameras.items() %}
    {{ name }}_raw: ""
{% endfor %}
  webrtc:
    candidates:
      - {{ frigate_lan_ip }}:8555

cameras:
{% for name, label in frigate_cameras.items() %}
  {{ name }}:
    friendly_name: "{{ label }}"
    ffmpeg:
      inputs:
        # RTSP from Frigate's own go2rtc remuxed stream. The ffmpeg remux
        # (#video=copy) drops corrupted NALs from the WebRTC transport before
        # the detect process sees them. RTSP handles reconnection more
        # robustly than HTTP reconnect flags.
        - path: "rtsp://127.0.0.1:8554/{{ name }}"
          input_args: preset-rtsp-restream
          roles:
            # detect only — NO record role. Video footage lives in Nest/Google
            # Home (family already uses it); Frigate recording was a redundant
            # 50G disk + CPU hog. We keep detection + event snapshots only.
            - detect
    detect:
      enabled: true
      width: {{ frigate_detect_width }}
      height: {{ frigate_detect_height }}
      fps: {{ frigate_camera_fps[name] | default(frigate_detect_fps) }}
    objects:
      track:
{% for obj in frigate_track_objects %}
        - {{ obj }}
{% endfor %}
    record:
      enabled: false
    snapshots:
      # Keep a still image per detected person/cat event (tiny) so you can see
      # what triggered an alert. No video recording.
      enabled: true
      retain:
        default: {{ frigate_record_retain_days }}
{% endfor %}

version: 0.17-0
