scope: grafana
name: {{ patroni_name }}
restapi:
  listen: {{ patroni_ip }}:8008
  connect_address: {{ patroni_ip }}:8008
etcd3:
  hosts: 172.16.0.44:2379,172.16.0.48:2379,172.16.0.42:2379
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_log_hints: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        hot_standby: "on"
        wal_level: replica
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - host replication replicator 172.16.0.0/24 scram-sha-256
    - host all all 172.16.0.0/24 scram-sha-256
postgresql:
  listen: {{ patroni_ip }}:5432
  connect_address: {{ patroni_ip }}:5432
  data_dir: /var/lib/postgresql/15/main
  bin_dir: /usr/lib/postgresql/15/bin
  # use_pg_rewind (bootstrap block above) only helps when the rewind can run. On 2026-11-15 the
  # fenced ex-leader pg-02 came back on a diverged timeline and sat for 12 h as a dead replica
  # (Postgres in recovery, no primary_conninfo, refusing connections) while everything else
  # looked healthy. If the rewind fails or the timelines diverged, wipe the data dir so Patroni
  # re-clones from the leader on its own. The databases total ~400 MB, and with
  # synchronous_mode the leader always holds everything the replica acknowledged.
  remove_data_directory_on_rewind_failure: true
  remove_data_directory_on_diverged_timelines: true
  authentication:
    replication:
      username: replicator
      password: {{ patroni_password }}
    superuser:
      username: postgres
      password: {{ patroni_password }}
  parameters:
    unix_socket_directories: /var/run/postgresql
    hba_file: /etc/postgresql/15/main/pg_hba.conf
    ident_file: /etc/postgresql/15/main/pg_ident.conf
