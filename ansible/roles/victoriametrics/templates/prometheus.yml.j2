global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'homeassistant'
    metrics_path: /api/prometheus
    scheme: http
    static_configs:
      - targets: ['{{ ip_homeassistant }}:8123']
    bearer_token: "{{ homeassistant_token }}"

  # node_exporter-shape metrics:
  #   - All Alloy hosts push to VM via prometheus.remote_write — no scrape
  #     entries needed.
  #   - tanium_cluster (TanOS appliances) is the only pull-target group;
  #     they run a hardened :9100 install via roles/tanium_node_exporter.
  - job_name: 'node_exporter'
    static_configs:
{# Tanium zone servers (tzs-*) excluded for now -- ansible can't reach them
   from the work MacBook via the personal MacBook jump path, so node_exporter
   isn't deployed there yet. Once connectivity is sorted, drop the
   `not in groups['tanium_zones']` filter. #}
{% for host in groups['tanium_cluster'] | default([]) %}
{% if hostvars[host].ansible_host is defined and host not in groups['tanium_zones'] %}
      - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          hostname: '{{ host }}'
          instance: '{{ host }}'
          env: 'homelab'
          tanium_role: '{{ "server" if host in groups["tanium_servers"] else "module" if host in groups["tanium_modules"] else "client" }}'
{% endif %}
{% endfor %}

    relabel_configs:
      - source_labels: [hostname]
        regex: '(.+)'
        target_label: instance
        replacement: '$1'

  # ---------------------------------------------------------------------
  # exo inference cluster (2x Mac Studio M4). Each node exposes a
  # Prometheus /metrics endpoint on :52415. Reachable from vm-01 over the
  # LAN (same path as the homeassistant target on 192.168.86.x). The
  # `exo_is_master` gauge disambiguates which node is authoritative for
  # per-generation/cluster metrics; per-node system + memory metrics are
  # reported by every node. Both nodes are scraped so a master re-election
  # never creates a gap. Targets come from exo_scrape_targets
  # (roles/victoriametrics/defaults).
  # ---------------------------------------------------------------------
  - job_name: 'exo'
    metrics_path: /metrics
    scheme: http
    static_configs:
{% for target in exo_scrape_targets | default([]) %}
      - targets: ['{{ target.address }}']
        labels:
          instance: '{{ target.name }}'
          cluster: 'homelab'
{% endfor %}

  # ---------------------------------------------------------------------
  # prometheus-pve-exporter (roles/pve_exporter, co-located with VM on
  # vm-01, port 9221). Complements roles/pve_metrics_export (pvestatd's
  # native InfluxDB push, which only covers node+guest resource usage):
  # this covers replication job status/duration, HA resource state,
  # backup job coverage, and storage pool usage -- pulled via the
  # Proxmox API rather than pushed. Each node is its own scrape target
  # (cluster=1&node=1 per the exporter's own README pattern) so
  # node-local collectors (replication, backup-info) run once per node
  # instead of only reflecting whichever node vm-01 happens to hit.
  # ---------------------------------------------------------------------
  - job_name: 'pve_exporter'
    metrics_path: /pve
    params:
      module: [default]
      cluster: ['1']
      node: ['1']
    static_configs:
{% for host in groups['proxmox_nodes'] | default([]) %}
      - targets: ['{{ host }}.{{ proxmox_domain_base | default("chi.lab.amd-e.com") }}']
        labels:
          instance: '{{ host }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: '127.0.0.1:{{ pve_exporter_listen_port | default(9221) }}'

  # ---------------------------------------------------------------------
  # windows_exporter (roles/windows_exporter, port 9182, in-guest --
  # baked into the golden Windows Server template). Targets come from
  # windows_exporter_scrape_targets (roles/victoriametrics/defaults),
  # same empty-by-default/populate-later pattern as exo_scrape_targets.
  # Empty until win-sql-01/win-ts-01/win-tms-01/win-tzs-01 (currently
  # powered off, no static IP assigned yet) are booted and the role has
  # actually been run against them -- see docs/ipam.md "Windows VMs".
  # ---------------------------------------------------------------------
  - job_name: 'windows_exporter'
    static_configs:
{% for target in windows_exporter_scrape_targets | default([]) %}
      - targets: ['{{ target.address }}:9182']
        labels:
          instance: '{{ target.name }}'
{% endfor %}

  # ---------------------------------------------------------------------
  # Loki's own metrics. Loki exposes /metrics on the same port (3100) it
  # uses for the push API. Lets us alert on Loki's internal health
  # (ingestion errors, write failures) before logs stop flowing.
  # ---------------------------------------------------------------------
  - job_name: 'loki'
    static_configs:
      - targets: ['127.0.0.1:3100']
        labels:
          instance: 'vm-01'

  # ---------------------------------------------------------------------
  # Blackbox-driven probes (Tanium postgres reachability + cert expiry)
  # blackbox_exporter runs alongside victoria-metrics-prod on this host.
  # ---------------------------------------------------------------------

  # TCP probes to Tanium postgres ports. Server appliances run the TS
  # postgres on 5432; module servers run the TMS postgres on 5433.
  # `probe_success == 0` means: host down, postgres down, iptables wrong,
  # or tanium-postgres-lab-trust unit failed — all of which we want to know.
  - job_name: 'blackbox_tanium_postgres'
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
{% for host in groups['tanium_servers'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_host }}:5432']
        labels:
          instance: '{{ host }}'
          tanium_role: 'server'
{% endfor %}
{% for host in groups['tanium_modules'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_host }}:5433']
        labels:
          instance: '{{ host }}'
          tanium_role: 'module'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: 127.0.0.1:9115

  # TCP probe to Tanium SERVER consoles on port 443. Catches "appliance up +
  # postgres up + httpd or Tanium services crashed" — a failure the
  # postgres-only probe (5432) misses. Module and zone servers don't expose
  # a console on 443, so they're not probed here (verified empirically — only
  # tanium_servers respond on 443).
  - job_name: 'blackbox_tanium_console'
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
{% for host in groups['tanium_servers'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_host }}:443']
        labels:
          instance: '{{ host }}'
          tanium_role: 'server'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: target
      - target_label: __address__
        replacement: 127.0.0.1:9115

  # HTTPS probes to public-facing services. probe_ssl_earliest_cert_expiry
  # is exposed automatically; we alert when it gets close to now().
  # Targets come from blackbox_https_targets (roles/victoriametrics/defaults).
  - job_name: 'blackbox_https_cert'
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
      - targets:
{% for url in blackbox_https_targets | default([]) %}
          - {{ url }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  # HTTPS probes that fail if the vhost returns X-Frame-Options: DENY or
  # CSP frame-ancestors 'none'. Catches the May-2026 regression class where
  # over-broad security headers silently break admin UIs whose console pane
  # is an iframed sub-resource (Proxmox Console tab, Tanium server console).
  # Targets come from blackbox_iframe_self_targets (roles/victoriametrics/defaults).
  - job_name: 'blackbox_iframe_self_ok'
    metrics_path: /probe
    params:
      module: [https_iframe_self_ok]
    static_configs:
      - targets:
{% for url in blackbox_iframe_self_targets | default([]) %}
          - {{ url }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
