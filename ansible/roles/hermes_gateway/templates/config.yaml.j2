# Managed by Ansible — do not edit by hand.
# Source: roles/hermes_gateway/templates/config.yaml.j2
#
# Main model provider is switchable via hermes_gateway_main_provider
# (roles/hermes_gateway/defaults/main.yml) — currently: {{ hermes_gateway_main_provider }}.
# Default flipped from exo -> anthropic on 2026-09-07 to mirror the
# MacBook's current main provider (see defaults/main.yml comment); exo and
# ollama-cloud remain fully switchable via the same var.
# All three provider blocks (exo / anthropic / ollama-cloud) are always
# rendered below with working credentials, so switching between them is
# just changing that var + re-running the playbook — no manual editing.
#   - main reasoning thread  -> tracks hermes_gateway_main_provider
#   - delegate_task subagents -> Qwen3.6 on exo when main=exo (cheap local
#     subagents alongside the free local main model); inherits the main
#     model otherwise (delegation.provider/model left empty)
#   - auxiliary tasks (compression, title-gen, memory, etc.) -> PROVIDER-FIRST
#     schema (auxiliary.<provider>: {defaults / exo / anthropic / ollama-cloud
#     sub-blocks, each keyed by task}), copied verbatim from the MacBook's
#     ~/.hermes/config.yaml auxiliary block (2026-09-07 full sync — see
#     agent/auxiliary_client.py _get_auxiliary_task_config for how
#     hermes-agent auto-selects the sub-block matching the live main
#     provider at runtime; no Jinja branching needed for that selection).
#     ONE deliberate non-mirror: auxiliary.exo.vision keeps this gateway's
#     own LOCAL exo-cluster vision endpoint (custom:exo / Qwen3.6 on
#     192.168.86.201) instead of the MacBook's auxiliary.exo.vision (which
#     routes to ollama-cloud/gemma4:31b) — the MacBook has no local
#     vision-capable endpoint to mirror, but this gateway does, and losing
#     free local vision inference when main=exo would be a regression, not
#     a mirror.
#   - delegate_task personas -> delegation.model_by_role below, same
#     ollama-cloud-primary/anthropic-fallback pattern. Re-tiered 2026-09-12
#     (cost-vs-capability review): Tier C arch/security roles moved off
#     glm-5.3 (most expensive ollama model) onto deepseek-v4-pro:0813, with
#     adversarial/audit roles on kimi-k2.7-code for a different model family; see
#     the model_by_role comment block for the full mapping.
---
{% if hermes_gateway_main_provider == 'anthropic' %}
model:
  default: claude-sonnet-5
  provider: anthropic
{% elif hermes_gateway_main_provider == 'ollama-cloud' %}
model:
  default: deepseek-v4-flash
  provider: ollama-cloud
{% else %}
model:
  default: deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
  provider: exo
{% endif %}

# All three provider blocks below are always defined (harmless when
# unused) so `hermes_gateway_main_provider` can be flipped without
# restructuring config.yaml. exo/ollama-cloud also back delegate_task
# subagents and auxiliary tasks regardless of which one is main.
providers:
  exo:
    base_url: http://192.168.86.201:52415/v1
    api_key: not-needed
    api_mode: chat_completions
    discover_models: false
    models:
      deepseek-ai/DeepSeek-V4-Flash-Vision-Exp:
        context_length: 1048576
      mlx-community/Qwen3.6-35B-A3B-8bit:
        context_length: 262144
    extra_body:
      use_prefix_cache: true
      # Mirrors the MacBook's exo provider extra_body (2026-09-07 sync) —
      # request the priority service tier on the shared exo cluster so
      # gateway inference isn't starved behind other jobs.
      service_tier: priority
    # Mirrors the MacBook's exo provider timeouts (2026-09-07 sync) — the
    # 1M-context DSv4 model can take a long time to prefill/decode on a
    # busy cluster; both defaults (300s) were too aggressive for that.
    request_timeout_seconds: 3600
    stale_timeout_seconds: 3600
  # Ollama Cloud (ollama.com) — cloud-hosted open models, no local
  # cluster dependency. Auth via OLLAMA_API_KEY (env.j2), base_url via
  # OLLAMA_BASE_URL. Model IDs are the CLEAN form (deepseek-v4-flash),
  # not the models.dev :cloud-tagged form — Hermes strips that suffix
  # internally, so using it here would just be redundant, not wrong.
  ollama-cloud:
    base_url: https://ollama.com/v1
    discover_models: false
    models:
{{ hermes_routing_ollama_cloud_models | to_nice_yaml(indent=2, sort_keys=False) | indent(6, True) }}
# anthropic needs no providers.anthropic block — it's a built-in
# provider that resolves its own OAuth credentials
# (vault_hermes_gw_claude_code_oauth_token in env.j2 / .claude/.credentials.json).

# Turn-scoped failover for the main reasoning thread. Mirrors the
# MacBook's top-level fallback_providers (2026-09-07 sync) — when the
# active main provider returns 429/5xx/auth-failure/connection-drop mid
# turn, Hermes swaps in ollama-cloud and keeps the conversation going.
# Dated model id (deepseek-v4-flash:0731) matches the MacBook exactly;
# the dashboard profile deliberately uses the floating `deepseek-v4-flash`
# alias instead (see dashboard_profile_config.yaml.j2) since availability
# there matters more than pinning an exact checkpoint.
fallback_providers:
  - provider: ollama-cloud
    model: deepseek-v4-flash:0731

# Web search/extract backends, mirrored from the MacBook's ~/.hermes/config.yaml
# web block (2026-09-07 sync). brave-free is the primary backend
# (BRAVE_SEARCH_API_KEY in env); search_chain lists the auto-detect fallback
# order (ddgs = keyless DuckDuckGo). by_provider carries PER-PROVIDER
# overrides that hermes-agent consults ahead of the flat backend/
# search_backend/extract_backend fields above whenever the resolved
# provider has an entry here: anthropic uses the `claude-code` backend
# (shells out to the `claude` CLI already installed + authenticated on
# this box — see tasks/main.yml "Install Claude Code CLI Globally" /
# "Bootstrap Anthropic Claude Code Credentials") for native, zero-extra-
# API-key search+extract; exo/ollama-cloud both use brave-free/trafilatura
# same as the flat defaults. anthropic_native_search stays true as a
# second, independent Anthropic-only native-search path (Claude's own
# server-side web tool) — orthogonal to by_provider.anthropic above.
web:
  backend: brave-free
  search_backend: brave-free
  extract_backend: trafilatura
  anthropic_native_search: true
  anthropic_native_search_max_uses: 5
  search_chain:
    - brave-free
    - ddgs
  by_provider:
    ollama-cloud:
      search_backend: brave-free
      extract_backend: trafilatura
    anthropic:
      search_backend: claude-code
      extract_backend: claude-code
    exo:
      search_backend: brave-free
      extract_backend: trafilatura

# Discord verbosity: final-answer-only. By default the Discord adapter uses
# the "high" display tier (gateway/display_config.py), which posts a message
# for every tool call (tool_progress: all), mid-turn "thinking" status
# chatter (interim_assistant_messages), and periodic heartbeat pings — noisy
# in a chat client. The per-platform override below mutes all of that so the
# bot replies ONLY with its final response. (show_reasoning already defaults
# off, so raw reasoning is never posted.) Mirrors the built-in "low" tier.
display:
  show_reasoning: false
  platforms:
    discord:
      tool_progress: 'off'              # no per-command notifications
      interim_assistant_messages: false # no mid-turn "thinking" status posts
      long_running_notifications: false # no periodic "still working" pings
      busy_ack_detail: false            # no iteration-counter busy chatter
      streaming: false                  # post the final answer in one message

agent:
  max_turns: 90
  gateway_timeout: 1800
  restart_drain_timeout: 60
  api_max_retries: 3
  service_tier: ''
  # Mirrors the MacBook's agent block (2026-09-07 sync). pin_anthropic_token
  # false / environment_probe true / coding_context auto / image_input_mode
  # auto / verify_on_stop false are all upstream defaults on the MacBook too
  # — included explicitly so this file is a genuine byte-level mirror rather
  # than "same behavior via omitted defaults", which would silently drift
  # the next time an upstream default changes.
  pin_anthropic_token: false
  tool_use_enforcement: auto
  task_completion_guidance: true
  parallel_tool_call_guidance: true
  environment_probe: true
  environment_hint: ''
  coding_context: auto
  verify_on_stop: false
  gateway_timeout_warning: 900
  clarify_timeout: 600
  gateway_notify_interval: 600
  gateway_auto_continue_freshness: 3600
  image_input_mode: auto
  # Toolsets suppressed everywhere on this box (CLI-parity + gateway alike),
  # mirrored verbatim from the MacBook's agent.disabled_toolsets — mostly
  # toolsets the gateway would never plausibly need (feishu, yuanbao, moa,
  # x_search, video_gen, spotify, bfl, browser-cdp, image_gen) that are
  # disabled process-wide rather than left to accidentally leak in via a
  # future platform_toolsets edit.
  disabled_toolsets:
    - feishu_doc
    - feishu_drive
    - yuanbao
    - moa
    - x_search
    - video_gen
    - spotify
    - bfl
    - browser-cdp
    - hermes-yuanbao
    - image_gen
  # Move hermes's app system prompt into the first user message to keep
  # `system` matching real Claude Code's shape. Anthropic's billing
  # classifier on personal Max plans rejects requests with a non-CC-shaped
  # system prompt — without this every gateway turn 400s with "out of
  # extra usage". Behavior unchanged; placement only. (The MacBook uses
  # `normal` here since it isn't behind the same OAuth billing classifier
  # gate — this is a deliberate, documented per-profile delta, not a
  # missed mirror.)
  system_prompt_mode: compact
  # Adaptive sampling + reasoning settings mirrored verbatim from the
  # MacBook (2026-09-07 sync). reasoning_effort xhigh applies to whichever
  # model is actually running the main thread; reasoning_effort_by_model
  # pins per-model overrides (Sonnet 5 stays at "high" — xhigh is wasted
  # reasoning budget on a non-extended-thinking-tuned model tier; DSv4
  # variants get the full xhigh budget).
  adaptive_sampling:
    cold_start_turns: 2
    ema_alpha: 0.5
    enabled: true
    fp_max: 0.5
    history_window: 3
    log_decisions: true
    pp_max: 0.2
  interleaved_thinking: true
  reasoning_effort: max
  strip_cache_on_overload: true
  reasoning_effort_by_model:
    claude-sonnet-5: max
    deepseek-v4-flash: xhigh
    deepseek-v4-flash:0731: xhigh
    deepseek-ai/DeepSeek-V4-Flash-Vision-Exp: xhigh

# Anthropic server-side tool_search. With the CC-mimicry layer in
# place (canonical CC tool names + x-anthropic-billing-header system
# block, both in agent/anthropic_adapter.py) AND hermes-agent's
# patched _apply_tool_search that strips description+input_schema
# from deferred entries, this gives us the full benefit:
#
#   * Eager tools (additional_eager) ship full schemas — these are
#     the high-frequency coding core.
#   * Deferred tools (additional_deferred) ship as ~120-byte stubs
#     of {name, description: "", input_schema: {type: object},
#     defer_loading: true}.
#   * Anthropic's classifier accepts the canonical-CC-shaped request
#     regardless of total payload size, so we can carry an
#     arbitrarily wide toolset without 400s.
#   * The model summons a deferred tool's full schema by calling
#     tool_search_tool_regex (one extra round-trip on first use per
#     session), then uses it normally.
# NESTED tools.tool_search — read by tools/tool_search.py load_config(),
# which drives the UNIVERSAL assemble_tool_defs (ALL providers incl. exo),
# distinct from the top-level tool_search: block below (anthropic path only).
# hermes-agent's DEFAULT_CONFIG seeds this nested key to "auto", and at
# DSv4's 1,048,576-token context the 10%-of-context auto threshold (~105K)
# sits ABOVE the ~85K MCP catalog, so deferral silently NEVER fires and every
# turn ships the full tool catalog (~100K-token prefix, ~minutes of prefill).
# Pin "on" so MCP-tool deferral activates unconditionally. (Quote the value:
# bare `on` is YAML bool True.)
tools:
  tool_search:
    enabled: "on"
    threshold_pct: 10
    search_default_limit: 5
    max_search_limit: 20

tool_search:
  enabled: true
  # Explicit client_side (MacBook mirror, 2026-09-07 sync) — the fork's
  # back-compat default already resolves an unset `mode` to client_side,
  # so this was already correct behavior, but pin it explicitly rather
  # than relying on an implicit default drifting out from under both
  # configs independently in the future.
  mode: client_side
  variant: regex
  defer_mcp_tools: true
  # Eager set: high-frequency tools that ship every turn. Mirrors
  # what real Claude Code keeps eager (Bash/Read/Edit/Write/Grep
  # /TodoWrite). Outbound substitution to canonical CC names happens
  # in agent/cc_aliases.replace_with_cc_canonical.
  additional_eager:
    - terminal
    - read_file
    - write_file
    - patch
    - search_files
    - todo
  # Deferred set: name-only stubs. The model knows these tools exist
  # by name but has to tool_search before using them. Add freely;
  # extra entries are ~120 bytes each.
  additional_deferred:
    - process
    - clarify
    - vision_analyze
    - image_generate
    - web_search
    - web_extract
    - skills_list
    - skill_view
    - skill_manage
    - memory
    - session_search
    - delegate_task
    - swarm_run
    - execute_code
    - ha_list_entities
    - ha_get_state
    - ha_list_services
    - ha_call_service
    - text_to_speech

# Subagent (delegate_task / swarm_run) defaults. Mirrors Claude Code's
# Task tool behavior — orchestrator-style delegation with high reasoning
# inherited from the parent.
delegation:
  base_url: ''
  api_key: ''
  api_mode: ''
  # Let child subagents see the same MCP toolset catalog the parent
  # resolved (mirrors the MacBook, 2026-09-07 sync) — without this,
  # subagents spawned inside the gateway would lose access to MCP-backed
  # tools the parent turn already has configured.
  inherit_mcp_toolsets: true
  max_iterations: 500
  reasoning_effort: max
  reasoning_effort_by_role:
    orchestrator: max
    reviewer: high
    jr-coder: low
    mid-coder: medium
    sr-coder: high
{% if hermes_gateway_main_provider == 'exo' %}
  # Route delegate_task / swarm_run subagents to Qwen3.6 on the local exo
  # cluster (the lighter model), keeping the DSv4 main thread free for the
  # orchestrator. Resolution order is arg > delegation.model > parent model.
  # (Superseded in practice by by_provider.exo below, which matches this
  # exact provider/model pair — kept for documentation/fallback parity with
  # the MacBook's Jinja-free provider-first resolution, and because
  # tools/delegate_tool.py only consults by_provider when it is non-empty.)
  provider: exo
  model: mlx-community/Qwen3.6-35B-A3B-8bit
{% else %}
  # main=anthropic/ollama-cloud: leave provider/model empty so subagents
  # inherit the parent's model/credentials (standard behavior) instead of
  # being force-routed to exo, which may be down/unreachable. by_provider
  # below is what actually governs subagent routing at runtime for these
  # two providers (mirrors the MacBook exactly); this scalar pair is the
  # legacy fallback tools/delegate_tool.py._resolve_delegation_credentials
  # uses only when no by_provider key matches the active main provider.
  provider: ''
  model: ''
{% endif %}
  # Two-level delegation: orchestrator can spawn leaf subagents but those
  # leaves can't spawn their own subagents. Matches Claude Code's
  # Plan → leaf-research-agent flow without runaway recursion.
  max_spawn_depth: 2
  # Mirrors the MacBook's live config (verified 2026-09-12: local has been
  # 10 for its entire visible config-backup history, May-2026 onward — the
  # gateway's prior value of 3 had no supporting rationale/comment anywhere
  # and did not correspond to any local value change; confirmed drift, not
  # a deliberate fanout cap, before restoring the mirror here).
  max_concurrent_children: 10
  # 0 = no wall-clock cap on subagents (mirrors the MacBook's live config,
  # 2026-09-08 sync). Current tools/delegate_tool.py semantics: a positive
  # value here is a hard timeout regardless of progress, which killed
  # productive long-running children mid-fan-out (e.g. deep code review,
  # large refactors) even though they were actively making tool calls.
  # Stuck-child protection is handled separately by the heartbeat
  # staleness monitor, not this stopwatch. Do not reintroduce a positive
  # value without re-checking tools/delegate_tool.py's current default —
  # this exact field has been silently re-enabled by stale Ansible
  # renders before (2026-09-08).
  child_timeout_seconds: 0
  orchestrator_enabled: true
  # Auto-approve dangerous-cmd prompts inside subagents. The Discord bot
  # has no human-in-the-loop UI to resolve approvals, so the choice is
  # auto-deny (children silently skip the cmd) or auto-approve (children
  # run it). Bot operates in cloned repos via gh PR workflow — worst case
  # is a bad commit on a feature branch you'd reject in review anyway.
  subagent_auto_approve: true
  ruflo_path: ''
  # Per-provider subagent routing. This is the mechanism
  # tools/delegate_tool.py._resolve_delegation_credentials actually consults
  # first (before the Jinja-conditioned scalar provider/model pair above):
  # it matches the ACTIVE main provider against these keys, so unlike the
  # old binary if/else this explicitly covers all three
  # hermes_gateway_main_provider values with the same intent as the exo
  # branch above — subagents run a lighter/cheaper model than the parent's
  # main thread. 2026-09-12 fix: the anthropic entry previously pinned
  # claude-sonnet-5 (== main), so any unpinned delegate_task subagent on an
  # anthropic-main session silently ran Sonnet as PRIMARY, violating the
  # ollama-first policy. Both anthropic and ollama-cloud now route generic
  # subagents to deepseek-v4-flash:0731 on ollama-cloud (cross-provider
  # primary is supported here — _resolve_delegation_credentials resolves
  # the block's own provider/model pair, not the parent's).
  by_provider:
{{ hermes_routing_delegation_by_provider | to_nice_yaml(indent=2, sort_keys=False) | indent(4, True) }}
  # Per-role model routing for delegate_task's ruflo agent_type personas.
  # ollama-cloud primary, anthropic fallback, same pattern as the auxiliary
  # pins above. Re-tiered 2026-09-12 (cost-vs-capability review, no longer a
  # verbatim MacBook mirror — re-sync both blocks together if the MacBook's
  # role roster changes):
  #   Tier A (admin/light, gemma4:31b / haiku)      — unchanged
  #   Tier B (general dev, deepseek-v4-flash:0731)  — unchanged, except the
  #     judgment sub-tier below promoted to pro
  #   Tier B+ (judgment gates, deepseek-v4-pro:0813) — planner,
  #     production-validator, test-architect, database-specialist,
  #     goal-planner, code-goal-planner (was flash)
  #   Tier C (arch/senior, deepseek-v4-pro:0813)    — was glm-5.3 (most
  #     expensive ollama model on every axis, esp. ~12x pro's cached-input
  #     rate); pm/sparc-orchestrator fallback dropped to sonnet (output-heavy)
  #   Tier C adversarial (kimi-k2.7-code)     — reviewer,
  #     security-architect, security-architect-aidefence, security-auditor,
  #     injection-analyst: different model family so they don't share
  #     blind spots with the deepseek coder tier. Coding-focused Kimi
  #     variant (2026-09-12 correction — initial pick was the general
  #     kimi-k2.6, same price as k2.7-code but k2.7-code is explicitly
  #     tuned for long-horizon repo review work, strictly the better fit).
  #   jr-coder -> glm-5.3-flash (was gemma4:31b; flat pricing, different
  #     family from mid-coder, verified tool-calling capable)
  #   consultant -> deepseek-v4-pro:0813, fallback opus-5 (was glm-5.3 /
  #     fable-5-1 — Fable-priced fallback for a persona role was unjustified)
  model_by_role:
{{ hermes_routing_model_by_role | to_nice_yaml(indent=2, sort_keys=False) | indent(4, True) }}
  max_iterations_by_role:
    orchestrator: 500
    leaf: 300
  auto_route:
    tier_roles:
      light: researcher
      standard: coder
      deep: arch-system-design

auxiliary:
  # PROVIDER-FIRST schema (top-level keys: defaults / exo / anthropic /
  # ollama-cloud), copied verbatim from the MacBook's ~/.hermes/config.yaml
  # auxiliary block (2026-09-07 full sync — replaces the prior task-first
  # schema this file used before). hermes-agent auto-selects which
  # provider block applies based on the LIVE main provider at runtime
  # (agent/auxiliary_client.py _get_auxiliary_task_config /
  # _aux_flatten_provider_first) — no Jinja branching needed here, unlike
  # model:/delegation: above. Two deliberate gateway-specific deltas from
  # the MacBook, both called out inline where they occur:
  #   1. defaults.session_search — the gateway had a task-first
  #      session_search pin (timeout/max_concurrency) the MacBook doesn't
  #      carry; re-homed here under defaults (the schema's per-task
  #      SETTINGS layer, consulted regardless of which provider block
  #      matches) so the timeout/concurrency knobs keep working instead of
  #      silently becoming dead config after the schema conversion.
  #   2. exo.vision — local exo-cluster endpoint instead of the MacBook's
  #      ollama-cloud/gemma4:31b (see the LOCAL VISION OVERRIDE comment
  #      below and the file header for the full rationale).
  defaults:
    approval:
      extra_body: {}
      timeout: 180
    compression:
      extra_body: {}
      timeout: 600
    curator:
      extra_body: {}
      timeout: 600
    kanban_decomposer:
      extra_body: {}
      timeout: 180
    mcp:
      extra_body: {}
      timeout: 180
    memory_extraction:
      auto_commit_session_end: false
      extra_body: {}
      include_pre_compress: true
      max_tokens_per_turn: 1024
      max_tokens_session_end: 2048
      timeout: 180
    profile_describer:
      extra_body: {}
      timeout: 60
    # GATEWAY-SPECIFIC ADDITION (not present on the MacBook): timeout +
    # bounded concurrency for cross-session_search on the gateway, where
    # the session DB can be larger and shared across more concurrent
    # Discord/dashboard turns than a single-user MacBook session.
    session_search:
      timeout: 30
      extra_body: {}
      max_concurrency: 3
    skills_hub:
      extra_body: {}
      timeout: 180
    title_generation:
      extra_body: {}
      timeout: 180
    triage_specifier:
      extra_body: {}
      timeout: 120
    tts_audio_tags:
      extra_body: {}
      timeout: 30
    vision:
      download_timeout: 30
      extra_body: {}
      timeout: 120
    web_extract:
      extra_body: {}
      timeout: 360
  exo:
    provider: exo
    default: mlx-community/Qwen3.6-35B-A3B-8bit
    # LOCAL VISION OVERRIDE (deliberate non-mirror — see file header):
    # this gateway has a real local exo-cluster endpoint with a
    # vision-capable model (Qwen3.6), so vision stays fully local/free
    # when main=exo instead of following the MacBook's auxiliary.exo.vision
    # (which points at ollama-cloud/gemma4:31b — the MacBook has no local
    # vision endpoint of its own to mirror). All routing fields
    # (provider/model/base_url/api_key/api_mode) live directly on this
    # per-task entry and win over the block-level "auto" resolution
    # (agent/auxiliary_client.py _aux_flatten_provider_first: per-task dict
    # overrides are applied last).
    vision:
      provider: custom:exo
      model: mlx-community/Qwen3.6-35B-A3B-8bit
      base_url: http://192.168.86.201:52415/v1
      api_key: not-needed
      api_mode: chat_completions
      timeout: 120
      extra_body: {}
      download_timeout: 30
    web_extract:
      model: gemma4:31b
      provider: ollama-cloud
    compression:
      model: deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
      extra_body:
        service_tier: flex
    skills_hub:
      model: gemma4:31b
      provider: ollama-cloud
    approval:
      model: deepseek-v4-flash:0731
      provider: ollama-cloud
    mcp:
      model: gemma4:31b
      provider: ollama-cloud
    title_generation:
      model: gemma4:31b
      provider: ollama-cloud
    tts_audio_tags:
      model: gemma4:31b
      provider: ollama-cloud
    triage_specifier:
      model: gemma4:31b
      provider: ollama-cloud
    kanban_decomposer:
      model: deepseek-v4-flash:0731
      provider: ollama-cloud
    profile_describer:
      model: gemma4:31b
      provider: ollama-cloud
    curator:
      model: deepseek-v4-flash:0731
      provider: ollama-cloud
    monitor:
      model: gemma4:31b
      provider: ollama-cloud
    memory_extraction:
      model: deepseek-v4-flash:0731
      provider: ollama-cloud
    background_review:
      model: deepseek-v4-flash:0731
      provider: ollama-cloud
    consult:
      model: deepseek-v4-pro
      provider: ollama-cloud
    goal_judge:
      model: deepseek-v4-flash:0731
      provider: ollama-cloud
