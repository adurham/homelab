[Unit]
# Managed by Ansible — do not edit by hand.
# Source: roles/hermes_gateway/templates/hermes-serve.service.j2
#
# Persistent backend that Hermes Desktop, the CLI (`hermes submit`),
# AND phone/browser access all attach to remotely. Distinct process
# from hermes-gateway.service (the messaging bot) — same install, same
# config.yaml, different entrypoint and port. See
# website/docs/user-guide/features/web-dashboard.md
# ("Connecting Hermes Desktop to a remote backend") for the upstream
# doc this mirrors.
#
# NOTE (2026-09-01, updated): runs `hermes -p dashboard dashboard --isolated`,
# NOT `hermes serve`, despite the unit's name. Two separate fixes landed
# in this unit on the same day:
#
# 1. Upstream commit f0f8c84d1b ("make hermes serve a real headless
#    backend", 2026-06-30) split `serve` and `dashboard`: `serve` now
#    mounts ZERO browser UI (pure JSON-RPC/WS for the Desktop Electron
#    app only) — hitting :9119/ returned
#    `{"error":"Headless backend (hermes serve): web UI disabled..."}`
#    instead of a page. `dashboard` boots the IDENTICAL backend
#    (`cmd_dashboard` -> `start_server`, same JSON-RPC/WS routes) and
#    additionally mounts the SPA.
#
# 2. `-p dashboard --isolated`: the web dashboard runs as its OWN Hermes
#    PROFILE (separate HERMES_HOME under
#    /home/hermes/.hermes/profiles/dashboard/), so it can be pinned to
#    Anthropic Claude Sonnet 5 independent of the Discord bot's main
#    provider (hermes_gateway_main_provider, exo by default) — there's
#    no per-platform model override in hermes-agent, so a separate
#    profile is the supported isolation mechanism. `--isolated` is
#    required: without it, `cmd_dashboard`'s unified-profile-launch
#    routing detects the non-default profile and RE-EXECS itself as the
#    *machine* dashboard (profile preselected in the URL switcher only,
#    still reading the machine-root config/model) instead of actually
#    running as the isolated dashboard profile.
#
# Unit/service name kept as `hermes-serve` for backward compat with
# existing ansible references (main.yml, handlers, README) rather
# than a repo-wide rename.
Description=Hermes Agent — persistent remote backend (isolated dashboard profile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes
EnvironmentFile=/home/hermes/.hermes/.env
ExecStart=/opt/hermes-agent/venv/bin/hermes -p dashboard dashboard --isolated --no-open --host 0.0.0.0 --port 9119 --skip-build
# Bound on ALL interfaces (0.0.0.0), not the LXC's specific IP. Hermes's
# DNS-rebinding Host-header guard (web_server.py _is_accepted_host)
# requires an EXACT match between the Host header and --host when bound
# to a specific address — but lb-01's nginx proxies with
# Host: hermes.chi.lab.amd-e.com, which would always 400. Binding
# 0.0.0.0 makes Hermes skip that app-layer check entirely (by design —
# see the "No Host-layer defence can protect that mode; rely on
# operator network controls" comment in web_server.py) and defers to
# network-layer restriction instead: the iptables rules further up this
# role (tcp/9119 allowed only from lb-01 + tailnet, everything else
# dropped) are what actually gates inbound reachability here.
Restart=on-failure
RestartSec=5
# Dashboard OIDC gate requires the same config.yaml (dashboard.oauth.self_hosted)
# that this role renders — no extra env needed here beyond the shared .env.

[Install]
WantedBy=multi-user.target
