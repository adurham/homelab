# Managed by Ansible — do not edit by hand.
# Source: roles/hermes_gateway/templates/dashboard_profile_config.yaml.j2
#
# Config for the `dashboard` Hermes PROFILE (separate HERMES_HOME under
# /home/hermes/.hermes/profiles/dashboard/), used ONLY by hermes-serve.service
# (the web dashboard / phone chat surface at hermes.chi.lab.amd-e.com).
#
# WHY A SEPARATE PROFILE (2026-09-01): the Discord bot (hermes-gateway.service)
# and the web dashboard used to share ONE config.yaml/model, both tracking
# hermes_gateway_main_provider. The user wants the dashboard permanently on
# Anthropic Claude Sonnet 5 regardless of what the Discord bot's main
# provider is set to (anthropic by default as of 2026-09-07, previously
# exo — see defaults/main.yml) — there's no per-platform model
# override in hermes-agent, so a separate profile (separate HERMES_HOME,
# separate config.yaml/.env) is the supported isolation mechanism instead.
# The Discord bot keeps using the machine-root config.yaml
# (templates/config.yaml.j2) untouched.
#
# CONFIG-PARITY SYNC (2026-09-07): auxiliary/delegation/web/agent/tool_search
# below are mirrored from the MacBook's ~/.hermes/config.yaml the same way
# templates/config.yaml.j2 is (see that file's header comment for the full
# provider-first-auxiliary-schema rationale) — this profile just ALSO keeps
# its model: pin permanently on anthropic/claude-sonnet-5 rather than
# tracking hermes_gateway_main_provider, and keeps its own dashboard.oauth /
# public_url / fallback_providers blocks (dashboard-specific, unrelated to
# the parity sync) exactly as they were.
model:
  default: claude-sonnet-5
  provider: anthropic

# Ollama Cloud (ollama.com) — backs the fallback_providers chain below AND
# the auxiliary ollama-cloud provider block (ollama-cloud-primary task
# routing applies on this profile too, same as the other two). Block shape
# is copied verbatim from the machine-root config (templates/config.yaml.j2's
# providers.ollama-cloud) so all three profiles on this CT describe the same
# endpoint the same way. Auth is OLLAMA_API_KEY / OLLAMA_BASE_URL from THIS
# profile's own .env (dashboard_profile_env.j2) — profiles are separate
# HERMES_HOMEs and do NOT inherit the machine-root .env.
providers:
  ollama-cloud:
    base_url: https://ollama.com/v1
    discover_models: false
    models:
      deepseek-v4-flash:
        context_length: 163840
      "gemma4:31b":
        context_length: 131072

# Failover for the primary above. Anthropic (Claude Max personal
# subscription) is the only thing standing between `hermes peer dm
# hermes-gw-01` / the web dashboard and a hard failure, so when it returns
# 429 / 5xx / 401 / 403 / 404 or drops the connection, Hermes swaps in
# ollama-cloud mid-turn and keeps the conversation.
#
# Semantics (website/docs/user-guide/features/fallback-providers.md):
# ONE primary + an ordered chain tried on failure, and the chain is
# TURN-SCOPED — every new user message starts back on claude-sonnet-5.
# There is deliberately no "mutual/bidirectional primary" concept in a
# single profile: with primary=anthropic, a chain pointing at ollama-cloud
# IS the anthropic->ollama direction, and the reverse direction only exists
# if some profile runs ollama-cloud as ITS primary (the machine-root config
# already supports that via hermes_gateway_main_provider).
#
# Model id is the CLEAN `deepseek-v4-flash` — the exact key declared in the
# providers block above and in the machine-root render, so the fallback
# resolves to a model this config actually describes. (The personal MacBook
# pins the dated `deepseek-v4-flash:0731`; both are live model ids on
# ollama.com, but the floating alias is the better choice for an
# availability fallback since it survives Ollama rotating checkpoints.)
fallback_providers:
  - provider: ollama-cloud
    model: deepseek-v4-flash

# Same Authentik OIDC gate as the machine-root config (roles/authentik_provider
# /tasks/hermes.yml provisions the client). hermes-serve.service runs this
# profile with --isolated, so THIS profile's dashboard: block is what the
# isolated server actually reads for its OAuth gate — the machine-root one
# is irrelevant to it.
dashboard:
  oauth:
    provider: self-hosted
    self_hosted:
      issuer: "{{ authentik_url }}/application/o/hermes-dashboard/"
      client_id: "{{ vault_hermes_gw_dashboard_oidc_client_id }}"
      scopes: "openid profile email"
  public_url: "https://hermes.chi.lab.amd-e.com"

# ─── Web / agent / tool_search / delegation / auxiliary — CONFIG-PARITY SYNC (2026-09-07) ───
#
# This profile previously had NONE of these blocks, so it silently ran on
# hermes-agent's built-in DEFAULT_CONFIG for all of them (profiles are
# separate HERMES_HOMEs and do NOT inherit the machine-root config.yaml).
# Mirrored below from the MacBook's ~/.hermes/config.yaml the same way
# templates/config.yaml.j2 is, since this profile is a live, user-facing
# surface (web dashboard + `hermes peer dm`) just as much as the Discord
# bot and the interactive default profile — it deserves the same tuned
# reasoning/tool-search/delegation/web settings, not silent defaults.
#
# web: mirrored verbatim. anthropic_native_search / by_provider.anthropic
# (claude-code backend) apply directly since this profile's main provider
# is always anthropic; by_provider.ollama-cloud/exo entries are inert here
# (never selected — main never runs on those providers on this profile)
# but kept for consistency with the other two profiles' identical block.
web:
  backend: brave-free
  search_backend: brave-free
  extract_backend: trafilatura
  anthropic_native_search: true
  anthropic_native_search_max_uses: 5
  search_chain:
    - brave-free
    - ddgs
  by_provider:
    ollama-cloud:
      search_backend: brave-free
      extract_backend: trafilatura
    anthropic:
      search_backend: claude-code
      extract_backend: claude-code
    exo:
      search_backend: brave-free
      extract_backend: trafilatura

# agent: mirrored from the MacBook, with the SAME two gateway-specific
# deltas templates/config.yaml.j2 carries for the same reasons (Anthropic
# billing-classifier compatibility on the OAuth path this profile also
# runs on): system_prompt_mode: compact instead of normal, plus this
# profile's own max_turns/timeouts sized for a chat surface rather than a
# long autonomous coding session.
agent:
  max_turns: 90
  gateway_timeout: 1800
  restart_drain_timeout: 60
  api_max_retries: 3
  service_tier: ''
  pin_anthropic_token: false
  tool_use_enforcement: auto
  task_completion_guidance: true
  parallel_tool_call_guidance: true
  environment_probe: true
  environment_hint: ''
  coding_context: auto
  verify_on_stop: false
  gateway_timeout_warning: 900
  clarify_timeout: 600
  gateway_notify_interval: 600
  gateway_auto_continue_freshness: 3600
  image_input_mode: auto
  disabled_toolsets:
    - feishu_doc
    - feishu_drive
    - yuanbao
    - moa
    - x_search
    - video_gen
    - spotify
    - bfl
    - browser-cdp
    - hermes-yuanbao
    - image_gen
  system_prompt_mode: compact
  adaptive_sampling:
    cold_start_turns: 2
    ema_alpha: 0.5
    enabled: true
    fp_max: 0.5
    history_window: 3
    log_decisions: true
    pp_max: 0.2
  interleaved_thinking: true
  reasoning_effort: xhigh
  strip_cache_on_overload: true
  reasoning_effort_by_model:
    claude-sonnet-5: high
    deepseek-v4-flash: xhigh
    deepseek-v4-flash:0731: xhigh
    deepseek-ai/DeepSeek-V4-Flash-Vision-Exp: xhigh

# tool_search: same CC-mimicry deferral setup as the machine-root/Discord
# config (see templates/config.yaml.j2's tool_search comment for the full
# rationale) — this profile runs the same OAuth path and needs the same
# billing-classifier-safe deferral behavior.
tool_search:
  enabled: true
  mode: client_side
  variant: regex
  defer_mcp_tools: true
  additional_eager:
    - terminal
    - read_file
    - write_file
    - patch
    - search_files
    - todo
  additional_deferred:
    - process
    - clarify
    - vision_analyze
    - image_generate
    - web_search
    - web_extract
    - skills_list
    - skill_view
    - skill_manage
    - memory
    - session_search
    - delegate_task
    - swarm_run
    - execute_code
    - text_to_speech

